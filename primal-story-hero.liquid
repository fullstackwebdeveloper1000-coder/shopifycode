<section id="PwStoryHero-{{ section.id }}" class="story-hero">
  <div class="story-hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'story-hero__img',
          loading: 'eager',
          alt: '',
          width: section.settings.image.width,
          height: section.settings.image.height,
          widths: '1200, 1600, 1920, 2400',
          sizes: '100vw'
      }}
    {%- elsif section.settings.fallback_image_url != blank -%}
      <img
        class="story-hero__img"
        src="{{ section.settings.fallback_image_url }}"
        alt=""
        loading="eager"
        width="1920"
        height="900"
      >
    {%- endif -%}
    <div class="story-hero__shade"></div>
  </div>

  <div class="container story-hero__in">
    <div class="story-hero__copy">
      <h1 class="story-title">Our <span class="gold">Story</span></h1>
      <hr class="story-rule">
      <p class="story-lead">We work in healthcare.</p>
      <p class="story-body">We&apos;ve seen what most supplements actually deliver. Not much. Impressive labels. Underwhelming doses. Products built to look comprehensive, not to work.</p>
      <p class="story-close">So we built our own.</p>
    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    max-width: none !important;
  }

  #PwStoryHero-{{ section.id }},
  #PwStoryHero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #PwStoryHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    min-height: 900px;
    background: #071811;
    color: #ffffff;
    font-family: Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PwStoryHero-{{ section.id }} .story-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #PwStoryHero-{{ section.id }} .story-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    display: block;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  #PwStoryHero-{{ section.id }} .story-hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      #071811 0%,
      #071811 28%,
      rgba(7, 24, 17, 0.92) 38%,
      rgba(7, 24, 17, 0.72) 48%,
      rgba(7, 24, 17, 0.38) 58%,
      rgba(7, 24, 17, 0.12) 68%,
      transparent 78%
    );
  }

  #PwStoryHero-{{ section.id }} .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 48px;
  }

  #PwStoryHero-{{ section.id }} .story-hero__in {
    position: relative;
    z-index: 2;
    min-height: 900px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 0;
  }

  #PwStoryHero-{{ section.id }} .story-hero__copy {
    max-width: 520px;
  }

  #PwStoryHero-{{ section.id }} .story-title {
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 900;
    font-size: 76px;
    line-height: 0.92;
    letter-spacing: -1px;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 26px;
  }

  #PwStoryHero-{{ section.id }} .story-title .gold {
    color: #c89a3d;
  }

  #PwStoryHero-{{ section.id }} .story-rule {
    width: 56px;
    height: 3px;
    background: #c89a3d;
    border: 0;
    margin: 0 0 26px;
  }

  #PwStoryHero-{{ section.id }} .story-lead {
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.3px;
    color: #c89a3d;
    margin: 0 0 18px;
  }

  #PwStoryHero-{{ section.id }} .story-body {
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
    max-width: 440px;
    color: #ffffff;
  }

  #PwStoryHero-{{ section.id }} .story-close {
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 800;
    font-size: 22px;
    color: #c89a3d;
    text-transform: none;
    margin: 22px 0 0;
  }

  @media screen and (max-width: 1080px) {
    #PwStoryHero-{{ section.id }},
    #PwStoryHero-{{ section.id }} .story-hero__in {
      min-height: 720px;
    }

    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 64px;
    }

    #PwStoryHero-{{ section.id }} .story-hero__shade {
      background: linear-gradient(
        90deg,
        #071811 0%,
        #071811 34%,
        rgba(7, 24, 17, 0.88) 46%,
        rgba(7, 24, 17, 0.5) 58%,
        transparent 72%
      );
    }
  }

  @media screen and (max-width: 860px) {
    #PwStoryHero-{{ section.id }},
    #PwStoryHero-{{ section.id }} .story-hero__in {
      min-height: auto;
    }

    #PwStoryHero-{{ section.id }} .story-hero__media {
      position: relative;
      height: 320px;
    }

    #PwStoryHero-{{ section.id }} .story-hero__img {
      position: relative;
      inset: auto;
      height: 320px;
    }

    #PwStoryHero-{{ section.id }} .story-hero__shade {
      background: linear-gradient(
        180deg,
        rgba(7, 24, 17, 0.15) 0%,
        rgba(7, 24, 17, 0.55) 100%
      );
    }

    #PwStoryHero-{{ section.id }} .story-hero__in {
      min-height: 0;
      padding: 56px 0 52px;
    }

    #PwStoryHero-{{ section.id }} .story-hero__copy {
      max-width: none;
    }

    #PwStoryHero-{{ section.id }} .story-body {
      max-width: none;
    }

    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 56px;
    }
  }

  @media screen and (max-width: 560px) {
    #PwStoryHero-{{ section.id }} .container {
      padding: 0 22px;
    }

    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 44px;
    }

    #PwStoryHero-{{ section.id }} .story-hero__media,
    #PwStoryHero-{{ section.id }} .story-hero__img {
      height: 240px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Story Hero",
  "tag": "section",
  "class": "pw-story-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (upload doctors.png)"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Or paste image URL"
    }
  ],
  "presets": [
    {
      "name": "Story Hero"
    }
  ]
}
{% endschema %}
