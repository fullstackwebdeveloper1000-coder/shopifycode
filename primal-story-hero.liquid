<section id="PwStoryHero-{{ section.id }}" class="band band-dark story-hero">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 1800
      | image_tag:
        class: 'band-img',
        loading: 'eager',
        alt: 'Two clinical researchers reviewing formulation notes',
        width: section.settings.image.width,
        height: section.settings.image.height,
        widths: '900, 1200, 1800',
        sizes: '50vw'
    }}
  {%- elsif section.settings.fallback_image_url != blank -%}
    <img
      class="band-img"
      src="{{ section.settings.fallback_image_url }}"
      alt="Two clinical researchers reviewing formulation notes"
      loading="eager"
      width="900"
      height="520"
    >
  {%- endif -%}

  <div class="container band-in">
    <div class="band-copy">
      <h1 class="story-title">Our <span class="gold">Story</span></h1>
      <hr class="band-rule">
      <p class="band-lead">We work in healthcare.</p>
      <p class="body">We&apos;ve seen what most supplements actually deliver. Not much.</p>
      <p class="body">Impressive labels. Underwhelming doses. Products built to look comprehensive, not to work.</p>
      <p class="story-close">So we built our own.</p>
    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    max-width: none !important;
  }

  #PwStoryHero-{{ section.id }},
  #PwStoryHero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #PwStoryHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: #071811;
    color: #ffffff;
    font-family: Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PwStoryHero-{{ section.id }} .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 48px;
  }

  #PwStoryHero-{{ section.id }} .band-in {
    position: relative;
    z-index: 2;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 52px 0;
  }

  #PwStoryHero-{{ section.id }} .band-copy {
    max-width: 500px;
  }

  #PwStoryHero-{{ section.id }} .band-img {
    position: absolute;
    z-index: 1;
    right: 0;
    top: 0;
    height: 100%;
    width: 50vw;
    max-width: 900px;
    object-fit: cover;
    object-position: center;
    display: block;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 11%);
    mask-image: linear-gradient(to right, transparent 0%, #000 11%);
  }

  #PwStoryHero-{{ section.id }} .band-rule {
    width: 56px;
    height: 3px;
    background: #c89a3d;
    border: 0;
    margin: 0 0 26px;
  }

  #PwStoryHero-{{ section.id }} .band-lead {
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.3px;
    color: #c89a3d;
    margin: 0 0 18px;
  }

  #PwStoryHero-{{ section.id }} p.body {
    font-size: 16px;
    line-height: 1.7;
    margin: 0 0 16px;
    max-width: 440px;
    color: #d6dad3;
  }

  #PwStoryHero-{{ section.id }} .gold {
    color: #c89a3d;
  }

  #PwStoryHero-{{ section.id }} .story-title {
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 900;
    font-size: 76px;
    line-height: 0.92;
    letter-spacing: -1px;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 26px;
  }

  #PwStoryHero-{{ section.id }} .story-close {
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 800;
    font-size: 22px;
    color: #c89a3d;
    text-transform: none;
    margin: 22px 0 0;
  }

  @media screen and (max-width: 1080px) {
    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 64px;
    }

    #PwStoryHero-{{ section.id }} .band-img {
      width: 44vw;
    }
  }

  @media screen and (max-width: 860px) {
    #PwStoryHero-{{ section.id }} .band-img {
      position: static;
      width: 100%;
      height: 280px;
      max-width: none;
      margin-top: 8px;
      -webkit-mask-image: none;
      mask-image: none;
    }

    #PwStoryHero-{{ section.id }} .band-in {
      padding-top: 56px;
      padding-bottom: 0;
    }

    #PwStoryHero-{{ section.id }} .band-copy {
      max-width: none;
      padding-bottom: 52px;
    }

    #PwStoryHero-{{ section.id }} p.body {
      max-width: none;
    }

    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 56px;
    }
  }

  @media screen and (max-width: 560px) {
    #PwStoryHero-{{ section.id }} .container {
      padding: 0 22px;
    }

    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 44px;
    }

    #PwStoryHero-{{ section.id }} .band-img {
      height: 220px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Story Hero",
  "tag": "section",
  "class": "pw-story-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (upload doctors.png)"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Or paste image URL"
    }
  ],
  "presets": [
    {
      "name": "Story Hero"
    }
  ]
}
{% endschema %}
