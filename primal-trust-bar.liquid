{% liquid
  assign heading_font = section.settings.heading_font
%}

<section
  id="PrimalTrustBar-{{ section.id }}"
  class="primal-trust-bar"
  aria-label="Trust highlights"
>
  <div class="pw-container ptb-grid-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="ptb-item-{{ section.id }}" {{ block.shopify_attributes }}>
        <span class="ptb-icon-{{ section.id }}" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'clean' %}
              <svg width="34" height="34" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <circle cx="20" cy="20" r="19"></circle>
                <path d="M13 26c0-7 6-13 14-13 0 7-6 13-14 13Z" stroke-linejoin="round"></path>
                <path d="M14 26c3-4 6-6 11-8" stroke-linecap="round"></path>
              </svg>
            {% when 'science' %}
              <svg width="34" height="34" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <circle cx="20" cy="20" r="19"></circle>
                <path d="M17 11h6M18 11v7l-5 8.5A2 2 0 0 0 14.7 30h10.6a2 2 0 0 0 1.7-3.5L22 18v-7" stroke-linejoin="round"></path>
              </svg>
            {% when 'tested' %}
              <svg width="34" height="34" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M20 4l13 5v9c0 8-5.5 13-13 16-7.5-3-13-8-13-16V9l13-5Z" stroke-linejoin="round"></path>
                <path d="M15 20l3.5 3.5L26 16" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            {% when 'uk' %}
              <svg width="34" height="34" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <circle cx="20" cy="20" r="19"></circle>
                <path d="M20 1v38M1 20h38M6 6l28 28M34 6L6 34" stroke-width="1"></path>
              </svg>
            {% when 'performance' %}
              <svg width="34" height="34" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <circle cx="20" cy="20" r="19"></circle>
                <path d="M13 20.5l4.5 4.5L28 14" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            {% else %}
              <svg width="34" height="34" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <circle cx="20" cy="20" r="19"></circle>
              </svg>
          {% endcase %}
        </span>
        <div class="ptb-copy-{{ section.id }}">
          {% if block.settings.title != blank %}
            <h3 class="ptb-title-{{ section.id }}">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="ptb-text-{{ section.id }}">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}

  #PrimalTrustBar-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #FFFFFF !important;
    overflow-x: clip !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PrimalTrustBar-{{ section.id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    background: #FFFFFF;
    border-top: 1px solid rgba(31, 35, 38, 0.10);
    border-bottom: 1px solid rgba(31, 35, 38, 0.10);
  }

  #PrimalTrustBar-{{ section.id }} *,
  #PrimalTrustBar-{{ section.id }} *::before,
  #PrimalTrustBar-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PrimalTrustBar-{{ section.id }} .pw-container.ptb-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    width: 100%;
    max-width: var(--pw-inner);
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
  }

  #PrimalTrustBar-{{ section.id }} .ptb-item-{{ section.id }} {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 30px 26px;
    margin: 0;
  }

  #PrimalTrustBar-{{ section.id }} .ptb-item-{{ section.id }} + .ptb-item-{{ section.id }} {
    border-left: 1px solid rgba(31, 35, 38, 0.10);
  }

  #PrimalTrustBar-{{ section.id }} .ptb-icon-{{ section.id }} {
    flex: 0 0 auto;
    color: #C89A3D;
    line-height: 0;
  }

  #PrimalTrustBar-{{ section.id }} .ptb-icon-{{ section.id }} svg {
    display: block;
    width: 34px;
    height: 34px;
  }

  #PrimalTrustBar-{{ section.id }} .ptb-title-{{ section.id }} {
    margin: 0 0 8px;
    color: #1F2326;
    font-family: {{ heading_font.family }}, sans-serif;
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  #PrimalTrustBar-{{ section.id }} .ptb-text-{{ section.id }} {
    margin: 0;
    color: #737A80;
    font-family: {{ heading_font.family }}, sans-serif;
    font-style: {{ heading_font.style }};
    font-weight: 400;
    font-size: 13px;
    line-height: 1.5;
  }

  @media screen and (max-width: 1024px) {
    #PrimalTrustBar-{{ section.id }} .pw-container.ptb-grid-{{ section.id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #PrimalTrustBar-{{ section.id }} .ptb-item-{{ section.id }}:nth-child(odd) {
      border-left: 0;
    }

    #PrimalTrustBar-{{ section.id }} .ptb-item-{{ section.id }}:nth-child(n + 3) {
      border-top: 1px solid rgba(31, 35, 38, 0.10);
    }
  }

  @media screen and (max-width: 560px) {
    #PrimalTrustBar-{{ section.id }} .pw-container.ptb-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }

    #PrimalTrustBar-{{ section.id }} .ptb-item-{{ section.id }} + .ptb-item-{{ section.id }} {
      border-left: 0;
      border-top: 1px solid rgba(31, 35, 38, 0.10);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Primal Trust Bar",
  "tag": "section",
  "class": "section-primal-trust-bar",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "montserrat_n7"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "clean",
          "options": [
            { "value": "clean", "label": "Clean" },
            { "value": "science", "label": "Science" },
            { "value": "tested", "label": "Tested" },
            { "value": "uk", "label": "UK" },
            { "value": "performance", "label": "Performance" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Primal Trust Bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "clean",
            "title": "Clean & Transparent",
            "text": "No fillers. No shortcuts. Just what your body needs to perform."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "science",
            "title": "Science Backed",
            "text": "Formulated by experts. Built on research. Proven in real life."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "tested",
            "title": "Third-Party Tested",
            "text": "Independently tested for purity, potency and quality."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "uk",
            "title": "Made In The UK",
            "text": "Manufactured to the highest standards in the United Kingdom."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "performance",
            "title": "Performance You Feel",
            "text": "Designed to fuel your energy, focus, recovery and resilience."
          }
        }
      ]
    }
  ]
}
{% endschema %}
