      <div class="pw-explorer-grid">
        <div class="pw-list" data-pw-list></div>
        <button type="button" class="pw-list-toggle" data-pw-more hidden></button>
        <div class="pw-detail" data-pw-detail></div>
      </div>
    </div>
  </div>

