{% comment %}
  Custom Trust Specs — holding page scientists + legal strip (Figma)
  No heading / no HR.
  Aligns to same 1440 canvas as Primal pre-launch: content x=120..1320 (1200 wide).
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&display=swap" rel="stylesheet">

<section
  id="PwTrustSpecs-{{ section.id }}"
  class="pw-trust-specs"
  style="
    --pts-bg: {{ section.settings.background_color }};
    --pts-text: {{ section.settings.text_color }};
    --pts-gold: {{ section.settings.highlight_color }};
    --pts-legal-bg: {{ section.settings.legal_background }};
    --pts-legal-ink: {{ section.settings.legal_text_color }};
    --pts-legal-muted: {{ section.settings.legal_muted_color }};
  "
>
  <div class="pw-trust-specs__dark">
    <div class="pw-trust-specs__inner">
      <div class="pw-trust-specs__grid" role="list">
        {% for block in section.blocks limit: 4 %}
          <div
            class="pw-trust-specs__item"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.custom_svg != blank %}
              <span class="pw-trust-specs__icon" aria-hidden="true">
                {{ block.settings.custom_svg }}
              </span>
            {% endif %}
            {% if block.settings.title != blank %}
              <span class="pw-trust-specs__label">{{ block.settings.title | escape }}</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if section.settings.bottom_text != blank %}
        <p class="pw-trust-specs__footer">{{ section.settings.bottom_text | escape }}</p>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_legal_strip %}
    <div class="pw-trust-specs__legal">
      <div class="pw-trust-specs__inner">
        <p class="pw-trust-specs__legal-line">
          {%- if section.settings.legal_left != blank -%}
            <span class="pw-trust-specs__legal-left">{{ section.settings.legal_left | escape }}</span>
          {%- endif -%}
          {%- if section.settings.legal_left != blank and section.settings.legal_right != blank -%}
            <span class="pw-trust-specs__legal-sep">|</span>
          {%- endif -%}
          {%- if section.settings.legal_right != blank -%}
            <span class="pw-trust-specs__legal-right">{{ section.settings.legal_right | escape }}</span>
          {%- endif -%}
        </p>
      </div>
    </div>
  {% endif %}
</section>

{% style %}
  #PwTrustSpecs-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwTrustSpecs-{{ section.id }},
  #PwTrustSpecs-{{ section.id }} *,
  #PwTrustSpecs-{{ section.id }} *::before,
  #PwTrustSpecs-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PwTrustSpecs-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* Same content frame as Primal pre-launch / hero: 1440 → 120 side pads → 1200 inner */
  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__inner {
    width: min(100%, 1440px);
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: min(8.333333vw, 120px);
  }

  /* ---------- Dark scientists band ---------- */
  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__dark {
    width: 100%;
    margin: 0;
    padding: 40px 0 34px;
    background: var(--pts-bg, #14171A);
    color: var(--pts-text, #ffffff);
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: stretch;
    width: 100%;
    margin: 0 0 24px;
    padding: 0;
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 0;
    min-height: 28px;
    padding: 4px 16px;
    color: var(--pts-text, #ffffff);
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__item + .pw-trust-specs__item {
    border-left: 1px solid rgba(255, 255, 255, 0.14);
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__icon {
    display: inline-flex;
    flex: 0 0 24px;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--pts-gold, #C89A3D);
    line-height: 0;
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__icon svg {
    display: block;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__label {
    display: inline-block;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 15px;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--pts-text, #ffffff);
    white-space: nowrap;
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__footer {
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 17px;
    line-height: 1;
    letter-spacing: 2px;
    text-align: center;
    text-transform: uppercase;
    color: var(--pts-gold, #C89A3D);
  }

  /* ---------- Light legal strip — one horizontal row ---------- */
  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal {
    width: 100%;
    margin: 0;
    padding: 20px 0 26px;
    background: var(--pts-legal-bg, #EFE5DD);
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal-line {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 18px;
    width: 100%;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    background: none !important;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 2px;
    text-align: center;
    text-transform: uppercase;
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal-left,
  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal-sep,
  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal-right {
    display: inline-block !important;
    flex: 0 0 auto !important;
    width: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
    white-space: nowrap !important;
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal-left {
    color: var(--pts-legal-ink, #1F2326);
    font-weight: 700;
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal-sep {
    color: var(--pts-gold, #C89A3D);
    font-weight: 700;
  }

  #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal-right {
    color: var(--pts-legal-muted, #737A80);
    font-weight: 600;
  }

  @media screen and (max-width: 1180px) {
    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__item {
      padding-inline: 10px;
      gap: 10px;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__label {
      font-size: 13px;
      letter-spacing: 0.6px;
    }
  }

  @media screen and (max-width: 989px) {
    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__inner {
      padding-inline: clamp(22px, 5vw, 52px);
    }
  }

  @media screen and (max-width: 900px) {
    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__dark {
      padding: 28px 0 24px;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__grid {
      margin-bottom: 16px;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__item {
      flex-direction: column;
      justify-content: flex-start;
      gap: 8px;
      padding: 0 6px;
      min-height: 0;
      text-align: center;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__icon,
    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__icon svg {
      width: 18px;
      height: 18px;
      flex-basis: 18px;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__label {
      font-size: clamp(8px, 2.2vw, 11px);
      line-height: 1.3;
      letter-spacing: 0.3px;
      white-space: normal;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__footer {
      font-size: clamp(11px, 3.2vw, 15px);
      letter-spacing: 1.2px;
      line-height: 1.35;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal {
      padding: 16px 0 20px;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal-line {
      gap: 12px;
      font-size: 12px;
      letter-spacing: 1.4px;
      flex-wrap: wrap;
    }
  }

  @media screen and (max-width: 767px) {
    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__inner {
      padding-inline: clamp(16px, 5vw, 28px);
    }
  }

  @media screen and (max-width: 480px) {
    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__item {
      gap: 6px;
      padding: 0 4px;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__icon,
    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__icon svg {
      width: 15px;
      height: 15px;
      flex-basis: 15px;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__label {
      font-size: 8px;
    }

    #PwTrustSpecs-{{ section.id }} .pw-trust-specs__legal-line {
      gap: 10px;
      font-size: 11px;
      letter-spacing: 1px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Custom Trust Specs",
  "tag": "section",
  "class": "section-pw-trust-specs",
  "settings": [
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Gold line under icons",
      "default": "NO FILLERS. NO SHORTCUTS. JUST RESULTS."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Dark band background",
      "default": "#14171A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Icon label color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Gold / Highlight",
      "default": "#C89A3D"
    },
    {
      "type": "header",
      "content": "Light legal strip"
    },
    {
      "type": "checkbox",
      "id": "show_legal_strip",
      "label": "Show light legal strip",
      "default": true
    },
    {
      "type": "text",
      "id": "legal_left",
      "label": "Legal left text",
      "default": "PRIMAL WIN LTD."
    },
    {
      "type": "text",
      "id": "legal_right",
      "label": "Legal right text",
      "default": "FOR THOSE WHO WANT TO WIN."
    },
    {
      "type": "color",
      "id": "legal_background",
      "label": "Legal strip background",
      "default": "#EFE5DD"
    },
    {
      "type": "color",
      "id": "legal_text_color",
      "label": "Legal left color",
      "default": "#1F2326"
    },
    {
      "type": "color",
      "id": "legal_muted_color",
      "label": "Legal right color",
      "default": "#737A80"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Badge",
      "limit": 4,
      "settings": [
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code",
          "info": "Paste raw SVG icon code."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Text",
          "default": "Feature Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Trust Specs",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "SCIENCE BACKED",
            "custom_svg": "<svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><path d='M8.5 12l2.5 2.5 4.5-5'/></svg>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "THIRD-PARTY TESTED",
            "custom_svg": "<svg viewBox='0 0 24 24'><path d='M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3z'/><path d='M12 8.5l1 2h2l-1.6 1.4.6 2.1-2-1.2-2 1.2.6-2.1L9 10.5h2l1-2z'/></svg>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "CLEAN & TRANSPARENT",
            "custom_svg": "<svg viewBox='0 0 24 24'><path d='M10 3h4M11 3v6l-5 8.5A2 2 0 0 0 7.7 21h8.6a2 2 0 0 0 1.7-3.5L13 9V3'/></svg>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "MADE IN THE UK",
            "custom_svg": "<svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><path d='M12 3v18M3 12h18M6 6l12 12M18 6L6 18' stroke-width='1.1'/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
