{%- liquid
  assign bg_alt = section.settings.bg_image.alt | default: section.settings.heading | escape
-%}

<section
  id="PwLandscapeQuote-{{ section.id }}"
  class="pw-landscape-quote"
  style="
    --plq-accent: {{ section.settings.accent_color }};
    --plq-heading-color: {{ section.settings.heading_color }};
    --plq-body-color: {{ section.settings.body_color }};
    --plq-section-height: {{ section.settings.section_height }}px;
    --plq-accent-width: {{ section.settings.accent_width }}px;
    --plq-content-gap: {{ section.settings.content_gap }}px;
    --plq-heading-size: {{ section.settings.heading_font_size }}px;
    --plq-body-size: {{ section.settings.body_font_size }}px;
    --plq-gradient-solid: {{ section.settings.gradient_solid_stop }}%;
    --plq-gradient-end: {{ section.settings.gradient_fade_end }}%;
  "
>
  <div class="pw-landscape-quote__bg" aria-hidden="true">
    {%- if section.settings.bg_image != blank -%}
      {{
        section.settings.bg_image
        | image_url: width: 3840
        | image_tag:
          loading: 'lazy',
          widths: '900, 1200, 1600, 1920, 2560, 3840',
          sizes: '100vw',
          width: section.settings.bg_image.width,
          height: section.settings.bg_image.height,
          alt: bg_alt,
          class: 'pw-landscape-quote__bg-img'
      }}
    {%- else -%}
      <div class="pw-landscape-quote__bg-placeholder">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="pw-landscape-quote__gradient" aria-hidden="true"></div>

  <div class="pw-container pw-landscape-quote__container">
    <div class="pw-landscape-quote__content">
      <div class="pw-landscape-quote__accent" aria-hidden="true"></div>

      <div class="pw-landscape-quote__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="pw-landscape-quote__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="pw-landscape-quote__body">{{ section.settings.body | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;500&display=swap');

  #PwLandscapeQuote-{{ section.id }} {
    {% render 'pw-align-vars' %}
    --pw-content: 1280px;
    --pw-gutter: 48px;
    --pw-inner: 1376px;
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwLandscapeQuote-{{ section.id }},
  #PwLandscapeQuote-{{ section.id }} *,
  #PwLandscapeQuote-{{ section.id }} *::before,
  #PwLandscapeQuote-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PwLandscapeQuote-{{ section.id }} {
    position: relative;
    width: 100%;
    height: var(--plq-section-height);
    min-height: var(--plq-section-height);
    margin: 0;
    padding: 0;
    font-family: 'Inter', Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    isolation: isolate;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__bg-img,
  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    max-width: none;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__bg-placeholder {
    width: 100%;
    height: 100%;
    background: #e8ebe6;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__bg-placeholder svg {
    width: 40%;
    height: auto;
    opacity: 0.35;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      #ffffff 0%,
      #ffffff var(--plq-gradient-solid),
      rgba(255, 255, 255, 0.92) calc(var(--plq-gradient-solid) + 4%),
      rgba(255, 255, 255, 0.72) calc(var(--plq-gradient-solid) + 8%),
      rgba(255, 255, 255, 0.42) calc(var(--plq-gradient-solid) + 14%),
      rgba(255, 255, 255, 0.14) calc(var(--plq-gradient-end) - 4%),
      transparent var(--plq-gradient-end)
    );
  }

  #PwLandscapeQuote-{{ section.id }} .pw-container.pw-landscape-quote__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--pw-inner, 1376px);
    height: 100%;
    min-height: var(--plq-section-height);
    margin: 0 auto;
    padding-left: var(--pw-gutter, 48px);
    padding-right: var(--pw-gutter, 48px);
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__content {
    display: flex;
    align-items: stretch;
    gap: var(--plq-content-gap);
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0;
    padding: 0;
    position: relative;
    z-index: 3;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__accent {
    flex: 0 0 var(--plq-accent-width);
    width: var(--plq-accent-width);
    min-width: var(--plq-accent-width);
    background: var(--plq-accent);
    border-radius: 1px;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__copy {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__heading {
    margin: 0 0 18px;
    padding: 0;
    font-family: 'Montserrat', Montserrat, system-ui, sans-serif !important;
    font-weight: 800 !important;
    font-style: normal !important;
    font-size: clamp(28px, 2vw, var(--plq-heading-size)) !important;
    line-height: 1.15 !important;
    letter-spacing: -0.3px;
    text-transform: none !important;
    text-indent: 0 !important;
    color: var(--plq-heading-color) !important;
    background: transparent !important;
    border: 0 !important;
    overflow: visible !important;
    transform: none !important;
  }

  #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', Inter, system-ui, sans-serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(16px, 1.1vw, var(--plq-body-size)) !important;
    line-height: 1.7 !important;
    letter-spacing: 0;
    text-indent: 0 !important;
    color: var(--plq-body-color) !important;
    max-width: {{ section.settings.body_max_width }}px;
    background: transparent !important;
    border: 0 !important;
    overflow: visible !important;
    transform: none !important;
  }

  @media screen and (max-width: 1180px) {
    #PwLandscapeQuote-{{ section.id }} {
      --pw-gutter: 34px;
      --pw-inner: 1348px;
    }
  }

  @media screen and (max-width: 860px) {
    #PwLandscapeQuote-{{ section.id }} {
      --pw-gutter: 22px;
      --pw-inner: 1324px;
      height: auto;
      min-height: 0;
    }

    #PwLandscapeQuote-{{ section.id }} .pw-container.pw-landscape-quote__container {
      height: auto;
      min-height: 0;
      padding-top: 48px;
      padding-bottom: 48px;
    }

    #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__content,
    #PwLandscapeQuote-{{ section.id }} .pw-landscape-quote__body {
      max-width: none;
    }
  }

  @media screen and (max-width: 560px) {
    #PwLandscapeQuote-{{ section.id }} {
      --pw-gutter: 20px;
      --pw-inner: 1320px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Landscape Quote",
  "tag": "section",
  "class": "pw-section",
  "settings": [
    {
      "type": "header",
      "content": "Background — Figma 1920 × 669"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Full-width background image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center (Figma default)" },
        { "value": "55% center", "label": "Slight right" },
        { "value": "right center", "label": "Right" },
        { "value": "left center", "label": "Left" }
      ]
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 670,
      "info": "Figma: 668.8px"
    },
    {
      "type": "range",
      "id": "gradient_solid_stop",
      "label": "Solid white zone (left)",
      "min": 15,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 24
    },
    {
      "type": "range",
      "id": "gradient_fade_end",
      "label": "Gradient fade end",
      "min": 40,
      "max": 65,
      "step": 1,
      "unit": "%",
      "default": 54
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "That's Primal Win."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Built by people who wanted a product that actually works, for people who hold themselves to a higher standard."
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 360,
      "max": 720,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "body_max_width",
      "label": "Body text max width",
      "min": 280,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "Accent bar"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold bar color",
      "default": "#C89A3D"
    },
    {
      "type": "range",
      "id": "accent_width",
      "label": "Bar width",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between bar and text",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F2326"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#3A403B"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Landscape Quote"
    }
  ]
}
{% endschema %}
