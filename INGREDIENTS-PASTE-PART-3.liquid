      {%- endif -%}
  };

  var CATEGORIES = [
    ['all', "All Benefits"],
    ['gut', "Gut Health"],
    ['brain', "Brain Function"],
    ['energy', "Energy & Vitality"],
    ['immune', "Immune Support"],
    ['performance', "Performance & Recovery"],
    ['skin', "Healthy Skin, Hair & Nails"],
    ['overall', "Overall Wellbeing"]
  ];

  var REFERENCES_LABEL = {{ section.settings.references_label | json }};

  var ingredients;
  try {
    ingredients = JSON.parse(dataNode.textContent || '[]');
  } catch (error) {
    detailNode.innerHTML = '<div class="pw-list-empty">Ingredient data could not be loaded.</div>';
    return;
  }

  ingredients.forEach(function (item) {
    item.cats = String(item.cats || '').split(',').filter(Boolean);
    item.slug = String(item.name || '')
      .toLowerCase()
      .replace(/['\u2019]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
  });

  function esc(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function lines(value) {
    return String(value || '')
      .split(/\r?\n/)
      .map(function (line) { return line.trim(); })
      .filter(Boolean);
  }

  function copy(value) {
    var items = lines(value);
    if (!items.length) return '';
    if (items.length === 1) return '<p>' + esc(items[0]) + '</p>';
    return '<ul>' + items.map(function (item) {
      return '<li>' + esc(item) + '</li>';
    }).join('') + '</ul>';
  }

  var category = 'all';
  var expanded = false;
  var params = new URLSearchParams(window.location.search);
  var wanted = params.get('ing');
  var active = 0;
  ingredients.forEach(function (item, index) {
    if (item.slug === wanted) active = index;
  });

  function visible() {
    if (category === 'all') return ingredients;
    return ingredients.filter(function (item) {
      return item.cats.indexOf(category) !== -1;
    });
  }

  function renderFilters() {
    filtersNode.innerHTML = CATEGORIES.map(function (pair) {
      var key = pair[0];
      var label = pair[1];
      var on = category === key;
      return '<button type="button" class="pw-filter' + (on ? ' is-active' : '') +
        '" data-category="' + key + '" aria-pressed="' + on + '">' +
        '<img src="' + esc(ICONS[key]) + '" alt="" width="26" height="26" loading="lazy">' +
        '<span>' + esc(label) + '</span></button>';
    }).join('');

    filtersNode.querySelectorAll('[data-category]').forEach(function (button) {
      button.addEventListener('click', function () {
        category = button.dataset.category;
        expanded = false;
        var list = visible();
        if (list.indexOf(ingredients[active]) === -1) {
          active = list.length ? ingredients.indexOf(list[0]) : -1;
        }
        render();
      });
    });
  }

  function renderList() {
    var list = visible();
    if (!list.length) {
      listNode.innerHTML = '<div class="pw-list-empty">No ingredients in this category yet.</div>';
      return;
    }

    listNode.innerHTML = list.map(function (item) {
      var index = ingredients.indexOf(item);
      var on = index === active;
      return '<button type="button" class="pw-list-item' + (on ? ' is-active' : '') +
        '" data-index="' + index + '" aria-pressed="' + on + '">' +
        '<span class="pw-abbr">' + esc(item.abbr) + '</span>' +
        '<span class="pw-list-copy"><strong>' + esc(item.name) + '</strong>' +
        '<small>' + esc(item.type) + '</small></span>' +
        '<span class="pw-list-chevron" aria-hidden="true">&rsaquo;</span></button>';
    }).join('');

    // On narrow screens only the first eight are shown until asked for more.
    if (moreNode) {
      var narrow = window.matchMedia('(max-width: 960px)').matches;
      if (narrow && list.length > 8 && !expanded) {
        listNode.classList.add('pw-list--collapsed');
        moreNode.hidden = false;
        moreNode.textContent = 'Show all ' + list.length + ' ingredients';
      } else {
        listNode.classList.remove('pw-list--collapsed');
        moreNode.hidden = !(narrow && list.length > 8);
        moreNode.textContent = 'Show fewer';
      }
    }

    listNode.querySelectorAll('[data-index]').forEach(function (button) {
      button.addEventListener('click', function () {
        active = Number(button.dataset.index);
        var item = ingredients[active];
        if (item && window.history && window.history.replaceState) {
          var url = new URL(window.location.href);
          url.searchParams.set('ing', item.slug);
          window.history.replaceState({}, '', url);
        }
        renderList();
        renderDetail();

        // the panel sits above the list on narrow screens, so bring it into view
        if (window.matchMedia('(max-width: 960px)').matches) {
          detailNode.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  function references(item) {
    var term = encodeURIComponent(item.name);
    var links = [];
    if (item.referenceUrl) links.push(['Approved reference', item.referenceUrl]);
    links.push(['NIH evidence search', 'https://search.nih.gov/search?affiliate=nih&query=' + term]);
    links.push(['EFSA evidence search', 'https://www.efsa.europa.eu/en/search?text=' + term]);
    links.push(['PubMed research', 'https://pubmed.ncbi.nlm.nih.gov/?term=' + term]);
    return links;
  }

  function renderDetail() {
    var item = ingredients[active] || visible()[0];
    if (!item) {
      detailNode.innerHTML = '<div class="pw-list-empty">Select a category to see ingredients.</div>';
      return;
    }

    var image = item.image
      ? '<img class="pw-detail-img" src="' + esc(item.image) + '" alt="' + esc(item.name) + '" loading="lazy">'
      : '';

    var badge = item.badge || item.tag;

    detailNode.innerHTML =
      '<div class="pw-detail-head">' +
        '<span class="pw-abbr">' + esc(item.abbr) + '</span>' +
        '<div class="pw-detail-title"><h3>' + esc(item.name) + '</h3>' +
        '<small>' + esc(item.type) + '</small></div>' +
        (badge ? '<span class="pw-detail-badge">' + esc(badge) + '</span>' : '') +
      '</div>' +
      '<div class="pw-detail-body">' +
        '<div class="pw-detail-image">' + image + '</div>' +
        '<div class="pw-detail-content">' +
          '<div class="pw-detail-col"><h4>What It Does</h4>' + copy(item.what) + '</div>' +
          '<div class="pw-detail-pair">' +
            '<div class="pw-detail-col"><h4>How It Works</h4>' + copy(item.how) + '</div>' +
            '<div class="pw-detail-col"><h4>Why We Included It</h4>' + copy(item.why) + '</div>' +
          '</div>' +
        '</div>' +
      '</div>' +
      '<div class="pw-detail-foot">' +
        '<span class="pw-evidence-label">Scientifically Supported By</span>' +
        '<span class="pw-evidence"><strong>NIH</strong> <span>National Institutes of Health</span></span>' +
        '<span class="pw-evidence"><strong>EFSA</strong> <span>European Food Safety Authority</span></span>' +
        '<button type="button" class="pw-reference-button" data-pw-refs>' +
          esc(REFERENCES_LABEL) + ' <span aria-hidden="true">&rarr;</span>' +
        '</button>' +
      '</div>' +
      '<div class="pw-reference-panel" data-pw-panel hidden>' +
        '<strong>' + esc(item.name) + ' references</strong>' +
        references(item).map(function (pair) {
          return '<a href="' + esc(pair[1]) + '" target="_blank" rel="noopener noreferrer">' +
            '<span>' + esc(pair[0]) + '</span><span aria-hidden="true">&rarr;</span></a>';
        }).join('') +
      '</div>';

    var button = detailNode.querySelector('[data-pw-refs]');
    var panel = detailNode.querySelector('[data-pw-panel]');
    if (button && panel) {
      button.addEventListener('click', function (event) {
        event.stopPropagation();
        panel.hidden = !panel.hidden;
      });
    }
  }

  if (moreNode) {
    moreNode.addEventListener('click', function () {
      expanded = !expanded;
      renderList();
    });
  }

  var narrowQuery = window.matchMedia('(max-width: 960px)');
  var onBreakpoint = function () {
    expanded = false;
    renderList();
  };
  if (narrowQuery.addEventListener) {
    narrowQuery.addEventListener('change', onBreakpoint);
  } else if (narrowQuery.addListener) {
    narrowQuery.addListener(onBreakpoint);
  }

  function render() {
    renderFilters();
    renderList();
    renderDetail();
  }

  function scrollToDeepLinkedIngredient() {
    if (!wanted) return;

    var matched = ingredients.some(function (item) {
      return item.slug === wanted;
    });
    if (!matched) return;

    requestAnimationFrame(function () {
      var narrow = window.matchMedia('(max-width: 960px)').matches;
      var target = narrow ? detailNode : root.querySelector('[data-pw-explorer]');
      if (!target) return;

      target.scrollIntoView({ behavior: 'auto', block: 'start' });
    });
  }

  document.addEventListener('click', function (event) {
    var panel = detailNode.querySelector('[data-pw-panel]');
    if (panel && !panel.hidden && !panel.contains(event.target)) panel.hidden = true;
  });

  document.addEventListener('shopify:block:select', function (event) {
    ingredients.forEach(function (item, index) {
      if (item.blockId === event.detail.blockId) {
        active = index;
        category = 'all';
        render();
      }
    });
  });

  render();
  scrollToDeepLinkedIngredient();
})();
</script>

