{%- liquid
  assign hero_alt = section.settings.bg_image.alt | default: section.settings.heading_text | escape
  assign overlay_alpha = section.settings.overlay_opacity | times: 0.01
-%}

<section
  id="PwReturnsHero-{{ section.id }}"
  class="returns-hero"
  style="--returns-overlay: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_alpha }};"
>
  <div class="returns-hero__bg" aria-hidden="true">
    {%- if section.settings.bg_image != blank -%}
      {{
        section.settings.bg_image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw',
          width: section.settings.bg_image.width,
          height: section.settings.bg_image.height,
          alt: hero_alt,
          class: 'returns-hero__bg-img'
      }}
    {%- else -%}
      <div class="returns-hero__bg-placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="returns-hero__overlay" aria-hidden="true"></div>

  <div class="pw-container returns-hero__container">
    <div class="returns-hero__content">
      {%- if section.settings.heading_text != blank -%}
        <h1 class="returns-hero__heading">{{ section.settings.heading_text | escape }}</h1>
      {%- endif -%}

      <div class="returns-hero__subrow">
        {%- if section.settings.subheading_text_1 != blank -%}
          <span class="returns-hero__subitem">{{ section.settings.subheading_text_1 | escape }}</span>
        {%- endif -%}

        {%- if section.settings.subheading_text_1 != blank and section.settings.subheading_text_2 != blank -%}
          <span class="returns-hero__dot" aria-hidden="true">&#9679;</span>
        {%- endif -%}

        {%- if section.settings.subheading_text_2 != blank -%}
          <span class="returns-hero__subitem">{{ section.settings.subheading_text_2 | escape }}</span>
        {%- endif -%}
      </div>

      <hr class="returns-hero__divider">
    </div>
  </div>
</section>

{% style %}
  #PwReturnsHero-{{ section.id }} {
    {% render 'pw-align-vars' %}
    --returns-heading-color: {{ section.settings.heading_color }};
    --returns-subheading-color: {{ section.settings.subheading_color }};
    --returns-dot-color: {{ section.settings.dot_color }};
    --returns-divider-color: {{ section.settings.divider_color | default: '#D4A017' }};
    --returns-heading-size: {{ section.settings.heading_font_size }}px;
    --returns-min-height: {{ section.settings.min_height }}px;
    --returns-padding-top: {{ section.settings.padding_top }}px;
    --returns-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwReturnsHero-{{ section.id }},
  #PwReturnsHero-{{ section.id }} *,
  #PwReturnsHero-{{ section.id }} *::before,
  #PwReturnsHero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PwReturnsHero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: var(--returns-min-height);
    padding-top: clamp(40px, 10vw, var(--returns-padding-top));
    padding-bottom: clamp(24px, 5vw, var(--returns-padding-bottom));
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__bg-img,
  #PwReturnsHero-{{ section.id }} .returns-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__bg-placeholder {
    width: 100%;
    height: 100%;
    background: #2b2b2b;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__bg-placeholder svg {
    width: 40%;
    height: auto;
    opacity: 0.4;
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--returns-overlay);
    pointer-events: none;
  }

  #PwReturnsHero-{{ section.id }} .pw-container.returns-hero__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--pw-inner);
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__content {
    width: 100%;
    max-width: var(--pw-content);
    margin-inline: auto;
    padding-top: clamp(24px, 5vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__heading {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    font-weight: 700;
    font-size: clamp(34px, 7vw, var(--returns-heading-size));
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--returns-heading-color);
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__subrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 18px;
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__subitem {
    font-family: Inter, Arial, sans-serif;
    font-weight: 400;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.55;
    color: var(--returns-subheading-color);
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__dot {
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1;
    color: var(--returns-dot-color);
  }

  #PwReturnsHero-{{ section.id }} .returns-hero__divider {
    width: 90px;
    height: 0;
    border: 0;
    border-top: 6px solid var(--returns-divider-color);
    margin: 0;
    display: block;
  }

  @media screen and (max-width: 749px) {
    #PwReturnsHero-{{ section.id }} .returns-hero__subrow {
      gap: 8px;
    }

    #PwReturnsHero-{{ section.id }} .returns-hero__content {
      gap: 12px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Returns Policy Hero",
  "tag": "section",
  "class": "pw-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Vertical position / size"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Section min height (px)",
      "min": 300,
      "max": 900,
      "step": 10,
      "default": 540
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above text (px)",
      "min": 0,
      "max": 300,
      "step": 5,
      "default": 175
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below text (px)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 70
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Returns Policy"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size (px)",
      "min": 40,
      "max": 120,
      "step": 1,
      "default": 90
    },
    {
      "type": "header",
      "content": "Subheading row"
    },
    {
      "type": "text",
      "id": "subheading_text_1",
      "label": "Subheading text 1",
      "default": "Effective from date of purchase"
    },
    {
      "type": "text",
      "id": "subheading_text_2",
      "label": "Subheading text 2",
      "default": "Last updated July 2026"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading text color",
      "default": "#FFFFFFCC"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot separator color",
      "default": "#D4A017"
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#D4A017"
    }
  ],
  "presets": [
    {
      "name": "Returns Policy Hero",
      "category": "Primal Win"
    }
  ]
}
{% endschema %}
