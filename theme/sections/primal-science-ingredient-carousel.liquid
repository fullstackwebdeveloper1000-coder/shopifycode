<section
  id="PwIngCarousel-{{ section.id }}"
  class="pw-ing-car"
  data-pw-ing-carousel
>
  <div class="pw-ing-car__container">
    <div class="pw-ing-car__head">
      {%- if section.settings.heading != blank -%}
        <h2>
          <span class="pw-ing-car__rule" aria-hidden="true"></span>
          {{ section.settings.heading }}
          <span class="pw-ing-car__rule" aria-hidden="true"></span>
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="pw-ing-car__wrap">
      <button class="pw-ing-car__arrow pw-ing-car__arrow--prev" type="button" aria-label="Previous slide" data-car-prev>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <button class="pw-ing-car__arrow pw-ing-car__arrow--next" type="button" aria-label="Next slide" data-car-next>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      </button>

      <div class="pw-ing-car__viewport" data-car-viewport>
        <div class="pw-ing-car__track" data-car-track>
          {%- assign slide_total = section.settings.slide_count | default: 3 -%}
          {%- for slide_index in (1..slide_total) -%}
            <div class="pw-ing-car__slide">
              {%- for block in section.blocks -%}
                {%- if block.settings.slide == slide_index -%}
                  <article class="pw-ing-car__tile" {{ block.shopify_attributes }}>
                    <div class="pw-ing-car__img">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 600
                          | image_tag:
                            alt: block.settings.title,
                            loading: 'lazy',
                            class: 'pw-ing-car__img-photo'
                        }}
                      {%- endif -%}
                      {%- if block.settings.badge_multiplier != blank or block.settings.badge_text != blank -%}
                        <span class="pw-ing-car__badge">
                          {%- if block.settings.badge_multiplier != blank -%}
                            <b>{{ block.settings.badge_multiplier }}</b>
                          {%- endif -%}
                          {{ block.settings.badge_text | newline_to_br }}
                        </span>
                      {%- endif -%}
                    </div>
                    <div class="pw-ing-car__body">
                      <h4>
                        {{ block.settings.title }}
                        {%- if block.settings.title_suffix != blank -%}
                          <span>{{ block.settings.title_suffix }}</span>
                        {%- endif -%}
                      </h4>
                      {%- if block.settings.subtitle != blank -%}
                        <p class="pw-ing-car__sub">{{ block.settings.subtitle }}</p>
                      {%- endif -%}
                      {%- if block.settings.amount != blank -%}
                        <p class="pw-ing-car__amt">
                          {{ block.settings.amount }}
                          {%- if block.settings.amount_unit != blank -%}<span>{{ block.settings.amount_unit }}</span>{%- endif -%}
                        </p>
                      {%- endif -%}
                      {%- if block.settings.brand_label != blank -%}
                        <p class="pw-ing-car__label">{{ block.settings.brand_label }}</p>
                      {%- endif -%}
                      {%- if block.settings.form != blank -%}
                        <p class="pw-ing-car__form">{{ block.settings.form }}</p>
                      {%- endif -%}
                      {%- if block.settings.why != blank -%}
                        <p class="pw-ing-car__why"><b>Why it matters:</b> {{ block.settings.why }}</p>
                      {%- endif -%}
                      <hr>
                      {%- if block.settings.typical_label != blank -%}
                        <p class="pw-ing-car__typ">
                          <b>{{ block.settings.typical_label }}</b>{{ block.settings.typical_form }}
                        </p>
                      {%- endif -%}
                      {%- if block.settings.typical_amount != blank -%}
                        <p class="pw-ing-car__typamt">
                          {{ block.settings.typical_amount }}
                          {%- if block.settings.typical_note != blank -%}<span>{{ block.settings.typical_note }}</span>{%- endif -%}
                        </p>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="pw-ing-car__foot">
        <div class="pw-ing-car__dots" data-car-dots></div>
        <span class="pw-ing-car__count" data-car-count>01 / 0{{ slide_total }}</span>
      </div>

      {%- if section.settings.footnote != blank -%}
        <p class="pw-ing-car__note">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    max-width: 100% !important;
  }

  #PwIngCarousel-{{ section.id }},
  #PwIngCarousel-{{ section.id }} * {
    box-sizing: border-box;
  }

  #PwIngCarousel-{{ section.id }} {
    width: 100%;
    padding: 56px 0 60px;
    background: #14171a;
    color: #fff;
    -webkit-font-smoothing: antialiased;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__container {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 48px;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__head {
    max-width: 820px;
    margin: 0 auto 34px;
    text-align: center;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__head h2 {
    margin: 0 0 12px;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    color: #fff;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__rule {
    display: inline-block;
    width: 40px;
    height: 2px;
    margin: 0 16px;
    background: #c89a3d;
    vertical-align: middle;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__head p {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: #c7cbce;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__wrap {
    position: relative;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__viewport {
    overflow: hidden;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__track {
    display: flex;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__slide {
    flex: 0 0 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__tile {
    display: flex;
    min-height: 300px;
    overflow: hidden;
    border-radius: 12px;
    background: #f7f5f1;
    color: #1f2326;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__img {
    position: relative;
    flex: 0 0 38%;
    background: linear-gradient(160deg, #3a4034, #171b16);
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__img-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__badge {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    display: flex;
    width: 92px;
    height: 92px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #c89a3d;
    color: #14171a;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 10px;
    line-height: 1.15;
    letter-spacing: 0.3px;
    text-align: center;
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.5);
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__badge b {
    font-size: 22px;
    font-weight: 800;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__body {
    flex: 1;
    padding: 18px 18px 16px;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__body h4 {
    margin: 0 0 2px;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 17px;
    text-transform: uppercase;
    color: #1f2326;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__body h4 span {
    font-weight: 600;
    font-size: 12px;
    color: #737a80;
    text-transform: none;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__sub,
  #PwIngCarousel-{{ section.id }} .pw-ing-car__form,
  #PwIngCarousel-{{ section.id }} .pw-ing-car__typ {
    margin: 0 0 2px;
    font-family: Inter, Arial, sans-serif;
    font-size: 12px;
    color: #737a80;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__sub {
    margin-bottom: 6px;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__amt {
    margin: 0 0 8px;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 34px;
    line-height: 1;
    color: #c89a3d;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__amt span {
    font-size: 16px;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__label {
    margin: 0;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #1f2326;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__form {
    margin-bottom: 12px;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__why {
    margin: 0 0 12px;
    font-family: Inter, Arial, sans-serif;
    font-size: 12px;
    line-height: 1.45;
    color: #1f2326;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__body hr {
    margin: 0 0 10px;
    border: 0;
    border-top: 1px solid rgba(31, 35, 38, 0.12);
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__typ b {
    display: block;
    margin-bottom: 2px;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 700;
    font-size: 10.5px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #1f2326;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__typamt {
    margin: 0;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: #1f2326;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__typamt span {
    display: block;
    font-family: Inter, Arial, sans-serif;
    font-weight: 400;
    font-size: 11px;
    color: #737a80;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #c89a3d;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.2);
    color: #c89a3d;
    cursor: pointer;
    transform: translateY(-50%);
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__arrow--prev { left: -14px; }
  #PwIngCarousel-{{ section.id }} .pw-ing-car__arrow--next { right: -14px; }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__dots {
    display: flex;
    gap: 8px;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__dots button {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    cursor: pointer;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__dots button.is-active {
    background: #c89a3d;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__count {
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.5px;
    color: #737a80;
  }

  #PwIngCarousel-{{ section.id }} .pw-ing-car__note {
    margin: 16px 0 0;
    text-align: center;
    font-family: Inter, Arial, sans-serif;
    font-size: 12px;
    color: #737a80;
  }

  @media screen and (max-width: 960px) {
    #PwIngCarousel-{{ section.id }} .pw-ing-car__container {
      padding: 0 34px;
    }

    #PwIngCarousel-{{ section.id }} .pw-ing-car__slide {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #PwIngCarousel-{{ section.id }} .pw-ing-car__tile {
      min-height: 0;
    }

    #PwIngCarousel-{{ section.id }} .pw-ing-car__arrow--prev { left: 2px; }
    #PwIngCarousel-{{ section.id }} .pw-ing-car__arrow--next { right: 2px; }
  }

  @media screen and (max-width: 560px) {
    #PwIngCarousel-{{ section.id }} .pw-ing-car__container {
      padding: 0 20px;
    }

    #PwIngCarousel-{{ section.id }} .pw-ing-car__head h2 {
      font-size: 22px;
    }

    #PwIngCarousel-{{ section.id }} .pw-ing-car__rule {
      display: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById('PwIngCarousel-{{ section.id }}');
    if (!root || root.dataset.ingCarouselReady === 'true') return;
    root.dataset.ingCarouselReady = 'true';

    const track = root.querySelector('[data-car-track]');
    const dotsWrap = root.querySelector('[data-car-dots]');
    const countEl = root.querySelector('[data-car-count]');
    const viewport = root.querySelector('[data-car-viewport]');
    const slides = track ? track.children.length : 0;
    if (!track || !slides) return;

    let index = 0;
    const pad = (n) => String(n).padStart(2, '0');

    for (let s = 0; s < slides; s += 1) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', `Go to slide ${s + 1}`);
      dot.addEventListener('click', () => go(s));
      dotsWrap.appendChild(dot);
    }

    const dots = [...dotsWrap.children];

    const render = () => {
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, n) => dot.classList.toggle('is-active', n === index));
      if (countEl) countEl.textContent = `${pad(index + 1)} / ${pad(slides)}`;
    };

    const go = (n) => {
      index = (n + slides) % slides;
      render();
    };

    root.querySelector('[data-car-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-car-next]')?.addEventListener('click', () => go(index + 1));

    let touchX = null;
    viewport?.addEventListener('touchstart', (e) => {
      touchX = e.touches[0].clientX;
    }, { passive: true });

    viewport?.addEventListener('touchend', (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
      touchX = null;
    });

    render();
    document.addEventListener('shopify:section:load', render);
  })();
</script>

