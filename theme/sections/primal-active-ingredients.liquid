{%- liquid
  assign image_alt = section.settings.image.alt | default: 'Primal Win pouch with greens powder and scoop'

  assign icon_1_svg_value = section.settings.icon_1_svg | strip
  assign icon_2_svg_value = section.settings.icon_2_svg | strip
  assign icon_3_svg_value = section.settings.icon_3_svg | strip

  assign icon_1_svg_src = ''
  assign icon_2_svg_src = ''
  assign icon_3_svg_src = ''

  if icon_1_svg_value != blank
    if icon_1_svg_value contains '://'
      assign icon_1_svg_src = icon_1_svg_value
    else
      assign icon_1_svg_src = icon_1_svg_value | asset_url
    endif
  endif

  if icon_2_svg_value != blank
    if icon_2_svg_value contains '://'
      assign icon_2_svg_src = icon_2_svg_value
    else
      assign icon_2_svg_src = icon_2_svg_value | asset_url
    endif
  endif

  if icon_3_svg_value != blank
    if icon_3_svg_value contains '://'
      assign icon_3_svg_src = icon_3_svg_value
    else
      assign icon_3_svg_src = icon_3_svg_value | asset_url
    endif
  endif
-%}

<section
  id="PwActiveIngredients-{{ section.id }}"
  class="pw-active-ingredients band band-dark proof"
>
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        class: 'band-img',
        loading: 'lazy',
        widths: '800, 1200, 1600, 2000, 2400',
        sizes: '(min-width: 861px) 50vw, 100vw',
        width: section.settings.image.width,
        height: section.settings.image.height,
        alt: image_alt
    }}
  {%- elsif section.settings.fallback_image_url != blank -%}
    <img
      class="band-img"
      src="{{ section.settings.fallback_image_url }}"
      alt="{{ image_alt | escape }}"
      loading="lazy"
      width="1600"
      height="900"
    >
  {%- endif -%}

  <div class="pw-container band-in">
    <div class="band-copy">
      <span class="pai__rule" aria-hidden="true"></span>

      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | newline_to_br }}</h2>
      {%- endif -%}

      <div class="proof-cols">
        <div class="proof-col">
          <span class="ic" aria-hidden="true">
            {%- if icon_1_svg_src != blank -%}
              <img class="pai__icon-image" src="{{ icon_1_svg_src | escape }}" alt="" width="26" height="26" loading="lazy">
            {%- elsif section.settings.icon_1_image != blank -%}
              {{ section.settings.icon_1_image | image_url: width: 120 | image_tag: class: 'pai__icon-image', loading: 'lazy', widths: '52, 78, 104, 120', sizes: '26px', alt: '' }}
            {%- else -%}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="3" width="16" height="18" rx="2"/>
                <path d="M8 8l1.5 1.5L12 7"/>
                <path d="M8 15l1.5 1.5L12 14"/>
                <path d="M15 8h2M15 15h2"/>
              </svg>
            {%- endif -%}
          </span>
          <h4>{{ section.settings.feature_1_title | escape }}</h4>
          <p>{{ section.settings.feature_1_subtitle | escape }}</p>
        </div>

        <div class="proof-col">
          <span class="ic" aria-hidden="true">
            {%- if icon_2_svg_src != blank -%}
              <img class="pai__icon-image" src="{{ icon_2_svg_src | escape }}" alt="" width="26" height="26" loading="lazy">
            {%- elsif section.settings.icon_2_image != blank -%}
              {{ section.settings.icon_2_image | image_url: width: 120 | image_tag: class: 'pai__icon-image', loading: 'lazy', widths: '52, 78, 104, 120', sizes: '26px', alt: '' }}
            {%- else -%}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4v16M7 20h10"/>
                <path d="M5 8h14"/>
                <path d="M5 8l-2.5 5a3 3 0 0 0 5 0L5 8Z"/>
                <path d="M19 8l-2.5 5a3 3 0 0 0 5 0L19 8Z"/>
              </svg>
            {%- endif -%}
          </span>
          <h4>{{ section.settings.feature_2_title | escape }}</h4>
          <p>{{ section.settings.feature_2_subtitle | escape }}</p>
        </div>

        <div class="proof-col">
          <span class="ic" aria-hidden="true">
            {%- if icon_3_svg_src != blank -%}
              <img class="pai__icon-image" src="{{ icon_3_svg_src | escape }}" alt="" width="26" height="26" loading="lazy">
            {%- elsif section.settings.icon_3_image != blank -%}
              {{ section.settings.icon_3_image | image_url: width: 120 | image_tag: class: 'pai__icon-image', loading: 'lazy', widths: '52, 78, 104, 120', sizes: '26px', alt: '' }}
            {%- else -%}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l8 3v5c0 5-3.4 8-8 10-4.6-2-8-5-8-10V6l8-3Z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            {%- endif -%}
          </span>
          <h4>{{ section.settings.feature_3_title | escape }}</h4>
          <p>{{ section.settings.feature_3_subtitle | escape }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800;900&display=swap');

  #PwActiveIngredients-{{ section.id }} {
    {% render 'pw-align-vars' %}
    --pai-bg: {{ section.settings.background_color }};
    --pai-gold: {{ section.settings.gold_color }};
    --pai-text: {{ section.settings.text_color }};
    --pai-muted: {{ section.settings.muted_text_color }};
    --pai-section-height: {{ section.settings.section_height }}px;
    --pai-image-width: {{ section.settings.image_width }}vw;
    --pai-image-max: {{ section.settings.image_max_width }}px;
    --pai-image-x: {{ section.settings.image_position_x }}%;
    --pai-image-y: {{ section.settings.image_position_y }}%;
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: var(--pai-bg) !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwActiveIngredients-{{ section.id }},
  #PwActiveIngredients-{{ section.id }} *,
  #PwActiveIngredients-{{ section.id }} *::before,
  #PwActiveIngredients-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PwActiveIngredients-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: var(--pai-section-height);
    overflow: hidden;
    background: var(--pai-bg);
    color: var(--pai-text);
    font-family: Inter, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PwActiveIngredients-{{ section.id }} .band-img {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    height: 100%;
    width: var(--pai-image-width);
    max-width: var(--pai-image-max);
    object-fit: cover;
    object-position: var(--pai-image-x) var(--pai-image-y);
    display: block;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 11%);
    mask-image: linear-gradient(to right, transparent 0%, #000 11%);
  }

  #PwActiveIngredients-{{ section.id }} .pw-container.band-in {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--pw-inner);
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
    min-height: var(--pai-section-height);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 74px;
    padding-bottom: 34px;
  }

  #PwActiveIngredients-{{ section.id }} .band-copy {
    width: 100%;
    max-width: 820px;
    margin: 0;
    padding: 0;
  }

  #PwActiveIngredients-{{ section.id }} .pai__rule {
    display: block;
    width: 64px;
    height: 4px;
    margin: 0 0 25px;
    background: var(--pai-gold);
    border: 0;
  }

  #PwActiveIngredients-{{ section.id }} .eyebrow {
    margin: 0 0 17px;
    color: var(--pai-gold) !important;
    font-family: Montserrat, Arial, sans-serif !important;
    font-weight: 700 !important;
    font-size: 22px !important;
    line-height: 1.1 !important;
    letter-spacing: 0 !important;
    text-transform: uppercase !important;
  }

  #PwActiveIngredients-{{ section.id }} h2 {
    margin: 0 0 44px;
    max-width: 690px;
    color: var(--pai-text) !important;
    font-family: Montserrat, Arial, sans-serif !important;
    font-weight: 900 !important;
    font-size: 72px !important;
    line-height: 0.96 !important;
    letter-spacing: -1.2px !important;
    text-transform: uppercase !important;
    background: transparent !important;
    border: 0 !important;
    overflow: visible !important;
  }

  #PwActiveIngredients-{{ section.id }} .proof-cols {
    display: grid;
    grid-template-columns: 176px 200px 270px;
    gap: 52px;
    width: 100%;
    max-width: 820px;
  }

  #PwActiveIngredients-{{ section.id }} .proof-col {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  #PwActiveIngredients-{{ section.id }} .ic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 0 20px;
    border: 2px solid var(--pai-gold);
    border-radius: 50%;
    color: var(--pai-gold);
    overflow: hidden;
  }

  #PwActiveIngredients-{{ section.id }} .ic svg,
  #PwActiveIngredients-{{ section.id }} .pai__icon-image {
    display: block;
    width: 36px;
    height: 36px;
    max-width: 36px;
    max-height: 36px;
    object-fit: contain;
  }

  #PwActiveIngredients-{{ section.id }} .proof-col h4 {
    margin: 0 0 4px;
    color: var(--pai-gold) !important;
    font-family: Montserrat, Arial, sans-serif !important;
    font-weight: 800 !important;
    font-size: 16px !important;
    line-height: 1.25 !important;
    letter-spacing: 0.5px !important;
    text-transform: uppercase !important;
  }

  #PwActiveIngredients-{{ section.id }} .proof-col p {
    margin: 0;
    color: var(--pai-muted) !important;
    font-family: Montserrat, Arial, sans-serif !important;
    font-weight: 700 !important;
    font-size: 16px !important;
    line-height: 1.25 !important;
    letter-spacing: 0.4px !important;
    text-transform: uppercase !important;
  }

  @media screen and (max-width: 1180px) {
    #PwActiveIngredients-{{ section.id }} .eyebrow {
      font-size: clamp(18px, 1.8vw, 22px) !important;
    }

    #PwActiveIngredients-{{ section.id }} h2 {
      font-size: clamp(48px, 5vw, 72px) !important;
    }

    #PwActiveIngredients-{{ section.id }} .proof-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(24px, 3vw, 52px);
    }

    #PwActiveIngredients-{{ section.id }} .proof-col h4,
    #PwActiveIngredients-{{ section.id }} .proof-col p {
      font-size: clamp(13px, 1.2vw, 16px) !important;
    }
  }

  @media screen and (max-width: 860px) {
    #PwActiveIngredients-{{ section.id }} .pw-container.band-in {
      min-height: 0;
      padding-top: 42px;
      padding-bottom: 0;
    }

    #PwActiveIngredients-{{ section.id }} .band-copy,
    #PwActiveIngredients-{{ section.id }} h2,
    #PwActiveIngredients-{{ section.id }} .proof-cols {
      max-width: none;
    }

    #PwActiveIngredients-{{ section.id }} h2 {
      font-size: clamp(36px, 9vw, 52px) !important;
      margin-bottom: 34px;
    }

    #PwActiveIngredients-{{ section.id }} .band-img {
      position: static;
      width: 100%;
      max-width: none;
      height: 280px;
      margin-top: 8px;
      -webkit-mask-image: none;
      mask-image: none;
    }

    #PwActiveIngredients-{{ section.id }} .pw-container.band-in {
      padding-bottom: 52px;
    }
  }

  @media screen and (max-width: 560px) {
    #PwActiveIngredients-{{ section.id }} .pai__rule {
      width: 56px;
      margin-bottom: 18px;
    }

    #PwActiveIngredients-{{ section.id }} .eyebrow {
      font-size: 16px !important;
    }

    #PwActiveIngredients-{{ section.id }} h2 {
      font-size: 34px !important;
      line-height: 1 !important;
    }

    #PwActiveIngredients-{{ section.id }} .proof-cols {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    #PwActiveIngredients-{{ section.id }} .proof-col {
      display: grid;
      grid-template-columns: 58px minmax(0, 1fr);
      align-items: center;
      gap: 16px;
    }

    #PwActiveIngredients-{{ section.id }} .ic {
      width: 54px;
      height: 54px;
      margin: 0;
    }

    #PwActiveIngredients-{{ section.id }} .band-img {
      height: 220px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "40 Active Ingredients",
  "tag": "section",
  "class": "pw-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section min height",
      "min": 500,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 670
    },
    {
      "type": "header",
      "content": "Right product image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image (right bleed)"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Or paste image URL"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width (desktop)",
      "min": 40,
      "max": 65,
      "step": 1,
      "unit": "vw",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image max width",
      "min": 700,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 960
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image vertical position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Gold eyebrow",
      "default": "Two Years Later:"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main heading",
      "default": "40 Active\nIngredients."
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Feature 1 title (gold)",
      "default": "Every One"
    },
    {
      "type": "text",
      "id": "feature_1_subtitle",
      "label": "Feature 1 subtitle",
      "default": "Listed."
    },
    {
      "type": "text",
      "id": "icon_1_svg",
      "label": "Feature 1 SVG URL / asset filename"
    },
    {
      "type": "image_picker",
      "id": "icon_1_image",
      "label": "Feature 1 icon image"
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Feature 2 title (gold)",
      "default": "Every Amount"
    },
    {
      "type": "text",
      "id": "feature_2_subtitle",
      "label": "Feature 2 subtitle",
      "default": "Shown."
    },
    {
      "type": "text",
      "id": "icon_2_svg",
      "label": "Feature 2 SVG URL / asset filename"
    },
    {
      "type": "image_picker",
      "id": "icon_2_image",
      "label": "Feature 2 icon image"
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Feature 3 title (gold)",
      "default": "No Proprietary Blends."
    },
    {
      "type": "text",
      "id": "feature_3_subtitle",
      "label": "Feature 3 subtitle",
      "default": "Nothing Hidden."
    },
    {
      "type": "text",
      "id": "icon_3_svg",
      "label": "Feature 3 SVG URL / asset filename"
    },
    {
      "type": "image_picker",
      "id": "icon_3_image",
      "label": "Feature 3 icon image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#04100C"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold",
      "default": "#C89A3D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "White heading",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Feature subtitle",
      "default": "#CDD2CB"
    }
  ],
  "presets": [
    {
      "name": "40 Active Ingredients"
    }
  ]
}
{% endschema %}
