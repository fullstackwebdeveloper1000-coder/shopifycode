{%- liquid
  assign bg_alt = section.settings.bg_image.alt | default: section.settings.heading | escape
-%}

<section
  id="PwLandscapeFinal-{{ section.id }}"
  class="pw-landscape-final"
  style="
    --plf-accent: {{ section.settings.accent_color }};
    --plf-heading: {{ section.settings.heading_color }};
    --plf-body: {{ section.settings.body_color }};
    --plf-image-x: {{ section.settings.image_position_x }}%;
    --plf-image-y: {{ section.settings.image_position_y }}%;
  "
>
  <div class="pw-landscape-final__media" aria-hidden="true">
    {%- if section.settings.bg_image != blank -%}
      {{
        section.settings.bg_image
        | image_url: width: 3840
        | image_tag:
          class: 'pw-landscape-final__image',
          loading: 'lazy',
          widths: '900, 1200, 1600, 1920, 2560, 3200, 3840',
          sizes: '100vw',
          width: section.settings.bg_image.width,
          height: section.settings.bg_image.height,
          alt: bg_alt
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'pw-landscape-final__image pw-landscape-final__placeholder' }}
    {%- endif -%}
  </div>

  <div class="pw-landscape-final__fade" aria-hidden="true"></div>

  <div class="pw-landscape-final__container">
    <div class="pw-landscape-final__content">
      <span class="pw-landscape-final__divider" aria-hidden="true"></span>

      <div class="pw-landscape-final__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="pw-landscape-final__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="pw-landscape-final__body">
            {{ section.settings.body | escape | newline_to_br }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;500&display=swap');

  #PwLandscapeFinal-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwLandscapeFinal-{{ section.id }},
  #PwLandscapeFinal-{{ section.id }} *,
  #PwLandscapeFinal-{{ section.id }} *::before,
  #PwLandscapeFinal-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PwLandscapeFinal-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: none;
    height: auto;
    min-height: 0;
    aspect-ratio: 1441 / 500;
    margin: 0;
    overflow: hidden;
    background: #ffffff;
    isolation: isolate;
    font-family: Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__media {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    background: #ffffff;
  }

  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__image,
  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none !important;
    max-height: none !important;
    margin: 0;
    padding: 0;
    object-fit: cover;
    object-position: var(--plf-image-x) var(--plf-image-y);
    border: 0 !important;
    border-radius: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;

    /* Desktop: white left → image reveals to the right */
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      transparent 14%,
      rgba(0, 0, 0, 0.08) 21%,
      rgba(0, 0, 0, 0.22) 28%,
      rgba(0, 0, 0, 0.44) 35%,
      rgba(0, 0, 0, 0.68) 42%,
      rgba(0, 0, 0, 0.88) 49%,
      #000000 56%,
      #000000 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      transparent 14%,
      rgba(0, 0, 0, 0.08) 21%,
      rgba(0, 0, 0, 0.22) 28%,
      rgba(0, 0, 0, 0.44) 35%,
      rgba(0, 0, 0, 0.68) 42%,
      rgba(0, 0, 0, 0.88) 49%,
      #000000 56%,
      #000000 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__fade {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background: none;
  }

  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: var(--pw-max);
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
  }

  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__content {
    display: grid;
    grid-template-columns: 10px minmax(0, 620px);
    align-items: stretch;
    column-gap: 48px;
    width: min(100%, 678px);
    margin: 0;
    transform: translateY(-2px);
  }

  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__divider {
    display: block;
    width: 10px;
    height: 100%;
    min-height: 190px;
    background: var(--plf-accent);
  }

  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__copy {
    align-self: center;
    min-width: 0;
  }

  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__heading {
    margin: 0 0 28px;
    color: var(--plf-heading);
    font-family: Montserrat, system-ui, sans-serif;
    font-style: normal;
    font-weight: 800;
    font-size: clamp(38px, 3.125vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.7px;
    text-transform: none;
  }

  #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__body {
    max-width: 610px;
    margin: 0;
    color: var(--plf-body);
    font-family: Inter, system-ui, sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: clamp(17px, 1.25vw, 24px);
    line-height: 1.68;
    letter-spacing: 0;
  }

  /* iPad / small laptop */
  @media screen and (max-width: 1100px) {
    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__content {
      grid-template-columns: 8px minmax(0, 520px);
      column-gap: 34px;
      width: min(100%, 562px);
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__divider {
      width: 8px;
      min-height: 170px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__heading {
      margin-bottom: 20px;
      font-size: 42px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__body {
      max-width: 500px;
      font-size: 18px;
    }
  }

  /*
    Tablet + phones: STACK — full clear image on top, copy band below.
    No text over faces.
  */
  @media screen and (max-width: 860px) {
    #PwLandscapeFinal-{{ section.id }} {
      display: flex;
      flex-direction: column;
      min-height: 0;
      height: auto;
      aspect-ratio: auto;
      background: #ffffff;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__media {
      position: relative;
      z-index: 0;
      order: 1;
      inset: auto;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 4 / 3;
      flex: 0 0 auto;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__image,
    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__placeholder {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      -webkit-mask-image: none;
      mask-image: none;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__fade {
      display: none;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__container {
      position: relative;
      z-index: 2;
      order: 2;
      display: flex;
      align-items: flex-start;
      width: 100%;
      max-width: none;
      height: auto;
      min-height: 0;
      margin: 0;
      padding: 36px var(--pw-gutter) 40px;
      background: #ffffff;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__content {
      grid-template-columns: 7px minmax(0, 1fr);
      column-gap: 22px;
      width: 100%;
      max-width: 640px;
      transform: none;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__divider {
      width: 7px;
      min-height: 120px;
      align-self: stretch;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__heading {
      font-size: clamp(32px, 5.5vw, 40px);
      margin-bottom: 16px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__body {
      max-width: none;
      font-size: 17px;
      line-height: 1.6;
    }
  }

  @media screen and (max-width: 560px) {
    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__media {
      aspect-ratio: 5 / 4;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__image,
    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__placeholder {
      object-position: center 40%;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__container {
      padding: 28px 20px 32px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__content {
      grid-template-columns: 5px minmax(0, 1fr);
      column-gap: 16px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__divider {
      width: 5px;
      min-height: 100px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__heading {
      margin-bottom: 12px;
      font-size: clamp(28px, 8vw, 32px);
      letter-spacing: -0.4px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__body {
      font-size: 16px;
      line-height: 1.55;
    }
  }

  @media screen and (max-width: 380px) {
    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__media {
      aspect-ratio: 1 / 1;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__container {
      padding: 24px 16px 28px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__heading {
      font-size: 26px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__body {
      font-size: 15px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__divider {
      min-height: 90px;
    }
  }

  @media screen and (max-width: 320px) {
    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__container {
      padding: 20px 14px 24px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__heading {
      font-size: 24px;
    }

    #PwLandscapeFinal-{{ section.id }} .pw-landscape-final__body {
      font-size: 14px;
      line-height: 1.5;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Landscape Final",
  "tag": "section",
  "class": "pw-landscape-final-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Full landscape image"
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image vertical position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "That's Primal Win."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Built by people who wanted a product\nthat actually works, for people who hold\nthemselves to a higher standard."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Divider colour",
      "default": "#C89A3D"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#03170F"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body colour",
      "default": "#18221D"
    }
  ],
  "presets": [
    {
      "name": "Landscape Final"
    }
  ]
}
{% endschema %}
