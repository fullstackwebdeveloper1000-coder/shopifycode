        <h3>Vitamin B12</h3>
        <p>Supports energy levels, focus and the nervous system.</p>
        <a class="learn" href="{{ ing_page }}?ing=vitamin-b12">Learn More <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Primal home ingredients",
  "tag": "section",
  "class": "pw-home-ing-section",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Powered By Purpose"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients That Make A Difference"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Carefully selected. Purposefully dosed. Backed by science."
    },
    {
      "type": "header",
      "content": "Card images — upload manually"
    },
    {
      "type": "image_picker",
      "id": "image_magnesium",
      "label": "1. Magnesium image"
    },
    {
      "type": "image_picker",
      "id": "image_lions_mane",
      "label": "2. Lion's Mane image"
    },
    {
      "type": "image_picker",
      "id": "image_creatine",
      "label": "3. Creatine image"
    },
    {
      "type": "image_picker",
      "id": "image_ashwagandha",
      "label": "4. Ashwagandha image"
    },
    {
      "type": "image_picker",
      "id": "image_bioperine",
      "label": "5. Bioperine image"
    },
    {
      "type": "image_picker",
      "id": "image_b12",
      "label": "6. Vitamin B12 image"
    }
  ],
  "presets": [
    {
      "name": "Primal home ingredients"
    }
  ]
}
{% endschema %}
