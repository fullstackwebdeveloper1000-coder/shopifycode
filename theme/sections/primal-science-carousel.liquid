<section
  id="PwScienceCarousel-{{ section.id }}"
  class="pw-sci-car"
  data-pw-sci-carousel
>
  <div class="pw-container pw-sci-car__container">
    <div class="pw-sci-car__head">
      {%- if section.settings.heading != blank -%}
        <h2>
          <span class="pw-sci-car__rule" aria-hidden="true"></span>
          {{ section.settings.heading }}
          <span class="pw-sci-car__rule" aria-hidden="true"></span>
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="pw-sci-car__stage">
      <button class="pw-sci-car__arrow pw-sci-car__arrow--prev" type="button" aria-label="Previous slide" data-carousel-prev>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <button class="pw-sci-car__arrow pw-sci-car__arrow--next" type="button" aria-label="Next slide" data-carousel-next>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      </button>

      <div class="pw-sci-car__viewport" data-carousel-viewport>
        <div class="pw-sci-car__track" data-carousel-track>
          {%- assign slide_total = section.settings.slide_count | default: 3 -%}
          {%- for slide_index in (1..slide_total) -%}
            <div class="pw-sci-car__slide">
              {%- for block in section.blocks -%}
                {%- if block.settings.slide == slide_index -%}
                  <article class="pw-sci-car__tile" {{ block.shopify_attributes }}>
                    <div class="pw-sci-car__img">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 800
                          | image_tag:
                            alt: block.settings.title,
                            loading: 'lazy',
                            class: 'pw-sci-car__img-photo',
                            widths: '300, 400, 500, 600, 800',
                            sizes: '(min-width: 960px) 30vw, 100vw',
                            width: block.settings.image.width,
                            height: block.settings.image.height
                        }}
                      {%- elsif block.settings.image_fallback != blank -%}
                        <img
                          class="pw-sci-car__img-photo"
                          src="{{ block.settings.image_fallback }}"
                          alt="{{ block.settings.title | escape }}"
                          loading="lazy"
                          width="400"
                          height="500"
                        >
                      {%- endif -%}
                      {%- if block.settings.badge_multiplier != blank or block.settings.badge_line_1 != blank or block.settings.badge_line_2 != blank -%}
                        <span class="pw-sci-car__badge">
                          {%- if block.settings.badge_multiplier != blank -%}
                            <b>{{ block.settings.badge_multiplier }}</b>
                          {%- endif -%}
                          {{ block.settings.badge_line_1 }}
                          {%- if block.settings.badge_line_2 != blank -%}<br>{{ block.settings.badge_line_2 }}{%- endif -%}
                        </span>
                      {%- endif -%}
                    </div>
                    <div class="pw-sci-car__body">
                      <h4>
                        {{ block.settings.title }}
                        {%- if block.settings.title_suffix != blank -%}
                          <span>{{ block.settings.title_suffix }}</span>
                        {%- endif -%}
                      </h4>
                      {%- if block.settings.subtitle != blank -%}
                        <p class="pw-sci-car__sub">{{ block.settings.subtitle }}</p>
                      {%- endif -%}
                      {%- if block.settings.amount != blank -%}
                        <p class="pw-sci-car__amt">
                          {{ block.settings.amount }}{%- if block.settings.amount_unit != blank -%}<span>{{ block.settings.amount_unit }}</span>{%- endif -%}
                        </p>
                      {%- endif -%}
                      {%- if block.settings.brand_label != blank -%}
                        <p class="pw-sci-car__label">{{ block.settings.brand_label }}</p>
                      {%- endif -%}
                      {%- if block.settings.form != blank -%}
                        <p class="pw-sci-car__form">{{ block.settings.form }}</p>
                      {%- endif -%}
                      {%- if block.settings.why != blank -%}
                        <p class="pw-sci-car__why"><b>Why it matters:</b> {{ block.settings.why }}</p>
                      {%- endif -%}
                      <hr>
                      {%- if block.settings.typical_label != blank -%}
                        <p class="pw-sci-car__typ"><b>{{ block.settings.typical_label }}</b>{{ block.settings.typical_form }}</p>
                      {%- endif -%}
                      {%- if block.settings.typical_amount != blank -%}
                        <p class="pw-sci-car__typamt">
                          {{ block.settings.typical_amount }}
                          {%- if block.settings.typical_note != blank -%}<span>{{ block.settings.typical_note }}</span>{%- endif -%}
                        </p>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="pw-sci-car__foot">
        <div class="pw-sci-car__dots" data-carousel-dots></div>
        <span
          class="pw-sci-car__count"
          data-carousel-count
          data-counter-total="{{ section.settings.counter_total | default: 10 }}"
        >01 / {{ section.settings.counter_total | default: 10 | prepend: '0' | slice: -2, 2 }}</span>
      </div>

      {%- if section.settings.footnote != blank -%}
        <p class="pw-sci-car__note">{{ section.settings.footnote }}</p>
      {%- endif -%}
  </div>
</section>

{% style %}
  #PwScienceCarousel-{{ section.id }} {
    {% render 'pw-align-vars' %}
    --pw-car-side: max(
      var(--pw-gutter),
      calc((min(100vw, var(--pw-frame)) - var(--pw-content)) / 2)
    );
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: visible !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwScienceCarousel-{{ section.id }},
  #PwScienceCarousel-{{ section.id }} *,
  #PwScienceCarousel-{{ section.id }} *::before,
  #PwScienceCarousel-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PwScienceCarousel-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 56px 0 60px;
    background: #14171a;
    color: #fff;
    overflow: visible;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PwScienceCarousel-{{ section.id }} .pw-container.pw-sci-car__container {
    width: 100%;
    max-width: var(--pw-inner);
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__head {
    max-width: 820px;
    margin: 0 auto 34px;
    text-align: center;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__head h2 {
    margin: 0 0 12px;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    color: #fff;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__rule {
    display: inline-block;
    width: 40px;
    height: 2px;
    margin: 0 16px;
    background: #c89a3d;
    vertical-align: middle;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__head p {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: #c7cbce;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__stage {
    position: relative;
    width: 100%;
    max-width: var(--pw-content);
    margin-inline: auto;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__viewport {
    overflow: hidden;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__track {
    display: flex;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__slide {
    flex: 0 0 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__tile {
    display: flex;
    min-height: 320px;
    overflow: hidden;
    border-radius: 12px;
    background: #f7f5f1;
    color: #1f2326;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__img {
    position: relative;
    flex: 0 0 50%;
    min-height: 100%;
    overflow: hidden;
    background: linear-gradient(160deg, #3a4034, #171b16);
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__img-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__badge {
    position: absolute;
    left: 50%;
    bottom: 16px;
    z-index: 2;
    transform: translateX(-50%);
    display: flex;
    width: 92px;
    height: 92px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #c89a3d;
    color: #14171a;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 10px;
    line-height: 1.15;
    letter-spacing: 0.3px;
    text-align: center;
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.5);
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__badge b {
    font-size: 22px;
    font-weight: 800;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__body {
    flex: 1;
    padding: 18px 18px 16px;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__body h4 {
    margin: 0 0 2px;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 17px;
    text-transform: uppercase;
    color: #1f2326;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__body h4 span {
    font-weight: 600;
    font-size: 12px;
    color: #737a80;
    text-transform: none;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__sub,
  #PwScienceCarousel-{{ section.id }} .pw-sci-car__form,
  #PwScienceCarousel-{{ section.id }} .pw-sci-car__typ {
    margin: 0 0 2px;
    font-family: Inter, Arial, sans-serif;
    font-size: 12px;
    color: #737a80;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__sub {
    margin-bottom: 6px;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__amt {
    margin: 0 0 8px;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 34px;
    line-height: 1;
    color: #c89a3d;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__amt span {
    font-size: 16px;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__label {
    margin: 0;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #1f2326;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__form {
    margin-bottom: 12px;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__why {
    margin: 0 0 12px;
    font-family: Inter, Arial, sans-serif;
    font-size: 12px;
    line-height: 1.45;
    color: #1f2326;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__body hr {
    margin: 0 0 10px;
    border: 0;
    border-top: 1px solid rgba(31, 35, 38, 0.12);
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__typ b {
    display: block;
    margin-bottom: 2px;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 700;
    font-size: 10.5px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #1f2326;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__typamt {
    margin: 0;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: #1f2326;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__typamt span {
    display: block;
    font-family: Inter, Arial, sans-serif;
    font-weight: 400;
    font-size: 11px;
    color: #737a80;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1.5px solid #c89a3d;
    border-radius: 50%;
    background: transparent;
    color: #c89a3d;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__arrow:hover {
    background: rgba(0, 0, 0, 0.35);
    border-color: #d4ab4a;
    color: #d4ab4a;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__arrow--prev {
    left: calc(-1 * var(--pw-car-side));
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__arrow--next {
    right: calc(-1 * var(--pw-car-side));
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__dots {
    display: flex;
    gap: 8px;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__dots button {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    cursor: pointer;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__dots button.is-active {
    background: #c89a3d;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__count {
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.5px;
    color: #c89a3d;
  }

  #PwScienceCarousel-{{ section.id }} .pw-sci-car__note {
    margin: 16px 0 0;
    text-align: center;
    font-family: Inter, Arial, sans-serif;
    font-size: 12px;
    color: #737a80;
  }

  @media screen and (max-width: 960px) {
    #PwScienceCarousel-{{ section.id }} {
      --pw-car-side: var(--pw-gutter);
    }

    #PwScienceCarousel-{{ section.id }} .pw-sci-car__slide {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #PwScienceCarousel-{{ section.id }} .pw-sci-car__tile {
      min-height: 0;
    }

    #PwScienceCarousel-{{ section.id }} .pw-sci-car__arrow {
      width: 36px;
      height: 36px;
    }

    #PwScienceCarousel-{{ section.id }} .pw-sci-car__arrow svg {
      width: 16px;
      height: 16px;
    }

    #PwScienceCarousel-{{ section.id }} .pw-sci-car__arrow--prev { left: 0; }
    #PwScienceCarousel-{{ section.id }} .pw-sci-car__arrow--next { right: 0; }
  }

  @media screen and (max-width: 560px) {
    #PwScienceCarousel-{{ section.id }} .pw-sci-car__head h2 {
      font-size: 22px;
    }

    #PwScienceCarousel-{{ section.id }} .pw-sci-car__rule {
      display: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById('PwScienceCarousel-{{ section.id }}');
    if (!root || root.dataset.carouselReady === 'true') return;
    root.dataset.carouselReady = 'true';

    const track = root.querySelector('[data-carousel-track]');
    const dotsWrap = root.querySelector('[data-carousel-dots]');
    const countEl = root.querySelector('[data-carousel-count]');
    const viewport = root.querySelector('[data-carousel-viewport]');
    const slides = track ? track.children.length : 0;
    const counterTotal = parseInt(countEl?.dataset.counterTotal || String(slides), 10) || slides;
    if (!track || !slides) return;

    let index = 0;
    const pad = (n) => String(n).padStart(2, '0');

    for (let s = 0; s < slides; s += 1) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', `Go to slide ${s + 1}`);
      dot.addEventListener('click', () => go(s));
      dotsWrap.appendChild(dot);
    }

    const dots = [...dotsWrap.children];

    const render = () => {
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, n) => dot.classList.toggle('is-active', n === index));
      if (countEl) countEl.textContent = `${pad(index + 1)} / ${pad(counterTotal)}`;
    };

    const go = (n) => {
      index = (n + slides) % slides;
      render();
    };

    root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-carousel-next]')?.addEventListener('click', () => go(index + 1));

    let touchX = null;
    viewport?.addEventListener('touchstart', (e) => {
      touchX = e.touches[0].clientX;
    }, { passive: true });

    viewport?.addEventListener('touchend', (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
      touchX = null;
    });

    render();
    document.addEventListener('shopify:section:load', render);
  })();
</script>

{% schema %}
{
  "name": "PW Ing Carousel",
  "tag": "section",
  "class": "pw-section pw-science-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Superior Ingredients. Clinically Effective Doses. Real Results."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We use the most bioavailable forms at clinically effective doses that your body can absorb and use."
    },
    {
      "type": "range",
      "id": "slide_count",
      "label": "Slides",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "counter_total",
      "label": "Counter total",
      "info": "Design shows 03 / 10",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 10
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "*Compared to typical forms used in leading greens powders. Bioavailability may vary based on individual factors."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient card",
      "settings": [
        { "type": "range", "id": "slide", "label": "Slide", "min": 1, "max": 10, "step": 1, "default": 1 },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_fallback", "label": "Photo URL", "info": "Used until you upload a photo" },
        { "type": "text", "id": "badge_multiplier", "label": "Badge X", "default": "4X" },
        { "type": "text", "id": "badge_line_1", "label": "Badge line 1", "default": "MORE" },
        { "type": "text", "id": "badge_line_2", "label": "Badge line 2", "default": "ABSORBED*" },
        { "type": "text", "id": "title", "label": "Title", "default": "Magnesium" },
        { "type": "text", "id": "title_suffix", "label": "Title suffix" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Bioavailable Magnesium per serving" },
        { "type": "text", "id": "amount", "label": "Amount", "default": "200" },
        { "type": "text", "id": "amount_unit", "label": "Unit", "default": "mg" },
        { "type": "text", "id": "brand_label", "label": "Brand", "default": "Primal Win" },
        { "type": "text", "id": "form", "label": "Form", "default": "Magnesium Bisglycinate" },
        { "type": "textarea", "id": "why", "label": "Why it matters", "default": "Supports energy production, muscle function and reduces tiredness." },
        { "type": "text", "id": "typical_label", "label": "Typical label", "default": "Typical Greens Powders" },
        { "type": "text", "id": "typical_form", "label": "Typical form", "default": "Magnesium Oxide" },
        { "type": "text", "id": "typical_amount", "label": "Typical amount", "default": "500mg" },
        { "type": "text", "id": "typical_note", "label": "Typical note", "default": "Lower absorption and bioavailability." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PW Ing Carousel",
      "category": "Primal Win",
      "settings": {
        "slide_count": 3,
        "counter_total": 10
      },
      "blocks": [
