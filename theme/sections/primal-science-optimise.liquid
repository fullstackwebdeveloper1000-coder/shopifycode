<section id="PwScienceOptimise-{{ section.id }}" class="pw-sci-opt">
  <div class="pw-sci-opt__container">
    <div class="pw-sci-opt__card">
      <div class="pw-sci-opt__intro">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text_1 != blank -%}
          <p>{{ section.settings.text_1 }}</p>
        {%- endif -%}
        {%- if section.settings.text_2 != blank -%}
          <p><b>{{ section.settings.text_2 }}</b></p>
        {%- endif -%}
      </div>
      <div class="pw-sci-opt__cols">
        {%- for block in section.blocks -%}
          <div class="pw-sci-opt__col" {{ block.shopify_attributes }}>
            <span class="pw-sci-opt__icon" aria-hidden="true">
              {%- case forloop.index -%}
                {%- when 1 -%}<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="9" width="10" height="6" rx="3" transform="rotate(-30 8 12)"/><rect x="11" y="9" width="10" height="6" rx="3" transform="rotate(-30 16 12)"/></svg>
                {%- when 2 -%}<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="2.4"/><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><path d="M6.6 7.2 10 10.6M17.4 7.2 14 10.6M6.6 16.8 10 13.4M17.4 16.8 14 13.4"/></svg>
                {%- when 3 -%}<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M7 4h7a5 5 0 0 1 5 5v3a6 6 0 0 1-6 6H9a4 4 0 0 1-4-4V6a2 2 0 0 1 2-2Z" stroke-linejoin="round"/></svg>
                {%- when 4 -%}<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- else -%}<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 20V10M10 20V4M16 20v-7M4 20h16" stroke-linecap="round"/><path d="M4 12l5-4 4 3 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </span>
            {%- if block.settings.title != blank -%}<h4>{{ block.settings.title }}</h4>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  #PwScienceOptimise-{{ section.id }} { background: #efe5dd; padding: 56px 0; }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__container { max-width: 1180px; margin: 0 auto; padding: 0 48px; }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__card { display: grid; grid-template-columns: 1.1fr 2.6fr; gap: 30px; padding: 36px 30px; border-radius: 16px; background: #fff; box-shadow: 0 20px 50px -34px rgba(0,0,0,.35); }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__intro h2 { margin: 0 0 14px; font-family: Montserrat, Arial, sans-serif; font-weight: 800; font-size: 26px; line-height: 1.05; text-transform: uppercase; color: #1f2326; }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__intro h2 em, #PwScienceOptimise-{{ section.id }} .pw-sci-opt__intro h2 strong { color: #c89a3d; font-style: normal; }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__intro p { margin: 0 0 10px; font-family: Inter, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #737a80; }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__intro p b { color: #1f2326; }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__cols { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__icon { display: block; margin-bottom: 14px; color: #c89a3d; line-height: 0; }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__col h4 { margin: 0 0 8px; font-family: Montserrat, Arial, sans-serif; font-weight: 700; font-size: 12.5px; letter-spacing: 0.4px; text-transform: uppercase; line-height: 1.2; color: #1f2326; }
  #PwScienceOptimise-{{ section.id }} .pw-sci-opt__col p { margin: 0; font-family: Inter, Arial, sans-serif; font-size: 12.5px; line-height: 1.5; color: #737a80; }
  @media (max-width: 960px) {
    #PwScienceOptimise-{{ section.id }} .pw-sci-opt__container { padding: 0 34px; }
    #PwScienceOptimise-{{ section.id }} .pw-sci-opt__card { grid-template-columns: 1fr; gap: 24px; }
    #PwScienceOptimise-{{ section.id }} .pw-sci-opt__cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    #PwScienceOptimise-{{ section.id }} .pw-sci-opt__container { padding: 0 20px; }
    #PwScienceOptimise-{{ section.id }} .pw-sci-opt__cols { grid-template-columns: 1fr; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Science — Optimise",
  "tag": "section",
  "class": "pw-section",
  "max_blocks": 5,
  "settings": [
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>How We Optimise <strong>Bioavailability</strong></p>" },
    { "type": "textarea", "id": "text_1", "label": "Text line 1", "default": "It's not just the ingredients we use… it's how we use them." },
    { "type": "textarea", "id": "text_2", "label": "Text line 2 (bold)", "default": "Primal Win is formulated with evidence-backed forms and synergistic combinations to maximise absorption, utilisation and results." }
  ],
  "blocks": [
    { "type": "item", "name": "Column", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Superior Forms" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "We use the most bioavailable forms so your body can absorb and use more." }
    ]}
  ],
  "presets": [{
    "name": "Science — Optimise",
    "blocks": [
      { "type": "item", "settings": { "title": "Superior Forms", "text": "We use the most bioavailable forms so your body can absorb and use more." } },
      { "type": "item", "settings": { "title": "Synergistic Combinations", "text": "Nutrients are paired to enhance each other's absorption and biological function." } },
      { "type": "item", "settings": { "title": "Gentle & Effective", "text": "Our forms are chosen for high absorption and digestive comfort without the discomfort." } },
      { "type": "item", "settings": { "title": "Timed Release Nutrition", "text": "Sustained nutrient availability when your body needs it most." } },
      { "type": "item", "settings": { "title": "Real Results", "text": "We focus on outcomes that you can see, feel and measure." } }
    ]
  }]
}
{% endschema %}
