{% liquid
  assign pw_collection_heading_font = section.settings.pw_heading_font
  assign pw_collection_body_font = section.settings.pw_body_font
%}

{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% style %}
  {{ pw_collection_heading_font | font_face: font_display: 'swap' }}
  {{ pw_collection_body_font | font_face: font_display: 'swap' }}

  #PrimalCollection-{{ section.id }} {
    {% render 'pw-align-vars' %}
    --pw-content: 1280px;
    --pw-gutter: 48px;
    --pw-inner: 1376px;
    --pw-max: 1440px;
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip !important;
    background: var(--pcol-page) !important;
  }

  #PrimalCollection-{{ section.id }},
  #PrimalCollection-{{ section.id }} *,
  #PrimalCollection-{{ section.id }} *::before,
  #PrimalCollection-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PrimalCollection-{{ section.id }} {
    display: block;
    width: 100%;
    margin: 0;
    background: var(--pcol-page);
    color: var(--pcol-text);
    font-family: {{ pw_collection_body_font.family }}, {{ pw_collection_body_font.fallback_families }};
    font-style: {{ pw_collection_body_font.style }};
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PrimalCollection-{{ section.id }} > .section-{{ section.id }}-padding {
    background: var(--pcol-page) !important;
  }

  #PrimalCollection-{{ section.id }} .page-width,
  #PrimalCollection-{{ section.id }} .pw-container {
    width: 100%;
    max-width: var(--pw-inner);
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
  }

  /* ── Collection intro (brand header) ── */
  #PrimalCollection-{{ section.id }} .pcol-intro {
    padding-top: clamp(40px, 4.5vw, 68px);
    padding-bottom: clamp(22px, 3vw, 40px);
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__eyebrow {
    margin: 0 0 12px;
    color: var(--pcol-gold);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__rule {
    display: block;
    width: 56px;
    height: 3px;
    margin: 0 0 22px;
    background: var(--pcol-gold);
    border: 0;
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__row {
    display: flex;
    width: 100%;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--pcol-border);
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__copy {
    min-width: 0;
    max-width: 820px;
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__title {
    margin: 0;
    color: var(--pcol-heading);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-style: {{ pw_collection_heading_font.style }};
    font-size: clamp(36px, 4vw, 58px);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -1.6px;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__description {
    width: min(100%, 640px);
    margin-top: 16px;
    color: var(--pcol-text);
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.65;
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__description p {
    margin: 0;
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__count {
    display: flex;
    min-width: 112px;
    flex-direction: column;
    align-items: flex-end;
    padding: 14px 18px;
    border: 1px solid var(--pcol-border);
    border-radius: 12px;
    background: var(--pcol-card);
    box-shadow: 0 10px 28px rgba(31, 35, 38, 0.05);
    color: var(--pcol-muted);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    text-align: right;
    text-transform: uppercase;
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__count strong {
    color: var(--pcol-gold);
    font-size: 30px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.5px;
  }

  #PrimalCollection-{{ section.id }} .pcol-intro__count span {
    margin-top: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  /* ── Filters / sorting ── */
  #PrimalCollection-{{ section.id }} .facets-wrapper,
  #PrimalCollection-{{ section.id }} .facets-vertical-sort {
    margin-bottom: 28px;
  }

  #PrimalCollection-{{ section.id }} .facets-container,
  #PrimalCollection-{{ section.id }} .facets-vertical-form {
    border-color: var(--pcol-border);
  }

  #PrimalCollection-{{ section.id }} .facets__form,
  #PrimalCollection-{{ section.id }} .facets-vertical-form {
    color: var(--pcol-text);
  }

  #PrimalCollection-{{ section.id }} .facet-filters__label,
  #PrimalCollection-{{ section.id }} .facets__heading,
  #PrimalCollection-{{ section.id }} .product-count__text,
  #PrimalCollection-{{ section.id }} .mobile-facets__open-label {
    color: var(--pcol-heading);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  #PrimalCollection-{{ section.id }} .select__select,
  #PrimalCollection-{{ section.id }} .facet-filters__sort {
    min-height: 46px;
    padding-right: 40px;
    border: 1px solid var(--pcol-border);
    border-radius: 10px;
    background: var(--pcol-card);
    color: var(--pcol-heading);
    font-family: {{ pw_collection_body_font.family }}, {{ pw_collection_body_font.fallback_families }};
    box-shadow: 0 6px 16px rgba(31, 35, 38, 0.04);
  }

  #PrimalCollection-{{ section.id }} .facets__summary {
    color: var(--pcol-heading);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-weight: 700;
  }

  #PrimalCollection-{{ section.id }} .facets__summary:hover {
    color: var(--pcol-gold);
  }

  #PrimalCollection-{{ section.id }} .active-facets__button-inner {
    border-color: var(--pcol-border);
    border-radius: 999px;
    background: var(--pcol-card);
    color: var(--pcol-heading);
  }

  #PrimalCollection-{{ section.id }} .active-facets__button:hover .active-facets__button-inner {
    border-color: var(--pcol-gold);
    color: var(--pcol-gold);
  }

  /* ── Product grid — custom Primal cards (no Dawn overlay) ── */
  #PrimalCollection-{{ section.id }} .collection {
    padding-top: 0;
  }

  #PrimalCollection-{{ section.id }} #product-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 24px;
  }

  #PrimalCollection-{{ section.id }} #product-grid > .grid__item {
    width: 100%;
    max-width: none;
    min-width: 0;
  }

  #PrimalCollection-{{ section.id }} .pcol-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--pcol-border);
    border-radius: 16px;
    background: #ffffff;
    box-shadow:
      0 4px 10px rgba(20, 23, 26, 0.04),
      0 18px 40px rgba(20, 23, 26, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  #PrimalCollection-{{ section.id }} .pcol-card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 154, 61, 0.55);
    box-shadow:
      0 8px 18px rgba(20, 23, 26, 0.06),
      0 28px 56px rgba(20, 23, 26, 0.12);
  }

  #PrimalCollection-{{ section.id }} .pcol-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(160deg, #ebe6dc 0%, #ddd5c8 100%);
    text-decoration: none;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 12%;
    transition: transform 0.3s ease;
  }

  #PrimalCollection-{{ section.id }} .pcol-card:hover .pcol-card__media img {
    transform: scale(1.04);
  }

  #PrimalCollection-{{ section.id }} .pcol-card__badge {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--pcol-gold);
    color: #14171a;
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.7px;
    text-transform: uppercase;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 10px;
    padding: 20px 18px 18px;
    background: #ffffff;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__vendor {
    margin: 0;
    color: var(--pcol-gold);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__title {
    margin: 0;
    color: var(--pcol-heading);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-size: clamp(15px, 1.15vw, 18px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.2px;
    text-transform: uppercase;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__title a:hover {
    color: var(--pcol-gold);
  }

  #PrimalCollection-{{ section.id }} .pcol-card__price {
    margin: 2px 0 0;
    color: var(--pcol-heading);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-size: clamp(18px, 1.35vw, 22px);
    font-weight: 900;
    line-height: 1.15;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__price s {
    margin-right: 8px;
    color: var(--pcol-muted);
    font-size: 13px;
    font-weight: 500;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__price .sale {
    color: var(--pcol-gold);
  }

  #PrimalCollection-{{ section.id }} .pcol-card__actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 46px;
    padding: 12px 14px;
    border-radius: 10px;
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.65px;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease, filter 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__btn--primary {
    border: 0;
    background: var(--pcol-gold);
    color: #14171a;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__btn--primary:hover {
    filter: brightness(0.96);
  }

  #PrimalCollection-{{ section.id }} .pcol-card__btn--outline {
    border: 1.6px solid var(--pcol-gold);
    background: #ffffff;
    color: var(--pcol-gold);
  }

  #PrimalCollection-{{ section.id }} .pcol-card__btn--outline:hover {
    background: var(--pcol-gold);
    color: #14171a;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__btn:disabled,
  #PrimalCollection-{{ section.id }} .pcol-card__btn.is-loading {
    opacity: 0.65;
    cursor: wait;
  }

  #PrimalCollection-{{ section.id }} .pcol-card__form {
    margin: 0;
  }

  /* Empty state */
  #PrimalCollection-{{ section.id }} .collection--empty .title {
    color: var(--pcol-heading);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-weight: 800;
    text-transform: uppercase;
  }

  #PrimalCollection-{{ section.id }} .collection--empty .underlined-link {
    color: var(--pcol-gold);
  }

  /* Pagination */
  #PrimalCollection-{{ section.id }} .pagination-wrapper {
    margin-top: clamp(40px, 5vw, 68px);
  }

  #PrimalCollection-{{ section.id }} .pagination__item {
    border-radius: 10px;
    color: var(--pcol-heading);
    font-family: {{ pw_collection_heading_font.family }}, {{ pw_collection_heading_font.fallback_families }};
    font-weight: 700;
  }

  #PrimalCollection-{{ section.id }} .pagination__item--current {
    background: var(--pcol-gold);
    color: #14171a;
  }

  @media screen and (max-width: 1180px) {
    #PrimalCollection-{{ section.id }} {
      --pw-gutter: 34px;
    }
  }

  @media screen and (min-width: 1024px) and (max-width: 1199px) {
    #PrimalCollection-{{ section.id }} #product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 600px) and (max-width: 1023px) {
    #PrimalCollection-{{ section.id }} {
      --pw-gutter: 28px;
    }

    #PrimalCollection-{{ section.id }} .pcol-intro__row {
      align-items: flex-start;
    }

    #PrimalCollection-{{ section.id }} #product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    #PrimalCollection-{{ section.id }} .pcol-card__body {
      padding: 16px;
    }
  }

  @media screen and (max-width: 599px) {
    #PrimalCollection-{{ section.id }} {
      --pw-gutter: 20px;
    }

    #PrimalCollection-{{ section.id }} .pcol-intro {
      padding-top: 32px;
      padding-bottom: 22px;
    }

    #PrimalCollection-{{ section.id }} .pcol-intro__row {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    #PrimalCollection-{{ section.id }} .pcol-intro__title {
      font-size: clamp(32px, 10vw, 42px);
      letter-spacing: -1.1px;
    }

    #PrimalCollection-{{ section.id }} .pcol-intro__count {
      min-width: 0;
      align-items: flex-start;
      text-align: left;
    }

    #PrimalCollection-{{ section.id }} #product-grid {
      grid-template-columns: 1fr;
      gap: 16px;
      max-width: 420px;
      margin-inline: auto;
    }

    #PrimalCollection-{{ section.id }} .pcol-card {
      border-radius: 14px;
    }

    #PrimalCollection-{{ section.id }} .pcol-card__media {
      aspect-ratio: 4 / 3;
    }

    #PrimalCollection-{{ section.id }} .pcol-card__body {
      padding: 16px 14px 14px;
    }

    #PrimalCollection-{{ section.id }} .pcol-card__title {
      font-size: 15px;
    }

    #PrimalCollection-{{ section.id }} .pcol-card__price {
      font-size: 18px;
    }

    #PrimalCollection-{{ section.id }} .pcol-card__btn {
      min-height: 44px;
      font-size: 11px;
    }
  }

  @media screen and (max-width: 359px) {
    #PrimalCollection-{{ section.id }} {
      --pw-gutter: 16px;
    }

    #PrimalCollection-{{ section.id }} #product-grid {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #PrimalCollection-{{ section.id }} *,
    #PrimalCollection-{{ section.id }} *::before,
    #PrimalCollection-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
    }
  }
{% endstyle %}

<collection-component
  id="PrimalCollection-{{ section.id }}"
  class="primal-collection"
  style="
    --pcol-page: {{ section.settings.pw_page_bg }};
    --pcol-card: {{ section.settings.pw_card_bg }};
    --pcol-heading: {{ section.settings.pw_heading_color }};
    --pcol-text: {{ section.settings.pw_text_color }};
    --pcol-muted: {{ section.settings.pw_muted_color }};
    --pcol-gold: {{ section.settings.pw_gold }};
    --pcol-border: {{ section.settings.pw_border }};
    --pcol-media: {{ section.settings.pw_media_bg }};
  "
  {% if collection %}
    view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
    data-collection-id="{{ collection.id }}"
  {% endif %}
>
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {% if section.settings.pw_show_intro %}
        <div class="pcol-intro page-width">
          {% if section.settings.pw_eyebrow != blank %}
            <p class="pcol-intro__eyebrow">{{ section.settings.pw_eyebrow | escape }}</p>
          {% endif %}
          <span class="pcol-intro__rule" aria-hidden="true"></span>

          <div class="pcol-intro__row">
            <div class="pcol-intro__copy">
              <h1 class="pcol-intro__title">{{ collection.title | escape }}</h1>

              {% if section.settings.pw_show_description and collection.description != blank %}
                <div class="pcol-intro__description rte">
                  {{ collection.description }}
                </div>
              {% endif %}
            </div>

            <div class="pcol-intro__count">
              <strong>{{ collection.products_count }}</strong>
              <span>{{ section.settings.pw_product_count_label | escape }}</span>
            </div>
          </div>
        </div>
      {% endif %}

      {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
        <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <h2 class="facet-filters__label caption-large text-body">
                  <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </h2>
                <div class="select">
                  {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in collection.sort_options -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </div>
              </div>
            </div>

            <div class="product-count-vertical light" role="status">
              <h2 class="product-count__text text-body">
                <span id="ProductCountDesktop">
                  {%- if collection.results_count -%}
                    {{
                      'templates.search.results_with_count'
                      | t: terms: collection.terms, count: collection.results_count
                    }}
                  {%- elsif collection.products_count == collection.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: collection.products_count, count: collection.all_products_count
                    }}
                  {%- endif -%}
                </span>
              </h2>
              {%- render 'loading-spinner' -%}
            </div>
          </form>
        </facet-filters-form>
      {%- endif -%}

      <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
        {{ 'component-facets.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            aria-labelledby="verticalTitle"
            class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
            id="main-collection-filters"
            data-id="{{ section.id }}"
          >
            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: section.settings.filter_type,
              paginate: paginate
            %}
          </aside>
        {%- endif -%}

        <div
          class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          id="ProductGridContainer"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if collection.products.size == 0 -%}
            <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: collection.url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}">
              <div class="loading-overlay gradient"></div>
              <ul
                id="product-grid"
                data-id="{{ section.id }}"
                class="product-grid pcol-grid"
              >
                {%- for product in collection.products -%}
                  {%- liquid
                    assign variant = product.selected_or_first_available_variant
                    if forloop.index > 2
                      assign img_loading = 'lazy'
                    else
                      assign img_loading = 'eager'
                    endif
                  -%}
                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <article class="pcol-card">
                      <a class="pcol-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                        {%- if product.featured_media != blank -%}
                          {{
                            product.featured_media
                            | image_url: width: 900
                            | image_tag:
                              loading: img_loading,
                              widths: '280, 360, 480, 640, 900',
                              sizes: '(min-width: 1024px) 25vw, (min-width: 600px) 45vw, 90vw',
                              alt: product.featured_media.alt | default: product.title
                          }}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag }}
                        {%- endif -%}

                        {%- unless product.available -%}
                          <span class="pcol-card__badge">Sold out</span>
                        {%- elsif product.compare_at_price > product.price -%}
                          <span class="pcol-card__badge">Sale</span>
                        {%- endif -%}
                      </a>

                      <div class="pcol-card__body">
                        {%- if section.settings.show_vendor and product.vendor != blank -%}
                          <p class="pcol-card__vendor">{{ product.vendor | escape }}</p>
                        {%- endif -%}

                        <h3 class="pcol-card__title">
                          <a href="{{ product.url }}">{{ product.title | escape }}</a>
                        </h3>

                        <p class="pcol-card__price">
                          {%- if product.compare_at_price > product.price -%}
                            <s>{{ product.compare_at_price | money }}</s>
                            <span class="sale">{{ product.price | money }}</span>
                          {%- else -%}
                            {{ product.price | money }}
                          {%- endif -%}
                        </p>

                        <div class="pcol-card__actions">
                          {%- if product.available and variant != blank and product.has_only_default_variant -%}
                            <form class="pcol-card__form" action="{{ routes.cart_add_url }}" method="post" data-pcol-cart-form>
                              <input type="hidden" name="id" value="{{ variant.id }}">
                              <input type="hidden" name="quantity" value="1">
                              <button type="submit" class="pcol-card__btn pcol-card__btn--primary" name="add">
                                Add to cart
                              </button>
                            </form>
                          {%- elsif product.available -%}
                            <a class="pcol-card__btn pcol-card__btn--primary" href="{{ product.url }}">
                              Choose options
                            </a>
                          {%- else -%}
                            <button type="button" class="pcol-card__btn pcol-card__btn--outline" disabled>
                              Sold out
                            </button>
                          {%- endif -%}

                          <a class="pcol-card__btn pcol-card__btn--outline" href="{{ product.url }}">
                            View product
                          </a>
                        </div>
                      </div>
                    </article>
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</collection-component>

<script>
  (function () {
    var root = document.getElementById('PrimalCollection-{{ section.id }}');
    if (!root) return;

    function cartRoot() {
      return (window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/');
    }

    function updateCartCount(count) {
      document.querySelectorAll('.peh__cart-count, [data-cart-count], .cart-count-bubble, .cart-count').forEach(function (el) {
        el.textContent = String(count);
        el.style.display = count > 0 ? '' : 'none';
      });
    }

    root.querySelectorAll('[data-pcol-cart-form]').forEach(function (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var button = form.querySelector('button[type="submit"]');
        if (!button || button.classList.contains('is-loading')) return;

        var original = button.textContent;
        button.classList.add('is-loading');
        button.textContent = 'Adding...';

        var idInput = form.querySelector('input[name="id"]');
        fetch(cartRoot() + 'cart/add.js', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: Number(idInput.value), quantity: 1 })
        })
          .then(function (res) {
            return res.json().then(function (data) {
              if (!res.ok) throw data;
              return data;
            });
          })
          .then(function () {
            return fetch(cartRoot() + 'cart.js').then(function (r) { return r.json(); });
          })
          .then(function (cart) {
            updateCartCount(cart.item_count || 0);
            button.textContent = 'Added';
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
            var drawer = document.querySelector('cart-drawer');
            if (drawer && typeof drawer.open === 'function') drawer.open();
            setTimeout(function () {
              button.textContent = original;
              button.classList.remove('is-loading');
            }, 1200);
          })
          .catch(function () {
            button.textContent = original;
            button.classList.remove('is-loading');
            form.submit();
          });
      });
    });
  })();
</script>

