{% comment %}
  PRIMAL WIN HERO — Figma Holding page (1440×730) + holding.html type scale.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&family=Montserrat:wght@700;800;900&display=swap"
  rel="stylesheet"
>

{% liquid
  assign hero_alt = section.settings.hero_image.alt | default: section.settings.hero_image_alt
  assign logo_alt = section.settings.logo_image.alt | default: section.settings.brand_name
  assign mockup_height = section.settings.mockup_height_percent | default: 100
%}

<section
  id="PrimalWinHero-{{ section.id }}"
  class="primal-win-hero"
  style="
    --pw-background: {{ section.settings.hero_background_v2 }};
    --pw-text: {{ section.settings.hero_text_v2 }};
    --pw-gold: {{ section.settings.hero_gold_v2 }};
    --pw-gold-highlight: {{ section.settings.hero_gold_highlight_v3 }};
    --pw-mockup-height: {{ mockup_height }}%;
  "
>
  <div class="primal-win-hero__stage">
    <div class="primal-win-hero__canvas">
    <div
      class="primal-win-hero__logo"
      aria-label="{{ section.settings.brand_name | escape }}"
    >
      {% if section.settings.logo_image != blank %}
        {{
          section.settings.logo_image
          | image_url: width: 650
          | image_tag:
            class: 'primal-win-hero__logo-image',
            widths: '260, 325, 488, 650',
            sizes: '(min-width: 990px) min(22.57vw, 325px), (min-width: 768px) 285px, min(84vw, 325px)',
            loading: 'eager',
            fetchpriority: 'high',
            alt: logo_alt
        }}
      {% else %}
        <span class="primal-win-hero__logo-mark" aria-hidden="true">P</span>

        <span class="primal-win-hero__logo-copy">
          <strong>{{ section.settings.brand_name | escape }}</strong>
          <small>{{ section.settings.brand_tagline | escape }}</small>
        </span>
      {% endif %}
    </div>

    <div class="primal-win-hero__copy">
      <h1 class="primal-win-hero__heading">
        <span class="primal-win-hero__primary">
          <span>{{ section.settings.heading_line_1 | escape }}</span>
          <span>{{ section.settings.heading_line_2 | escape }}</span>
          <span>{{ section.settings.heading_line_3 | escape }}</span>
        </span>

        <span class="primal-win-hero__built">
          {{ section.settings.heading_accent | escape }}
        </span>

        <span class="primal-win-hero__for-those">
          {{ section.settings.heading_line_4 | escape }}
        </span>

        <span class="primal-win-hero__win-line">
          {{ section.settings.heading_line_5 | escape -}}<em>.</em>
        </span>
      </h1>

      <span class="primal-win-hero__separator" aria-hidden="true"></span>

      <div class="primal-win-hero__details">
        {% if section.settings.detail_1 != blank %}
          <p>{{ section.settings.detail_1 | escape }}</p>
        {% endif %}

        {% if section.settings.detail_2 != blank %}
          <p>{{ section.settings.detail_2 | escape }}</p>
        {% endif %}

        {% if section.settings.detail_3 != blank %}
          <p>{{ section.settings.detail_3 | escape }}</p>
        {% endif %}

        {% if section.settings.detail_4 != blank %}
          <p class="primal-win-hero__launch">
            {{ section.settings.detail_4 | escape }}
          </p>
        {% endif %}
      </div>
    </div>
  </div>

    <div class="primal-win-hero__visual" aria-hidden="{% if section.settings.hero_image == blank %}true{% else %}false{% endif %}">
      {% if section.settings.hero_image != blank %}
        <div class="primal-win-hero__image-frame">
          {{
            section.settings.hero_image
            | image_url: width: 2400
            | image_tag:
              class: 'primal-win-hero__image',
              widths: '480, 600, 900, 1200, 1800, 2400',
              sizes: '(min-width: 1440px) 680px, (min-width: 990px) 46vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_alt
          }}
        </div>
      {% else %}
        <div class="primal-win-hero__empty-image">
          <span>Select product visual</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .password-main #PrimalWinHero-{{ section.id }} .primal-win-hero__visual,
  .password-main #PrimalWinHero-{{ section.id }} .primal-win-hero__image-frame {
    filter: none !important;
    -webkit-filter: none !important;
    mask: none !important;
    -webkit-mask: none !important;
  }

  #PrimalWinHero-{{ section.id }},
  #PrimalWinHero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #PrimalWinHero-{{ section.id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    overflow: clip;
    background: var(--pw-background);
    color: var(--pw-text);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__stage {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    background: var(--pw-background);
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__canvas {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    height: 730px;
    height: min(50.694444vw, 730px);
    margin: 0 auto;
    padding: 0;
    overflow: visible;
    background: transparent;
    pointer-events: none;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__canvas > * {
    pointer-events: auto;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__logo {
    position: absolute;
    z-index: 5;
    top: 34px;
    top: min(2.361111vw, 34px);
    left: 105px;
    left: min(7.291667vw, 105px);
    display: flex;
    align-items: center;
    width: 325px;
    width: min(22.569444vw, 325px);
    height: 75px;
    height: min(5.208333vw, 75px);
    margin: 0;
    padding: 0;
    mix-blend-mode: multiply;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-image {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: contain;
    object-position: left center;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-mark {
    display: grid;
    flex: 0 0 min(3.263889vw, 47px);
    width: 47px;
    width: min(3.263889vw, 47px);
    height: 47px;
    height: min(3.263889vw, 47px);
    place-items: center;
    color: var(--pw-gold);
    font-family: Montserrat, Arial, sans-serif;
    font-size: 38px;
    font-size: min(2.638889vw, 38px);
    font-style: italic;
    font-weight: 700;
    line-height: 1;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-copy {
    display: flex;
    margin-left: 22px;
    margin-left: min(1.527778vw, 22px);
    flex-direction: column;
    align-items: center;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-copy strong {
    display: block;
    margin: 0;
    color: #000000;
    font-family: Montserrat, Arial, sans-serif;
    font-size: 31px;
    font-size: min(2.152778vw, 31px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 3px;
    letter-spacing: min(0.208333vw, 3px);
    white-space: nowrap;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-copy small {
    display: block;
    margin-top: 3px;
    color: var(--pw-gold);
    font-family: Inter, Arial, sans-serif;
    font-size: 14px;
    font-size: min(0.972222vw, 14px);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__copy {
    position: absolute;
    z-index: 4;
    top: 128px;
    top: min(8.888889vw, 128px);
    left: 105px;
    left: min(7.291667vw, 105px);
    width: 640px;
    width: min(44.444444vw, 640px);
    max-width: 55%;
    margin: 0;
    padding: 8px 0 0;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__heading {
    display: block;
    margin: 7px 0 0;
    margin-top: min(0.486111vw, 7px);
    padding: 0;
    color: var(--pw-text);
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.5px;
    text-transform: uppercase;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__heading > span,
  #PrimalWinHero-{{ section.id }} .primal-win-hero__primary > span {
    display: block;
    margin: 0;
    padding: 0;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__primary {
    display: block;
    margin: 0;
    padding: 0;
    font-size: 88px;
    font-size: min(6.111111vw, 88px);
    font-weight: 800;
    line-height: 0.92;
    white-space: nowrap;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__built {
    display: block;
    margin: 6px 0;
    margin-top: min(0.416667vw, 6px);
    margin-bottom: min(0.416667vw, 6px);
    padding: 0;
    color: var(--pw-gold);
    font-size: 138px;
    font-size: min(9.583333vw, 138px);
    font-weight: 900;
    line-height: 0.9;
    white-space: nowrap;
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__built {
      background-image: linear-gradient(
        180deg,
        #C89A3D 14.97%,
        #B6832B 57.48%,
        #A36C19 100%
      );
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__for-those {
    display: block;
    margin: 0;
    padding: 0;
    font-size: 74px;
    font-size: min(5.138889vw, 74px);
    font-weight: 800;
    line-height: 0.92;
    white-space: nowrap;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line {
    display: block;
    margin: 0;
    padding: 0;
    font-size: 54px;
    font-size: min(3.75vw, 54px);
    font-weight: 800;
    line-height: 0.92;
    white-space: nowrap;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line em {
    color: var(--pw-gold);
    font-style: normal;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__separator {
    display: block;
    width: 64px;
    width: min(4.444444vw, 64px);
    height: 3px;
    height: max(2px, min(0.208333vw, 3px));
    margin-top: 38px;
    margin-top: min(2.638889vw, 38px);
    margin-bottom: 30px;
    margin-bottom: min(2.083333vw, 30px);
    background: var(--pw-gold);
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__details {
    display: block;
    margin-top: 0;
    padding: 0;
    color: var(--pw-text);
    font-family: Inter, Arial, sans-serif;
    font-size: 23px;
    font-size: min(1.597222vw, 23px);
    font-weight: 600;
    line-height: 1.75;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__details p {
    display: block;
    margin: 0;
    padding: 0;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__launch {
    color: #C89A3D;
    font-weight: 600;
  }

  /* Figma / holding.html — hero-shot-box */
  @media screen and (min-width: 990px) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__stage {
      height: min(50.694444vw, 730px);
      overflow: hidden;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__visual {
      position: absolute;
      z-index: 1;
      top: 34px;
      top: min(2.361111vw, 34px);
      right: calc(-1 * max(0px, (100vw - 1440px) / 2));
      bottom: 0;
      left: 0;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: transparent;
      filter: none !important;
      -webkit-filter: none !important;
      pointer-events: none;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__image-frame {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 48%;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0;
      overflow: visible;
      background: transparent;
      display: block;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__image {
      position: absolute;
      top: 0;
      right: 0;
      display: block;
      width: auto;
      height: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      object-fit: contain;
      object-position: right top;
    }
  }

  @media screen and (max-width: 989px) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__stage {
      min-height: min(50.694444vw, 730px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__visual {
      position: relative;
      z-index: 1;
      width: 100%;
      min-height: clamp(280px, 55vw, 520px);
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: var(--pw-background);
      filter: none !important;
    }
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__image-frame,
  #PrimalWinHero-{{ section.id }} .primal-win-hero__empty-image {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: var(--pw-background);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    filter: none !important;
    -webkit-filter: none !important;
    mask: none !important;
    -webkit-mask: none !important;
    box-shadow: none !important;
    border: 0;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__image {
    display: block;
    flex: 0 0 auto;
    width: auto;
    height: var(--pw-mockup-height, 100%);
    max-width: none;
    margin: 0;
    padding: 0;
    object-fit: contain;
    object-position: right bottom;
    filter: none !important;
    -webkit-filter: none !important;
    mask: none !important;
    -webkit-mask: none !important;
    mix-blend-mode: normal;
    opacity: 1;
    box-shadow: none;
    transform: none;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__image-frame {
    isolation: auto;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__visual::before,
  #PrimalWinHero-{{ section.id }} .primal-win-hero__visual::after,
  #PrimalWinHero-{{ section.id }} .primal-win-hero__image-frame::before,
  #PrimalWinHero-{{ section.id }} .primal-win-hero__image-frame::after {
    content: none !important;
    display: none !important;
    background: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    mask-image: none !important;
    -webkit-mask-image: none !important;
    box-shadow: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__empty-image {
    display: grid;
    place-items: center;
    border: 1px dashed rgba(31, 35, 38, 0.2);
    color: rgba(31, 35, 38, 0.5);
    font-family: Inter, Arial, sans-serif;
    font-size: 14px;
  }

  @media screen and (min-width: 768px) and (max-width: 989px) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__stage {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      grid-template-rows: auto 1fr;
      column-gap: clamp(16px, 2.4vw, 28px);
      width: 100%;
      height: auto;
      min-height: 620px;
      padding: 24px clamp(24px, 4vw, 44px) 0;
      overflow: hidden;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__canvas {
      display: contents;
      height: auto;
      pointer-events: none;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo,
    #PrimalWinHero-{{ section.id }} .primal-win-hero__copy,
    #PrimalWinHero-{{ section.id }} .primal-win-hero__visual {
      position: relative;
      inset: auto;
      pointer-events: auto;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo {
      grid-column: 1 / -1;
      grid-row: 1;
      width: 285px;
      height: 66px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-mark {
      flex-basis: 42px;
      width: 42px;
      height: 42px;
      font-size: 34px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-copy {
      margin-left: 16px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-copy strong {
      font-size: 27px;
      letter-spacing: 2.3px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-copy small {
      font-size: 11px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__copy {
      z-index: 4;
      grid-column: 1;
      grid-row: 2;
      align-self: start;
      width: 100%;
      margin-top: 24px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__heading {
      margin-top: 0;
      letter-spacing: -0.35px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__primary {
      font-size: clamp(40px, 5.35vw, 53px);
      line-height: 0.94;
      white-space: nowrap;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__built {
      font-size: clamp(64px, 8.3vw, 82px);
      line-height: 0.91;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__for-those {
      margin-top: 4px;
      font-size: clamp(33px, 4.55vw, 45px);
      line-height: 0.95;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line {
      margin-top: 4px;
      font-size: clamp(23px, 3.15vw, 31px);
      line-height: 1;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__separator {
      width: 52px;
      height: 3px;
      margin-top: 22px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__details {
      margin-top: 17px;
      font-size: clamp(14px, 1.75vw, 17px);
      line-height: 1.5;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__visual {
      z-index: 1;
      grid-column: 2;
      grid-row: 2;
      align-self: end;
      left: auto;
      width: 100%;
      min-height: clamp(320px, 52vw, 480px);
      height: auto;
      margin: 8px 0 0 0;
      overflow: hidden;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__image-frame,
    #PrimalWinHero-{{ section.id }} .primal-win-hero__empty-image {
      position: absolute;
      inset: 0;
      width: 100%;
      min-height: clamp(320px, 52vw, 480px);
      background-position: center bottom;
      background-size: auto var(--pw-mockup-height, 100%);
    }
  }

  /* Phone stack — holding.html: content first, product below centred */
  @media screen and (max-width: 767px) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__stage {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__canvas {
      --pw-mobile-pad: clamp(16px, 5vw, 30px);
      display: flex;
      order: 1;
      width: 100%;
      max-width: none;
      height: auto;
      min-height: 0;
      margin: 0;
      padding: 20px var(--pw-mobile-pad) 8px;
      flex-direction: column;
      overflow: visible;
      pointer-events: auto;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__visual {
      order: 2;
      position: relative;
      z-index: 1;
      width: 100%;
      min-height: 0;
      height: auto;
      margin: 8px 0 0;
      padding: 0 var(--pw-mobile-pad, 16px) 12px;
      overflow: visible;
      background: var(--pw-background);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo,
    #PrimalWinHero-{{ section.id }} .primal-win-hero__copy {
      position: relative;
      inset: auto;
      left: auto;
      top: auto;
      max-width: none;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo {
      z-index: 4;
      width: min(325px, 84vw);
      height: clamp(58px, 18vw, 70px);
      mix-blend-mode: multiply;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-mark {
      flex: 0 0 42px;
      width: 42px;
      height: 42px;
      font-size: 34px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-copy {
      margin-left: 14px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-copy strong {
      font-size: clamp(21px, 7vw, 28px);
      letter-spacing: clamp(1.5px, 0.55vw, 2px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-copy small {
      font-size: clamp(9px, 2.8vw, 12px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__copy {
      z-index: 4;
      width: 100%;
      margin-top: clamp(18px, 4.5vw, 26px);
      padding: 0;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__heading {
      margin-top: 0;
      letter-spacing: -0.35px;
    }

    /* holding.html @960 type scale */
    #PrimalWinHero-{{ section.id }} .primal-win-hero__primary {
      font-size: clamp(42px, 11vw, 64px);
      line-height: 0.94;
      white-space: normal;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__built {
      font-size: clamp(58px, 16vw, 96px);
      line-height: 0.91;
      white-space: normal;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__for-those {
      margin-top: 4px;
      font-size: clamp(34px, 9vw, 52px);
      line-height: 0.95;
      white-space: normal;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line {
      margin-top: 4px;
      font-size: clamp(24px, 7vw, 38px);
      line-height: 1;
      white-space: normal;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__separator {
      width: 54px;
      height: 3px;
      margin-top: 22px;
      margin-bottom: 18px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__details {
      margin-top: 0;
      font-size: clamp(16px, 4.2vw, 20px);
      line-height: 1.65;
    }

    /* Product centred below copy — soft edges come from the PNG itself */
    #PrimalWinHero-{{ section.id }} .primal-win-hero__image-frame,
    #PrimalWinHero-{{ section.id }} .primal-win-hero__empty-image {
      position: relative;
      inset: auto;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      width: 100%;
      height: auto;
      min-height: 0;
      margin: 0 auto;
      padding: 0;
      overflow: visible;
      background: transparent;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__image {
      position: relative;
      top: auto;
      right: auto;
      bottom: auto;
      left: auto;
      display: block;
      width: auto;
      max-width: min(460px, 100%);
      height: auto;
      margin: 0 auto;
      object-fit: contain;
      object-position: center bottom;
    }
  }

  /* holding.html phone @560 */
  @media screen and (max-width: 560px) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__canvas {
      --pw-mobile-pad: 16px;
      padding-top: 16px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo {
      width: min(280px, 78vw);
      height: 58px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__primary {
      font-size: clamp(40px, 12.2vw, 46px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__built {
      font-size: clamp(56px, 17.5vw, 66px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__for-those {
      font-size: clamp(32px, 10vw, 38px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line {
      font-size: clamp(24px, 7.4vw, 28px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__details {
      font-size: 17px;
      line-height: 1.55;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__separator {
      margin-top: 20px;
      margin-bottom: 16px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__image {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 380px) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__canvas {
      --pw-mobile-pad: 14px;
      padding-top: 14px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__logo {
      width: min(260px, 86vw);
      height: 52px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__copy {
      margin-top: 16px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__primary {
      font-size: 36px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__built {
      font-size: 52px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__for-those {
      font-size: 28px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line {
      font-size: 22px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__details {
      font-size: 15px;
    }
  }

  @media screen and (max-width: 320px) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__canvas {
      --pw-mobile-pad: 12px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__primary {
      font-size: 30px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__built {
      font-size: 44px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__for-those {
      font-size: 24px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line {
      font-size: 18px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__details {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #PrimalWinHero-{{ section.id }} *,
    #PrimalWinHero-{{ section.id }} *::before,
    #PrimalWinHero-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
{% endstyle %}

