      z-index: 1;
      width: calc(100% + 36px);
      max-width: none;
      height: auto;
      min-height: 0;
      margin: 12px -18px 0;
      isolation: isolate;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__visual::before {
      top: 0;
      right: 0;
      bottom: auto;
      left: auto;
      width: 27.109%;
      height: 100%;
      background: linear-gradient(
        90deg,
        rgba(239, 229, 222, 0) 0%,
        #EFE5DE 90.89%
      );
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__visual::after {
      top: auto;
      right: auto;
      bottom: 0;
      left: 0;
      width: 95.579%;
      height: 9.272%;
      background: linear-gradient(
        180deg,
        rgba(239, 229, 222, 0) 0%,
        #EFE5DE 90.89%
      );
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__image-frame,
    #PrimalWinHero-{{ section.id }} .primal-win-hero__empty-image {
      position: relative;
      top: auto;
      left: auto;
      display: block;
      width: 100%;
      height: auto;
      min-height: 0;
      overflow: hidden;
      background: transparent;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__image {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: center bottom;
