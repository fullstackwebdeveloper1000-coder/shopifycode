  #PrimalWinHero-{{ section.id }} .primal-win-hero__for-those {
    display: block;
    margin: 3px 0 0;
    padding: 0;
    font-size: 64px;
    font-weight: 800;
    line-height: 0.92;
    white-space: nowrap;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line {
    display: block;
    margin: 2px 0 0;
    padding: 0;
    font-size: 46px;
    font-weight: 800;
    line-height: 0.92;
    white-space: nowrap;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line em {
