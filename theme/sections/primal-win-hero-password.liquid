{% comment %}
  PRIMAL WIN — FIGMA NATIVE FADE V3 (responsive fix)
  Base desktop frame: 1440 × 730.

  - Entire 1440×730 canvas scales from the section's measured width
    (fixes Shopify preview / 50% width clipping).
  - Stage is full-bleed (100%) — matches Figma frame to preview width.
  - Soft right/bottom fades via Figma rectangles (::before / ::after).
  - Below 768px: content first, product below (no fixed-canvas clip).
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&family=Montserrat:wght@700;800;900&display=swap"
  rel="stylesheet"
>

{% liquid
  assign hero_alt = section.settings.hero_image.alt | default: section.settings.hero_image_alt
  assign logo_alt = section.settings.logo_image.alt | default: section.settings.brand_name
%}

<section
  id="PrimalWinHero-{{ section.id }}"
  class="primal-win-hero"
  style="
    --pw-background: {{ section.settings.hero_background }};
    --pw-text: {{ section.settings.hero_text }};
    --pw-gold: {{ section.settings.hero_gold }};
  "
>
  <div class="primal-win-hero__stage">
    <div class="primal-win-hero__canvas">
      <div
        class="primal-win-hero__logo"
        aria-label="{{ section.settings.brand_name | escape }}"
      >
        {% if section.settings.logo_image != blank %}
          {{
            section.settings.logo_image
            | image_url: width: 650
            | image_tag:
              class: 'primal-win-hero__logo-image',
              widths: '260, 325, 488, 650',
              sizes: '(min-width: 768px) 325px, min(82vw, 300px)',
              loading: 'eager',
              fetchpriority: 'high',
              alt: logo_alt
          }}
        {% else %}
          <span class="primal-win-hero__logo-mark" aria-hidden="true">P</span>

          <span class="primal-win-hero__logo-copy">
            <strong>{{ section.settings.brand_name | escape }}</strong>
            <small>{{ section.settings.brand_tagline | escape }}</small>
          </span>
        {% endif %}
      </div>

      <div class="primal-win-hero__copy">
        <h1 class="primal-win-hero__heading">
          <span class="primal-win-hero__primary">
            <span>{{ section.settings.heading_line_1 | escape }}</span>
            <span>{{ section.settings.heading_line_2 | escape }}</span>
            <span>{{ section.settings.heading_line_3 | escape }}</span>
          </span>

          <span class="primal-win-hero__built">
            {{ section.settings.heading_accent | escape }}
          </span>

          <span class="primal-win-hero__for-those">
            {{ section.settings.heading_line_4 | escape }}
          </span>

          <span class="primal-win-hero__win-line">
            {{ section.settings.heading_line_5 | escape -}}<em>.</em>
          </span>
        </h1>

        <span class="primal-win-hero__separator" aria-hidden="true"></span>

        <div class="primal-win-hero__details">
          {% if section.settings.detail_1 != blank %}
            <p>{{ section.settings.detail_1 | escape }}</p>
          {% endif %}

          {% if section.settings.detail_2 != blank %}
            <p>{{ section.settings.detail_2 | escape }}</p>
          {% endif %}

          {% if section.settings.detail_3 != blank %}
            <p>{{ section.settings.detail_3 | escape }}</p>
          {% endif %}

          {% if section.settings.detail_4 != blank %}
            <p class="primal-win-hero__launch">
              {{ section.settings.detail_4 | escape }}
            </p>
          {% endif %}
        </div>
      </div>

      <div class="primal-win-hero__visual">
        {% if section.settings.hero_image != blank %}
          <div class="primal-win-hero__image-frame">
            {{
              section.settings.hero_image
              | image_url: width: 1800
              | image_tag:
                class: 'primal-win-hero__image',
                widths: '480, 600, 750, 900, 1200, 1500, 1800',
                sizes: '(min-width: 1280px) 532px, (min-width: 768px) 42vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: hero_alt
            }}
          </div>
        {% else %}
          <div class="primal-win-hero__empty-image">
            <span>Select product visual</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PrimalWinHero-{{ section.id }},
  #PrimalWinHero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #PrimalWinHero-{{ section.id }} {
    position: relative;
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    overflow: clip;
    background: var(--pw-background);
    color: var(--pw-text);
    isolation: isolate;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  /* Full-bleed stage — MUST match scale width (was max 1280 → product clipped) */
  #PrimalWinHero-{{ section.id }} .primal-win-hero__stage {
    position: relative;
    width: 100%;
    max-width: none;
    height: auto;
    margin: 0;
    padding: 0;
    overflow: hidden;
    overflow: clip;
    background: var(--pw-background);
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 1440px;
    height: 730px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--pw-background);
    transform: scale(1);
    transform-origin: top left;
    will-change: transform;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__logo {
    position: absolute;
    z-index: 5;
    top: 13px;
    left: 105px;
    display: flex;
    align-items: center;
    width: 325px;
    height: 75px;
    margin: 0;
    padding: 0;
    mix-blend-mode: multiply;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-image {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: contain;
    object-position: left center;
  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__logo-mark {
    display: grid;
    flex: 0 0 47px;
    width: 47px;
    height: 47px;
