  }

  #PrimalWinHero-{{ section.id }} .primal-win-hero__visual {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 709.5px;
    width: 611.0105px;
    height: 738.631px;
    margin: 0;
    padding: 0;
