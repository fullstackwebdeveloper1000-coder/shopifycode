  @media screen and (max-width: 480px) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__canvas {
      padding: 16px 14px 0;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__visual {
      width: calc(100% + 28px);
      margin-right: -14px;
      margin-left: -14px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__primary {
      font-size: clamp(34px, 11vw, 42px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__built {
      font-size: clamp(48px, 16vw, 68px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__for-those {
      font-size: clamp(26px, 8.5vw, 34px);
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line {
      font-size: clamp(18px, 6vw, 26px);
    }
  }

  @media screen and (max-width: 360px) {
    #PrimalWinHero-{{ section.id }} .primal-win-hero__primary {
      font-size: 30px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__built {
      font-size: 44px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__for-those {
      font-size: 24px;
    }

    #PrimalWinHero-{{ section.id }} .primal-win-hero__win-line {
      font-size: 18px;
    }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById('PrimalWinHero-{{ section.id }}');
    if (!root || root.dataset.primalScaleReady === 'true') return;

    root.dataset.primalScaleReady = 'true';

    const stage = root.querySelector('.primal-win-hero__stage');
    const canvas = root.querySelector('.primal-win-hero__canvas');

    if (!stage || !canvas) return;

    const BASE_WIDTH = 1440;
    const BASE_HEIGHT = 730;
    const MOBILE_MAX = 767;

    const updateScale = () => {
      const availableWidth = root.getBoundingClientRect().width;

      if (!availableWidth) return;

      /* Mobile uses CSS stack — do not apply fixed-canvas scale */
      if (availableWidth <= MOBILE_MAX) {
        stage.style.removeProperty('height');
        canvas.style.removeProperty('transform');
        canvas.style.removeProperty('left');
        canvas.style.removeProperty('width');
        canvas.style.removeProperty('height');
        return;
      }

      /*
        Scale entire 1440×730 Figma frame to the FULL section width.
        Stage is also 100% wide — this fixes 50% preview / mid-width
        where max-width:1280 used to clip the product on the right.
      */
      const scale = availableWidth / BASE_WIDTH;

      stage.style.height = (BASE_HEIGHT * scale) + 'px';
      canvas.style.left = '0px';
      canvas.style.width = BASE_WIDTH + 'px';
      canvas.style.height = BASE_HEIGHT + 'px';
      canvas.style.transform = 'scale(' + scale + ')';
      canvas.style.transformOrigin = 'top left';
    };

    updateScale();

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(updateScale);
      observer.observe(root);
    } else {
      window.addEventListener('resize', updateScale, { passive: true });
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        requestAnimationFrame(updateScale);
      }
    });

    document.addEventListener('shopify:section:reorder', updateScale);
    window.addEventListener('load', updateScale, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Primal Hero Fade V8",
  "tag": "section",
  "class": "section-primal-hero-figma",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Product visual"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Product image alt text",
      "default": "Primal Win pouch with greens powder and gold scoop"
    },
    {
      "type": "header",
      "content": "Logo fallback"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "PRIMAL WIN"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand tagline",
      "default": "DAILY PERFORMANCE FORMULA"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "PREMIUM"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "DAILY"
    },
    {
