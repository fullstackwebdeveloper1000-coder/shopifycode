<section
  id="PwScienceHero-{{ section.id }}"
  class="pw-sci-hero"
  style="--pw-page: {{ section.settings.background_color }};"
>
  <div class="pw-sci-hero__container">
    <div class="pw-sci-hero__copy">
      {%- if section.settings.heading != blank -%}
        <h1 class="pw-sci-hero__head">{{ section.settings.heading }}</h1>
      {%- endif -%}

      <hr class="pw-sci-hero__rule" aria-hidden="true">

      {%- if section.settings.lead != blank -%}
        <p class="pw-sci-hero__lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      <div class="pw-sci-hero__feats">
        {%- for block in section.blocks -%}
          <div class="pw-sci-hero__feat" {{ block.shopify_attributes }}>
            <span class="pw-sci-hero__feat-icon" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon | image_url: width: 80 | image_tag: alt: '', loading: 'lazy', width: 30, height: 30 }}
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="2.2"/><ellipse cx="12" cy="12" rx="10" ry="4.4"/><ellipse cx="12" cy="12" rx="10" ry="4.4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4.4" transform="rotate(120 12 12)"/></svg>
                  {%- when 2 -%}
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 3h6M10 3v6l-5 8.5A2 2 0 0 0 6.7 21h10.6a2 2 0 0 0 1.7-3.5L14 9V3" stroke-linejoin="round"/></svg>
                  {%- when 3 -%}
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3l7 3v6c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3Z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- else -%}
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4" stroke-linecap="round"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank -%}
              <h4>{{ block.settings.title }}</h4>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 1200
      | image_tag:
        class: 'pw-sci-hero__shot',
        loading: 'eager',
        alt: section.settings.image.alt | default: 'Primal Win pouch',
        widths: '600,900,1200',
        sizes: '(min-width: 990px) 500px, 90vw'
    }}
  {%- endif -%}
</section>

{% style %}
  #PwScienceHero-{{ section.id }},
  #PwScienceHero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #PwScienceHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: var(--pw-page, #efe5dd);
    color: #1f2326;
    -webkit-font-smoothing: antialiased;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 56px 48px 40px;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__copy {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__head {
    margin: 0;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 900;
    font-size: 66px;
    line-height: 0.98;
    letter-spacing: -1px;
    text-transform: uppercase;
    color: #1f2326;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__head em,
  #PwScienceHero-{{ section.id }} .pw-sci-hero__head strong {
    color: #c89a3d;
    font-style: normal;
    font-weight: 900;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__rule {
    width: 60px;
    height: 3px;
    margin: 22px 0 18px;
    border: 0;
    background: #c89a3d;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__lead {
    margin: 0 0 34px;
    font-family: Inter, Arial, sans-serif;
    font-size: 20px;
    line-height: 1.4;
    color: #1f2326;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__feats {
    display: flex;
    gap: 0;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__feat {
    max-width: 210px;
    padding: 0 26px;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__feat:first-child {
    padding-left: 0;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__feat + .pw-sci-hero__feat {
    border-left: 1px solid rgba(31, 35, 38, 0.14);
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__feat-icon {
    display: block;
    margin-bottom: 12px;
    color: #c89a3d;
    line-height: 0;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__feat-icon img,
  #PwScienceHero-{{ section.id }} .pw-sci-hero__feat-icon svg {
    display: block;
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__feat h4 {
    margin: 0 0 7px;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 700;
    font-size: 13px;
    line-height: 1.2;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: #1f2326;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__feat p {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    font-size: 12.5px;
    line-height: 1.5;
    color: #737a80;
  }

  #PwScienceHero-{{ section.id }} .pw-sci-hero__shot {
    position: absolute;
    z-index: 1;
    right: -20px;
    top: 50%;
    transform: translateY(-50%);
    height: 500px;
    width: auto;
    max-width: none;
    object-fit: contain;
  }

  @media screen and (max-width: 1180px) {
    #PwScienceHero-{{ section.id }} .pw-sci-hero__container {
      padding-left: 34px;
      padding-right: 34px;
    }

    #PwScienceHero-{{ section.id }} .pw-sci-hero__head {
      font-size: 5.6vw;
    }

    #PwScienceHero-{{ section.id }} .pw-sci-hero__copy {
      max-width: 54%;
    }
  }

  @media screen and (max-width: 960px) {
    #PwScienceHero-{{ section.id }} .pw-sci-hero__container {
      min-height: 0;
    }

    #PwScienceHero-{{ section.id }} .pw-sci-hero__head {
      font-size: 44px;
    }

    #PwScienceHero-{{ section.id }} .pw-sci-hero__copy {
      max-width: 100%;
    }

    #PwScienceHero-{{ section.id }} .pw-sci-hero__shot {
      position: static;
      transform: none;
      display: block;
      height: auto;
      width: auto;
      max-width: 420px;
      margin: 26px auto 0;
    }
  }

  @media screen and (max-width: 560px) {
    #PwScienceHero-{{ section.id }} .pw-sci-hero__container {
      padding-left: 20px;
      padding-right: 20px;
    }

    #PwScienceHero-{{ section.id }} .pw-sci-hero__head {
      font-size: 38px;
    }

    #PwScienceHero-{{ section.id }} .pw-sci-hero__feats {
      flex-wrap: wrap;
      gap: 20px 0;
    }

    #PwScienceHero-{{ section.id }} .pw-sci-hero__feat {
      flex: 0 0 50%;
      max-width: 50%;
      padding: 0 16px;
      border-left: 0 !important;
    }

    #PwScienceHero-{{ section.id }} .pw-sci-hero__feat:nth-child(odd) {
      padding-left: 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Science — Hero",
  "tag": "section",
  "class": "pw-section pw-science-hero-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Your Potential.<br>Powered By <strong>Science.</strong></p>"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Subheading",
      "default": "The right ingredients. The right forms. The right doses."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#EFE5DD"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Science Backed"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Every ingredient is chosen for a reason."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science — Hero",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Science Backed",
            "text": "Every ingredient is chosen for a reason."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Clinically Inspired",
            "text": "Formulated using the latest research."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Immunity Support",
            "text": "Key nutrients for daily defence and vitality."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Focused & Every Scoop",
            "text": "Superior ingredients that work together."
          }
        }
      ]
    }
  ]
}
{% endschema %}
