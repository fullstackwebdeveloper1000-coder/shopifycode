{% comment %}
  Primal pre-launch — Figma holding card (user layout preserved).
  Only adds: SVG icon uploads + 1440/1280 pw-align with header.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">

<section
  id="PrimalPrelaunch-{{ section.id }}"
  class="primal-launch"
  data-deadline="{{ section.settings.launch_deadline | escape }}"
  style="
    --background: {{ section.settings.background_color_exact }};
    --card: {{ section.settings.card_color_exact }};
    --gold: {{ section.settings.gold_color_exact }};
    --dark: #1f2326;
    --stone: #f7f5f1;
    --slate: #737a80;
  "
>
  <div class="pw-container primal-launch__container">

    <div class="primal-launch__features">

      <div class="primal-launch__feature">
        <div class="primal-launch__icon">
          {% if section.settings.icon_ingredients != blank %}
            {{
              section.settings.icon_ingredients
              | image_url: width: 128
              | image_tag:
                class: 'primal-launch__icon-img',
                widths: '64, 128',
                sizes: '59px',
                loading: 'lazy',
                alt: ''
            }}
          {% else %}
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
              <circle cx="32" cy="32" r="30"/>
              <path d="M19 43C22 29 32 20 46 18C44 32 35 42 19 43Z"/>
              <path d="M20 42C27 34 34 28 43 22"/>
              <path d="M30 32L25 28M36 27L34 22"/>
            </svg>
          {% endif %}
        </div>
        <div>
          <strong>40 ACTIVE<br>INGREDIENTS</strong>
          <p>Powerful blends for energy, focus<br> and vitality.</p>
        </div>
      </div>

      <div class="primal-launch__feature">
        <div class="primal-launch__icon">
          {% if section.settings.icon_uk != blank %}
            {{
              section.settings.icon_uk
              | image_url: width: 128
              | image_tag:
                class: 'primal-launch__icon-img',
                widths: '64, 128',
                sizes: '59px',
                loading: 'lazy',
                alt: ''
            }}
          {% else %}
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
              <circle cx="32" cy="32" r="30"/>
              <rect x="18" y="20" width="28" height="24"/>
              <path d="M18 20L46 44M46 20L18 44M32 20V44M18 32H46"/>
            </svg>
          {% endif %}
        </div>
        <div>
          <strong>UK<br>MANUFACTURED</strong>
          <p>Made in the UK to the highest<br> standards.</p>
        </div>
      </div>

      <div class="primal-launch__feature">
        <div class="primal-launch__icon">
          {% if section.settings.icon_transparency != blank %}
            {{
              section.settings.icon_transparency
              | image_url: width: 128
              | image_tag:
                class: 'primal-launch__icon-img',
                widths: '64, 128',
                sizes: '59px',
                loading: 'lazy',
                alt: ''
            }}
          {% else %}
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
              <circle cx="32" cy="32" r="30"/>
              <path d="M32 15L44 20V31C44 39 39 45 32 49C25 45 20 39 20 31V20L32 15Z"/>
              <path d="M26 32L30 36L39 27"/>
            </svg>
          {% endif %}
        </div>
        <div>
          <strong>FULL LABEL<br>TRANSPARENCY</strong>
          <p>Honest ingredients. Nothing to<br> hide.</p>
        </div>
      </div>

    </div>

    <div class="primal-launch__card">

      <div class="primal-launch__offer">
        <p class="primal-launch__eyebrow">
          LIMITED TIME PRE-LAUNCH OFFER
        </p>

        <div class="primal-launch__discount">
          <span class="primal-launch__number">30</span>
          <span class="primal-launch__discount-side">
            <span class="primal-launch__percent">%</span>
            <span class="primal-launch__off">OFF</span>
          </span>
        </div>

        <h2>
          YOUR EXCLUSIVE<br>
          LAUNCH DISCOUNT CODE
        </h2>

        <div class="primal-launch__badge">
          BE THE FIRST TO WIN.
        </div>
      </div>

      <div class="primal-launch__signup">
        <p class="primal-launch__launching" data-countdown-title>
          LAUNCHING IN
        </p>

        <div class="primal-launch__countdown">
          <div class="primal-launch__time">
            <strong data-weeks>00</strong>
            <span>WEEKS</span>
          </div>
          <div class="primal-launch__time">
            <strong data-days>00</strong>
            <span>DAYS</span>
          </div>
          <div class="primal-launch__time">
            <strong data-hours>00</strong>
            <span>HOURS</span>
          </div>
          <div class="primal-launch__time">
            <strong data-minutes>00</strong>
            <span>MINUTES</span>
          </div>
          <div class="primal-launch__time">
            <strong data-seconds>00</strong>
            <span>SECONDS</span>
          </div>
        </div>

        <div class="primal-launch__date">
          <span></span>
          <strong>{{ section.settings.launch_date_label }}</strong>
          <span></span>
        </div>

        {% form 'customer', class: 'primal-launch__form' %}
          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter,primal-win-prelaunch,30-percent-discount"
          >

          <label class="primal-launch__hidden" for="PrimalEmail-{{ section.id }}">
            Email address
          </label>

          <input
            id="PrimalEmail-{{ section.id }}"
            class="primal-launch__email"
            type="email"
            name="contact[email]"
            placeholder="Enter your email address"
            autocomplete="email"
            required
          >

          <button class="primal-launch__button" type="submit">
            <span>CLAIM MY 30% LAUNCH DISCOUNT</span>
            <span class="primal-launch__arrow">→</span>
          </button>

          {% if form.posted_successfully? %}
            <p class="primal-launch__success">
              Thank you. Your registration is confirmed.
            </p>
          {% endif %}

          {% if form.errors %}
            <div class="primal-launch__error">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        {% endform %}

        <div class="primal-launch__note">
          {% if section.settings.icon_lock != blank %}
            {{
              section.settings.icon_lock
              | image_url: width: 32
              | image_tag:
                class: 'primal-launch__icon-img primal-launch__lock-img',
                widths: '15, 30',
                sizes: '15px',
                loading: 'lazy',
                alt: ''
            }}
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <rect x="5" y="10" width="14" height="11" rx="2"/>
              <path d="M8 10V7A4 4 0 0116 7V10"/>
            </svg>
          {% endif %}

          <p>
            Register now and we will email you your exclusive 30%<br>
            discount code the moment Primal Win goes live. No spam.<br>
            Unsubscribe any time.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

{% style %}
  #PrimalPrelaunch-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PrimalPrelaunch-{{ section.id }},
  #PrimalPrelaunch-{{ section.id }} * {
    box-sizing: border-box;
  }

  #PrimalPrelaunch-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 48px 0 55px;
    overflow: hidden;
    background: var(--background);
    color: var(--dark);
  }

  #PrimalPrelaunch-{{ section.id }} p,
  #PrimalPrelaunch-{{ section.id }} h2 {
    margin: 0;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* Header-aligned content: 1280 + gutters (same as primal-exact-header) */
  #PrimalPrelaunch-{{ section.id }} .pw-container.primal-launch__container {
    container-type: inline-size;
    width: 100%;
    max-width: var(--pw-inner);
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    height: clamp(88px, 9.107cqw, 102px);
    margin-bottom: clamp(18px, 1.964cqw, 22px);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__feature {
    display: flex;
    align-items: center;
    gap: clamp(13px, 1.518cqw, 17px);
    padding: 8px clamp(18px, 2.054cqw, 23px);
    border-right: 1px solid rgba(31, 35, 38, 0.17);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__feature:first-child {
    padding-left: 4px;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__feature:last-child {
    padding-right: 0;
    border-right: 0;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__icon {
    width: clamp(50px, 5.268cqw, 59px);
    height: clamp(50px, 5.268cqw, 59px);
    flex: 0 0 clamp(50px, 5.268cqw, 59px);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke: var(--dark);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__icon-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__feature strong {
    display: block;
    color: var(--dark);
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(13px, 1.34cqw, 15px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.2px;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__feature p {
    margin-top: 8px;
    color: #3d4246;
    font-family: Inter, Arial, sans-serif;
    font-size: clamp(12px, 1.25cqw, 14px);
    line-height: 1.5;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__card {
    position: relative;
    display: grid;
    grid-template-columns: 45.446% minmax(0, 1fr);
    width: 100%;
    height: auto;
    aspect-ratio: 1280 / 517;
    overflow: hidden;
    border-radius: 26px;
    background: linear-gradient(
      100deg,
      #192924 0%,
      #1b2726 48%,
      var(--card) 100%
    );
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__card::after {
    content: "";
    position: absolute;
    top: 9.956%;
    bottom: 6.637%;
    left: 45.446%;
    width: 1px;
    background: rgba(200, 154, 61, 0.3);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__offer {
    position: relative;
    z-index: 1;
    display: flex;
    padding: 0 4.286cqw 0 4.464cqw;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__eyebrow {
    margin-bottom: clamp(10px, 1.161cqw, 13px);
    color: var(--gold);
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(10px, 1.071cqw, 12px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: clamp(2px, 0.268cqw, 3px);
    white-space: nowrap;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__discount {
    display: flex;
    height: clamp(86px, 9.196cqw, 103px);
    margin-bottom: clamp(18px, 1.964cqw, 22px);
    align-items: flex-start;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__number,
  #PrimalPrelaunch-{{ section.id }} .primal-launch__percent,
  #PrimalPrelaunch-{{ section.id }} .primal-launch__off {
    display: block;
    background: none;
    color: var(--gold);
    -webkit-text-fill-color: currentColor;
    text-shadow: 0 0 34px rgba(200, 154, 61, 0.55);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__number {
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(92px, 10cqw, 112px);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -4px;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__discount-side {
    display: flex;
    margin: 2px 0 0 clamp(8px, 0.982cqw, 11px);
    flex-direction: column;
    font-family: Montserrat, Arial, sans-serif;
    font-weight: 900;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__percent {
    font-size: clamp(32px, 3.571cqw, 40px);
    line-height: 0.95;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__off {
    margin-top: 3px;
    font-size: clamp(30px, 3.393cqw, 38px);
    line-height: 0.95;
    letter-spacing: -1px;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__offer h2 {
    margin-bottom: clamp(18px, 1.964cqw, 22px);
    color: #ffffff;
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(20px, 2.143cqw, 24px);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: 0.1px;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__badge {
    display: grid;
    width: clamp(210px, 21.607cqw, 242px);
    height: clamp(44px, 4.375cqw, 49px);
    place-items: center;
    border: 1px solid var(--gold);
    border-radius: 8px;
    color: var(--gold);
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(10px, 1.071cqw, 12px);
    font-weight: 800;
    letter-spacing: clamp(1.4px, 0.179cqw, 2px);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__signup {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    padding: 3.929cqw 4.464cqw 2.679cqw 3.75cqw;
    flex-direction: column;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__launching {
    color: #ffffff;
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(13px, 1.339cqw, 15px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: clamp(3px, 0.357cqw, 4px);
    text-align: center;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__countdown {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    width: 100%;
    height: clamp(60px, 6.25cqw, 70px);
    margin-top: clamp(11px, 1.25cqw, 14px);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__time {
    display: flex;
    min-width: 0;
    height: clamp(60px, 6.25cqw, 70px);
    flex-direction: column;
    align-items: center;
    border-right: 1px solid rgba(200, 154, 61, 0.32);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__time:last-child {
    border-right: 0;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__time strong {
    color: var(--gold);
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(40px, 4.286cqw, 48px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__time span {
    margin-top: clamp(4px, 0.536cqw, 6px);
    color: #ffffff;
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(8px, 0.893cqw, 10px);
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__date {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    margin-top: clamp(10px, 1.161cqw, 13px);
    align-items: center;
    gap: clamp(13px, 1.518cqw, 17px);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__date span {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(200, 154, 61, 0.5)
    );
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__date span:last-child {
    background: linear-gradient(
      90deg,
      rgba(200, 154, 61, 0.5),
      transparent
    );
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__date strong {
    color: var(--gold);
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(13px, 1.339cqw, 15px);
    font-weight: 800;
    letter-spacing: clamp(2px, 0.268cqw, 3px);
    white-space: nowrap;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__form {
    display: grid;
    margin-top: clamp(16px, 1.696cqw, 19px);
    gap: clamp(10px, 1.071cqw, 12px);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__email {
    width: 100%;
    height: clamp(48px, 4.732cqw, 53px);
    margin: 0;
    padding: 0 clamp(16px, 1.696cqw, 19px);
    border: 0;
    border-radius: 10px;
    outline: 0;
    background: var(--stone);
    color: var(--dark);
    font-family: Inter, Arial, sans-serif;
    font-size: clamp(14px, 1.339cqw, 15px);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__email::placeholder {
    color: #858c92;
    opacity: 1;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__email:focus {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__button {
    display: grid;
    grid-template-columns: 1fr clamp(46px, 4.554cqw, 51px);
    width: 100%;
    height: clamp(50px, 4.911cqw, 55px);
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 10px;
    background: var(--gold);
    color: #111416;
    cursor: pointer;
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(13px, 1.339cqw, 15px);
    font-weight: 800;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__button > span:first-child {
    display: grid;
    padding-left: clamp(20px, 2.5cqw, 28px);
    place-items: center;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__arrow {
    display: grid;
    height: clamp(32px, 3.214cqw, 36px);
    margin: auto 0;
    place-items: center;
    border-left: 1px solid rgba(17, 20, 22, 0.28);
    font-family: Inter, Arial, sans-serif;
    font-size: clamp(20px, 2.143cqw, 24px);
    font-weight: 400;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__button:hover {
    filter: brightness(1.07);
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__note {
    display: flex;
    margin: clamp(15px, 1.607cqw, 18px) auto 0;
    align-items: flex-start;
    gap: 10px;
    color: #c7cbce;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__note svg,
  #PrimalPrelaunch-{{ section.id }} .primal-launch__lock-img {
    width: 15px;
    height: 15px;
    margin-top: 2px;
    flex: 0 0 15px;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__note svg {
    stroke: var(--gold);
    stroke-width: 1.5;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__note p {
    font-family: Inter, Arial, sans-serif;
    font-size: clamp(11px, 1.071cqw, 12px);
    line-height: 1.55;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__success {
    color: var(--gold);
    font: 12px/1.4 Inter, Arial, sans-serif;
  }

  #PrimalPrelaunch-{{ section.id }} .primal-launch__error {
    color: #ff9090;
    font: 12px/1.4 Inter, Arial, sans-serif;
  }

  /* Tablet: keep 3-col features when possible, tighten card */
  @media screen and (max-width: 989px) and (min-width: 821px) {
    #PrimalPrelaunch-{{ section.id }} {
      padding: 36px 0 40px;
    }

    #PrimalPrelaunch-{{ section.id }} .primal-launch__features {
      height: auto;
      min-height: 0;
      margin-bottom: 18px;
    }

    #PrimalPrelaunch-{{ section.id }} .primal-launch__feature {
      align-items: flex-start;
      padding: 10px 12px;
    }

    #PrimalPrelaunch-{{ section.id }} .primal-launch__card {
      aspect-ratio: auto;
      min-height: 0;
    }

    #PrimalPrelaunch-{{ section.id }} .primal-launch__offer {
      padding: 36px 28px 36px 32px;
    }

    #PrimalPrelaunch-{{ section.id }} .primal-launch__signup {
      padding: 32px 28px 28px 24px;
    }

    #PrimalPrelaunch-{{ section.id }} .primal-launch__number {
      font-size: clamp(72px, 9vw, 96px);
    }

    #PrimalPrelaunch-{{ section.id }} .primal-launch__time strong {
      font-size: clamp(28px, 3.6vw, 40px);
    }
  }

  /* Phone / small tablet: compact stack — no empty card length */
  @media screen and (max-width: 820px) {
    #PrimalPrelaunch-{{ section.id }} {
      padding: 16px 0 18px;
    }

    #PrimalPrelaunch-{{ section.id }} .pw-container.primal-launch__container {
      padding-inline: 12px;
    }

    #PrimalPrelaunch-{{ section.id }} .primal-launch__features {
      grid-template-columns: 1fr;
      height: auto;
      margin-bottom: 12px;
      gap: 0;
    }

    #PrimalPrelaunch-{{ section.id }} .primal-launch__feature,
    #PrimalPrelaunch-{{ section.id }} .primal-launch__feature:first-child,
    #PrimalPrelaunch-{{ section.id }} .primal-launch__feature:last-child {
      min-height: 0;
      padding: 10px 0;
      border-right: 0;
