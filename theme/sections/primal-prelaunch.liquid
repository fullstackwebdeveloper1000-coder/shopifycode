<script>
  (function () {
    var root = document.getElementById('PrimalPrelaunch-{{ section.id }}');
    if (!root) return;

    var timerKey = 'primalTimer_{{ section.id }}';
    if (window[timerKey]) clearInterval(window[timerKey]);

    var target = new Date(root.getAttribute('data-deadline')).getTime();
    var title = root.querySelector('[data-countdown-title]');
    var weeksNode = root.querySelector('[data-weeks]');
    var daysNode = root.querySelector('[data-days]');
    var hoursNode = root.querySelector('[data-hours]');
    var minutesNode = root.querySelector('[data-minutes]');
    var secondsNode = root.querySelector('[data-seconds]');

    function formatNumber(number) {
      return String(Math.max(0, number)).padStart(2, '0');
    }

    function updateCountdown() {
      if (isNaN(target)) {
        if (title) title.textContent = 'LAUNCH DATE TBC';
        return;
      }

      var remaining = Math.max(0, target - Date.now());
      var totalSeconds = Math.floor(remaining / 1000);
      var totalDays = Math.floor(totalSeconds / 86400);
      var weeks = Math.floor(totalDays / 7);
      var days = totalDays % 7;
      var hours = Math.floor((totalSeconds % 86400) / 3600);
      var minutes = Math.floor((totalSeconds % 3600) / 60);
      var seconds = totalSeconds % 60;

      if (weeksNode) weeksNode.textContent = formatNumber(weeks);
      if (daysNode) daysNode.textContent = formatNumber(days);
      if (hoursNode) hoursNode.textContent = formatNumber(hours);
      if (minutesNode) minutesNode.textContent = formatNumber(minutes);
      if (secondsNode) secondsNode.textContent = formatNumber(seconds);

      if (remaining <= 0) {
        if (title) title.textContent = 'NOW LIVE';
        clearInterval(window[timerKey]);
      }
    }

    updateCountdown();
    window[timerKey] = setInterval(updateCountdown, 1000);
  })();
</script>

