{% liquid
  assign custom_icon_svg_value = section.settings.custom_icon_svg | strip
  assign custom_icon_svg_src = ''

  if custom_icon_svg_value != blank
    if custom_icon_svg_value contains '://'
      assign custom_icon_svg_src = custom_icon_svg_value
    else
      assign custom_icon_svg_src = custom_icon_svg_value | asset_url
    endif
  endif
%}

<section id="PwPipette-{{ section.id }}" class="band band-light brought">
  <div class="band-media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'band-img band-img--bg',
          loading: 'lazy',
          alt: '',
          width: section.settings.image.width,
          height: section.settings.image.height,
          widths: '900, 1200, 1600, 2000, 2400',
          sizes: '(min-width: 861px) 55vw, 100vw'
      }}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'band-img band-img--main',
          loading: 'lazy',
          alt: 'Researcher measuring an ingredient in the lab',
          width: section.settings.image.width,
          height: section.settings.image.height,
          widths: '900, 1200, 1600, 2000, 2400',
          sizes: '(min-width: 861px) 55vw, 100vw'
      }}
    {%- else -%}
      <img
        class="band-img band-img--bg"
        src="{{ 'prmal-pipette.png' | asset_url }}"
        alt=""
        loading="lazy"
        width="1800"
        height="800"
      >
      <img
        class="band-img band-img--main"
        src="{{ 'prmal-pipette.png' | asset_url }}"
        alt="Researcher measuring an ingredient in the lab"
        loading="lazy"
        width="1800"
        height="800"
      >
    {%- endif -%}
  </div>

  <div class="container band-in">
    <span class="ic-circle" aria-hidden="true">
      {%- if custom_icon_svg_src != blank -%}
        <img
          class="custom-icon"
          src="{{ custom_icon_svg_src | escape }}"
          alt=""
          width="46"
          height="46"
          loading="lazy"
        >
      {%- elsif section.settings.custom_icon_image != blank -%}
        {{
          section.settings.custom_icon_image
          | image_url: width: 160
          | image_tag:
            class: 'custom-icon',
            loading: 'lazy',
            widths: '72, 92, 120, 160',
            sizes: '46px',
            alt: ''
        }}
      {%- else -%}
        <svg width="46" height="46" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 6h6M24 6v6"/><path d="M20 12h8v6a4 4 0 0 1-8 0v-6Z"/><path d="M24 24v8"/><path d="M16 40c0-4 3.6-8 8-8s8 4 8 8"/><path d="M13 40h22"/></svg>
      {%- endif -%}
    </span>

    <div class="copy-block">
      <p class="body"><b>We brought</b> in PhD nutritionists and clinical researchers who cared about one thing: does this ingredient earn its place, at a real dose, backed by real evidence.</p>
      <p class="accent">If it didn&apos;t, it didn&apos;t make the formula.</p>
    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  #PwPipette-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip !important;
    background: #ffffff !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwPipette-{{ section.id }},
  #PwPipette-{{ section.id }} *,
  #PwPipette-{{ section.id }} *::before,
  #PwPipette-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PwPipette-{{ section.id }} {
    position: relative;
    width: 100%;
    height: clamp(410px, 34.7947vw, 500px);
    min-height: 410px;
    max-height: 500px;
    margin: 0;
    overflow: hidden;
    border-radius: 15.96px;
    background: #ffffff;
    color: #1f2326;
    font-family: Inter, system-ui, sans-serif;
    isolation: isolate;
  }

  /*
   * Header-aligned content:
   * same centered max-width and gutter used by the Primal header.
   */
  #PwPipette-{{ section.id }} .container {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: max(
      var(--pw-gutter, 80px),
      calc(
        (100% - var(--pw-max, 1440px)) / 2 +
        var(--pw-gutter, 80px)
      )
    );
    display: flex;
    width: min(490px, 39vw);
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: 30px;
    transform: translateY(-50%);
  }

  /*
   * Image frame starts at the Figma split and always reaches the right edge.
   */
  #PwPipette-{{ section.id }} .band-media {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    bottom: 0;
    left: max(
      48.238%,
      calc((100% - 1437px) / 2 + 693.18px)
    );
    overflow: hidden;
    border-radius: 0 15.96px 15.96px 0;
    background: #eef1f1;
  }

  #PwPipette-{{ section.id }} .band-img {
    position: absolute;
    display: block;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    margin: 0;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  /*
   * Background layer fills the frame.
   * Main layer remains fully visible, so the scientist is not cropped.
   */
  #PwPipette-{{ section.id }} .band-img--bg {
    z-index: 1;
    object-fit: cover !important;
    object-position: right center !important;
    filter: blur(10px);
    opacity: 0.30;
    transform: scale(1.045);
  }

  #PwPipette-{{ section.id }} .band-img--main {
    z-index: 2;
    object-fit: contain !important;
    object-position: right center !important;
    background: transparent;
    transform: none !important;
  }

  /*
   * Smooth white fade between content and the complete image.
   */
  #PwPipette-{{ section.id }}::after {
    content: "";
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: max(
      calc(48.238% - 155px),
      calc((100% - 1437px) / 2 + 538.18px)
    );
    width: 240px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      #ffffff 0%,
      #ffffff 24%,
      rgba(255, 255, 255, 0.98) 37%,
      rgba(255, 255, 255, 0.88) 50%,
      rgba(255, 255, 255, 0.66) 64%,
      rgba(255, 255, 255, 0.38) 77%,
      rgba(255, 255, 255, 0.14) 89%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  #PwPipette-{{ section.id }} .ic-circle {
    display: flex;
    width: 92px;
    height: 92px;
    flex: 0 0 92px;
    align-items: center;
    justify-content: center;
    border: 2px solid #c89a3d;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.52);
    color: #c89a3d;
  }

  #PwPipette-{{ section.id }} .ic-circle svg,
  #PwPipette-{{ section.id }} .custom-icon {
    display: block;
    width: 46px;
    height: 46px;
    max-width: 46px;
    max-height: 46px;
    object-fit: contain;
  }

  #PwPipette-{{ section.id }} .copy-block {
    width: 100%;
    min-width: 0;
    max-width: 368px;
  }

  #PwPipette-{{ section.id }} p.body {
    width: 100%;
    margin: 0;
    color: #2c322e;
    font-size: 18px;
    line-height: 1.65;
  }

  #PwPipette-{{ section.id }} p.body b {
    color: #1f2326;
    font-weight: 700;
  }

  #PwPipette-{{ section.id }} .accent {
    margin: 18px 0 0;
    color: #c89a3d;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  /*
   * Desktop only:
   * gradient attached to the image frame edge — where white ends.
   */
  @media screen and (min-width: 861px) {
    #PwPipette-{{ section.id }} .band-media {
      background: #ffffff !important;
    }

    #PwPipette-{{ section.id }} .band-img--bg {
      display: none !important;
    }

    #PwPipette-{{ section.id }} .band-img--main {
      background: #ffffff !important;
    }

    #PwPipette-{{ section.id }}::after {
      display: none !important;
    }

    #PwPipette-{{ section.id }} .band-media::after {
      content: "";
      position: absolute;
      z-index: 4;
      top: 0;
      bottom: 0;
      left: 0;
      width: 280px;
      max-width: 42%;
      pointer-events: none;
      background: linear-gradient(
        90deg,
        #ffffff 0%,
        rgba(255, 255, 255, 0.99) 12%,
        rgba(255, 255, 255, 0.96) 24%,
        rgba(255, 255, 255, 0.88) 38%,
        rgba(255, 255, 255, 0.72) 52%,
        rgba(255, 255, 255, 0.50) 66%,
        rgba(255, 255, 255, 0.28) 80%,
        rgba(255, 255, 255, 0.10) 91%,
        rgba(255, 255, 255, 0) 100%
      );
    }
  }

  @media screen and (min-width: 861px) and (max-width: 1199px) {
    #PwPipette-{{ section.id }} {
      height: clamp(410px, 43vw, 500px);
    }

    #PwPipette-{{ section.id }} .container {
      left: var(--pw-gutter, 40px);
      width: 43%;
      gap: 20px;
    }

    #PwPipette-{{ section.id }} .band-media {
      left: 48%;
    }

    #PwPipette-{{ section.id }}::after {
      left: calc(48% - 125px);
      width: 200px;
    }

    #PwPipette-{{ section.id }} .band-media::after {
      width: 220px;
      max-width: 48%;
    }

    #PwPipette-{{ section.id }} .ic-circle {
      width: 74px;
      height: 74px;
      flex-basis: 74px;
    }

    #PwPipette-{{ section.id }} .ic-circle svg,
    #PwPipette-{{ section.id }} .custom-icon {
      width: 37px;
      height: 37px;
      max-width: 37px;
      max-height: 37px;
    }

    #PwPipette-{{ section.id }} p.body {
      font-size: clamp(14px, 1.7vw, 17px);
      line-height: 1.58;
    }

    #PwPipette-{{ section.id }} .accent {
      font-size: clamp(14px, 1.55vw, 16px);
    }
  }

  /*
   * Responsive:
   * full image visible; copy on lower edge; white→image soft gradient.
   */
  @media screen and (max-width: 860px) {
    #PwPipette-{{ section.id }} {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      width: 100%;
      height: auto;
      min-height: 0;
      max-height: none;
      overflow: hidden;
      border-radius: 0;
      background: #eef1f1;
    }

    #PwPipette-{{ section.id }}::after {
      display: none;
    }

    #PwPipette-{{ section.id }} .band-media {
      position: relative;
      z-index: 1;
      grid-area: 1 / 1;
      inset: auto;
      width: 100%;
      min-height: 0;
      aspect-ratio: 3 / 2;
      border-radius: 0;
      background: #eef1f1;
    }

    /* Where white ends into the photo — soft fade under copy */
    #PwPipette-{{ section.id }} .band-media::after {
      content: "";
      position: absolute;
      z-index: 3;
      left: 0;
      right: 0;
      bottom: 0;
      height: 55%;
      pointer-events: none;
      background: linear-gradient(
        0deg,
        #ffffff 0%,
        rgba(255, 255, 255, 0.96) 18%,
        rgba(255, 255, 255, 0.78) 40%,
        rgba(255, 255, 255, 0.4) 68%,
        rgba(255, 255, 255, 0) 100%
      );
    }

    #PwPipette-{{ section.id }} .band-img--bg {
      opacity: 0.34;
      filter: blur(8px);
    }

    #PwPipette-{{ section.id }} .band-img--main {
      object-fit: contain !important;
      object-position: center center !important;
    }

    #PwPipette-{{ section.id }} .container {
      position: relative;
      z-index: 4;
      grid-area: 1 / 1;
      top: auto;
      left: auto;
      align-self: end;
      display: flex;
      width: calc(100% - (var(--pw-gutter, 28px) * 2));
      max-width: 680px;
      height: auto;
      margin:
        0
        auto
        clamp(20px, 4vw, 34px);
      padding: clamp(20px, 3.5vw, 28px);
      gap: 20px;
      border: 1px solid rgba(31, 35, 38, 0.10);
      border-radius: 18px;
      background:
        linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.97) 0%,
          rgba(255, 255, 255, 0.86) 100%
        );
      box-shadow: 0 16px 40px rgba(31, 35, 38, 0.14);
      backdrop-filter: blur(9px);
      transform: none;
    }

    #PwPipette-{{ section.id }} .ic-circle {
      width: 70px;
      height: 70px;
      flex-basis: 70px;
      background: rgba(255, 255, 255, 0.72);
    }

    #PwPipette-{{ section.id }} .ic-circle svg,
    #PwPipette-{{ section.id }} .custom-icon {
      width: 35px;
      height: 35px;
      max-width: 35px;
      max-height: 35px;
    }

    #PwPipette-{{ section.id }} .copy-block {
      max-width: none;
    }

    #PwPipette-{{ section.id }} p.body {
      font-size: clamp(15px, 2.5vw, 18px);
      line-height: 1.55;
    }

    #PwPipette-{{ section.id }} .accent {
      margin-top: 12px;
      color: #bd8628;
      font-size: clamp(14px, 2.3vw, 16px);
      font-weight: 600;
    }
  }

  @media screen and (max-width: 560px) {
    #PwPipette-{{ section.id }} .band-media {
      aspect-ratio: 4 / 5;
    }

    #PwPipette-{{ section.id }} .band-img--main {
      object-position: center top !important;
    }

    #PwPipette-{{ section.id }} .band-media::after {
      height: 58%;
    }

    #PwPipette-{{ section.id }} .container {
      width: calc(100% - (var(--pw-gutter, 16px) * 2));
      margin-bottom: 16px;
      padding: 18px 16px;
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
      border-radius: 15px;
    }

    #PwPipette-{{ section.id }} .ic-circle {
      width: 58px;
      height: 58px;
      flex-basis: 58px;
    }

    #PwPipette-{{ section.id }} .ic-circle svg,
    #PwPipette-{{ section.id }} .custom-icon {
      width: 29px;
      height: 29px;
      max-width: 29px;
      max-height: 29px;
    }

    #PwPipette-{{ section.id }} p.body {
      font-size: clamp(14px, 4vw, 16px);
      line-height: 1.52;
    }

    #PwPipette-{{ section.id }} .accent {
      font-size: clamp(13.5px, 3.8vw, 15px);
    }
  }

  @media screen and (max-width: 360px) {
    #PwPipette-{{ section.id }} .container {
      width: calc(100% - 24px);
      padding: 16px 14px;
    }

    #PwPipette-{{ section.id }} p.body {
      font-size: 13.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #PwPipette-{{ section.id }} *,
    #PwPipette-{{ section.id }} *::before,
    #PwPipette-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Story Pipette",
  "tag": "section",
  "class": "pw-pipette-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Override image (default: prmal-pipette.png from Assets)"
    },
    {
      "type": "text",
      "id": "custom_icon_svg",
      "label": "Custom icon SVG URL / asset filename",
      "info": "Shopify Files SVG URL ya theme Assets ka filename paste karein."
    },
    {
      "type": "image_picker",
      "id": "custom_icon_image",
      "label": "Custom icon PNG / WebP"
    }
  ],
  "presets": [
    {
      "name": "Story Pipette"
    }
  ]
}
{% endschema %}
