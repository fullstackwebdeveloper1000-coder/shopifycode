{% liquid
  assign custom_icon_svg_value = section.settings.custom_icon_svg | strip
  assign custom_icon_svg_src = ''

  if custom_icon_svg_value != blank
    if custom_icon_svg_value contains '://'
      assign custom_icon_svg_src = custom_icon_svg_value
    else
      assign custom_icon_svg_src = custom_icon_svg_value | asset_url
    endif
  endif
%}

<section id="PwPipette-{{ section.id }}" class="band band-light brought">
  <div class="band-media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'band-img band-img--bg',
          loading: 'lazy',
          alt: '',
          width: section.settings.image.width,
          height: section.settings.image.height,
          widths: '900, 1200, 1600, 2000, 2400',
          sizes: '(min-width: 861px) 55vw, 100vw'
      }}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'band-img band-img--main',
          loading: 'lazy',
          alt: 'Researcher measuring an ingredient in the lab',
          width: section.settings.image.width,
          height: section.settings.image.height,
          widths: '900, 1200, 1600, 2000, 2400',
          sizes: '(min-width: 861px) 55vw, 100vw'
      }}
    {%- else -%}
      <img
        class="band-img band-img--bg"
        src="{{ 'prmal-pipette.png' | asset_url }}"
        alt=""
        loading="lazy"
        width="1800"
        height="800"
      >
      <img
        class="band-img band-img--main"
        src="{{ 'prmal-pipette.png' | asset_url }}"
        alt="Researcher measuring an ingredient in the lab"
        loading="lazy"
        width="1800"
        height="800"
      >
    {%- endif -%}

    {%- comment -%} Real fade nodes — always visible, not relying on ::after alone {%- endcomment -%}
    <span class="band-fade band-fade--side" aria-hidden="true"></span>
    <span class="band-fade band-fade--bottom" aria-hidden="true"></span>
  </div>

  {%- comment -%} Desktop bridge: white → photo across the split {%- endcomment -%}
  <span class="band-fade band-fade--bridge" aria-hidden="true"></span>

  <div class="container band-in">
    <span class="ic-circle" aria-hidden="true">
      {%- if custom_icon_svg_src != blank -%}
        <img
          class="custom-icon"
          src="{{ custom_icon_svg_src | escape }}"
          alt=""
          width="46"
          height="46"
          loading="lazy"
        >
      {%- elsif section.settings.custom_icon_image != blank -%}
        {{
          section.settings.custom_icon_image
          | image_url: width: 160
          | image_tag:
            class: 'custom-icon',
            loading: 'lazy',
            widths: '72, 92, 120, 160',
            sizes: '46px',
            alt: ''
        }}
      {%- else -%}
        <svg width="46" height="46" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 6h6M24 6v6"/><path d="M20 12h8v6a4 4 0 0 1-8 0v-6Z"/><path d="M24 24v8"/><path d="M16 40c0-4 3.6-8 8-8s8 4 8 8"/><path d="M13 40h22"/></svg>
      {%- endif -%}
    </span>

    <div class="copy-block">
      <p class="body"><b>We brought</b> in PhD nutritionists and clinical researchers who cared about one thing: does this ingredient earn its place, at a real dose, backed by real evidence.</p>
      <p class="accent">If it didn&apos;t, it didn&apos;t make the formula.</p>
    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  #PwPipette-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip !important;
    background: #ffffff !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwPipette-{{ section.id }},
  #PwPipette-{{ section.id }} *,
  #PwPipette-{{ section.id }} *::before,
  #PwPipette-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /*
   * Web = same framing as iPad/tablet:
   * wider photo pane + contain so scientist / tubes stay fully visible.
   */
  #PwPipette-{{ section.id }} {
    position: relative;
    width: 100%;
    height: clamp(420px, 38vw, 520px);
    min-height: 420px;
    max-height: 520px;
    margin: 0;
    overflow: hidden;
    border-radius: 0;
    background: #ffffff;
    color: #1f2326;
    font-family: Inter, system-ui, sans-serif;
    isolation: isolate;
  }

  #PwPipette-{{ section.id }} .container {
    position: absolute;
    z-index: 6;
    top: 50%;
    left: max(
      var(--pw-gutter, 48px),
      calc(
        (100% - var(--pw-max, 1440px)) / 2 +
        var(--pw-gutter, 48px)
      )
    );
    display: flex;
    width: min(460px, 40%);
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: 24px;
    transform: translateY(-50%);
  }

  /* Wider image pane — matches tablet full-image look */
  #PwPipette-{{ section.id }} .band-media {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    bottom: 0;
    left: 42%;
    overflow: hidden;
    border-radius: 0;
    background: #ffffff;
  }

  #PwPipette-{{ section.id }} .band-img {
    position: absolute;
    display: block;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    margin: 0;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  /*
   * Full image (contain) + soft fill behind.
   * Mask feathers left into white — same as iPad / Figma.
   */
  #PwPipette-{{ section.id }} .band-img--bg {
    z-index: 1;
    object-fit: cover !important;
    object-position: right center !important;
    filter: blur(12px);
    opacity: 0.2;
    transform: scale(1.04);
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.15) 14%,
      rgba(0, 0, 0, 0.55) 26%,
      #000000 40%,
      #000000 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.15) 14%,
      rgba(0, 0, 0, 0.55) 26%,
      #000000 40%,
      #000000 100%
    );
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  #PwPipette-{{ section.id }} .band-img--main {
    z-index: 2;
    object-fit: contain !important;
    object-position: right center !important;
    background: transparent !important;
    transform: none !important;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.12) 12%,
      rgba(0, 0, 0, 0.5) 24%,
      #000000 38%,
      #000000 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.12) 12%,
      rgba(0, 0, 0, 0.5) 24%,
      #000000 38%,
      #000000 100%
    );
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  #PwPipette-{{ section.id }} .band-fade {
    pointer-events: none;
  }

  /* Overlay fades off on desktop — mask does the Figma edge */
  #PwPipette-{{ section.id }} .band-fade--side,
  #PwPipette-{{ section.id }} .band-fade--bridge {
    display: none;
  }

  #PwPipette-{{ section.id }} .band-fade--bottom {
    display: none;
  }

  #PwPipette-{{ section.id }} .ic-circle {
    display: flex;
    width: 92px;
    height: 92px;
    flex: 0 0 92px;
    align-items: center;
    justify-content: center;
    border: 2px solid #c89a3d;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.52);
    color: #c89a3d;
  }

  #PwPipette-{{ section.id }} .ic-circle svg,
  #PwPipette-{{ section.id }} .custom-icon {
    display: block;
    width: 46px;
    height: 46px;
    max-width: 46px;
    max-height: 46px;
    object-fit: contain;
  }

  #PwPipette-{{ section.id }} .copy-block {
    width: 100%;
    min-width: 0;
    max-width: 368px;
  }

  #PwPipette-{{ section.id }} p.body {
    width: 100%;
    margin: 0;
    color: #2c322e;
    font-size: 18px;
    line-height: 1.65;
  }

  #PwPipette-{{ section.id }} p.body b {
    color: #1f2326;
    font-weight: 700;
  }

  #PwPipette-{{ section.id }} .accent {
    margin: 18px 0 0;
    color: #c89a3d;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  /* iPad / small laptop — same full-image split as web, tighter type only */
  @media screen and (min-width: 861px) and (max-width: 1199px) {
    #PwPipette-{{ section.id }} {
      height: clamp(420px, 44vw, 520px);
    }

    #PwPipette-{{ section.id }} .container {
      left: var(--pw-gutter, 34px);
      width: 40%;
      gap: 18px;
    }

    #PwPipette-{{ section.id }} .band-media {
      left: 40%;
    }

    #PwPipette-{{ section.id }} .ic-circle {
      width: 74px;
      height: 74px;
      flex-basis: 74px;
    }

    #PwPipette-{{ section.id }} .ic-circle svg,
    #PwPipette-{{ section.id }} .custom-icon {
      width: 37px;
      height: 37px;
      max-width: 37px;
      max-height: 37px;
    }

    #PwPipette-{{ section.id }} p.body {
      font-size: clamp(14px, 1.7vw, 17px);
      line-height: 1.58;
    }

    #PwPipette-{{ section.id }} .accent {
      font-size: clamp(14px, 1.55vw, 16px);
    }
  }

  /*
   * Mobile / tablet:
   * full image (contain — scientist complete), copy under soft white fade.
   */
  @media screen and (max-width: 860px) {
    #PwPipette-{{ section.id }} {
      display: flex;
      flex-direction: column;
      height: auto;
      min-height: 0;
      max-height: none;
      overflow: hidden;
      background: #ffffff;
    }

    #PwPipette-{{ section.id }} .band-fade--bridge {
      display: none;
    }

    #PwPipette-{{ section.id }} .band-fade--side {
      display: none;
    }

    #PwPipette-{{ section.id }} .band-media {
      position: relative;
      z-index: 1;
      top: auto;
      right: auto;
      bottom: auto;
      left: auto;
      order: 1;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 10;
      background: #f3f5f5;
    }

    #PwPipette-{{ section.id }} .band-img--bg {
      display: block;
      opacity: 0.22;
      filter: blur(10px);
    }

    #PwPipette-{{ section.id }} .band-img--bg,
    #PwPipette-{{ section.id }} .band-img--main {
      -webkit-mask-image: none;
      mask-image: none;
    }

    #PwPipette-{{ section.id }} .band-img--main {
      object-fit: contain !important;
      object-position: center center !important;
    }

    /* Soft white where image meets copy */
    #PwPipette-{{ section.id }} .band-fade--bottom {
      display: block;
      position: absolute;
      z-index: 5;
      left: 0;
      right: 0;
      bottom: 0;
      height: 42%;
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.35) 28%,
        rgba(255, 255, 255, 0.82) 62%,
        #ffffff 100%
      );
    }

    #PwPipette-{{ section.id }} .container {
      position: relative;
      z-index: 6;
      top: auto;
      left: auto;
      order: 2;
      display: flex;
      width: 100%;
      max-width: none;
      height: auto;
      margin: 0;
      padding: 8px var(--pw-gutter, 22px) 36px;
      gap: 20px;
      align-items: center;
      border: 0;
      border-radius: 0;
      background: #ffffff;
      box-shadow: none;
      backdrop-filter: none;
      transform: none;
    }

    #PwPipette-{{ section.id }} .ic-circle {
      width: 70px;
      height: 70px;
      flex-basis: 70px;
      background: rgba(255, 255, 255, 0.72);
    }

    #PwPipette-{{ section.id }} .ic-circle svg,
    #PwPipette-{{ section.id }} .custom-icon {
      width: 35px;
      height: 35px;
      max-width: 35px;
      max-height: 35px;
    }

    #PwPipette-{{ section.id }} .copy-block {
      max-width: none;
    }

    #PwPipette-{{ section.id }} p.body {
      font-size: clamp(15px, 2.5vw, 18px);
      line-height: 1.55;
    }

    #PwPipette-{{ section.id }} .accent {
      margin-top: 12px;
      color: #bd8628;
      font-size: clamp(14px, 2.3vw, 16px);
      font-weight: 600;
    }
  }

  @media screen and (max-width: 560px) {
    /* Wider frame so full pipette shot stays visible */
    #PwPipette-{{ section.id }} .band-media {
      aspect-ratio: 4 / 3;
    }

    #PwPipette-{{ section.id }} .band-fade--bottom {
      height: 36%;
    }

    #PwPipette-{{ section.id }} .container {
      padding: 4px var(--pw-gutter, 16px) 28px;
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }

    #PwPipette-{{ section.id }} .ic-circle {
      width: 58px;
      height: 58px;
      flex-basis: 58px;
    }

    #PwPipette-{{ section.id }} .ic-circle svg,
    #PwPipette-{{ section.id }} .custom-icon {
      width: 29px;
      height: 29px;
      max-width: 29px;
      max-height: 29px;
    }

    #PwPipette-{{ section.id }} p.body {
      font-size: clamp(14px, 4vw, 16px);
      line-height: 1.52;
    }

    #PwPipette-{{ section.id }} .accent {
      font-size: clamp(13.5px, 3.8vw, 15px);
    }
  }

  @media screen and (max-width: 360px) {
    #PwPipette-{{ section.id }} .band-media {
      aspect-ratio: 5 / 4;
    }

    #PwPipette-{{ section.id }} .container {
      padding: 0 14px 24px;
    }

    #PwPipette-{{ section.id }} p.body {
      font-size: 13.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #PwPipette-{{ section.id }} *,
    #PwPipette-{{ section.id }} *::before,
    #PwPipette-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Story Pipette",
  "tag": "section",
  "class": "pw-pipette-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Override image (default: prmal-pipette.png from Assets)"
    },
    {
      "type": "text",
      "id": "custom_icon_svg",
      "label": "Custom icon SVG URL / asset filename",
      "info": "Shopify Files SVG URL ya theme Assets ka filename paste karein."
    },
    {
      "type": "image_picker",
      "id": "custom_icon_image",
      "label": "Custom icon PNG / WebP"
    }
  ],
  "presets": [
    {
      "name": "Story Pipette"
    }
  ]
}
{% endschema %}
