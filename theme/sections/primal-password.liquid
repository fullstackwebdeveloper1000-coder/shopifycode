{% comment %}
  Primal Win — Password / Coming Soon gate
  Works with Online Store > Preferences > Password protection.
  Form: storefront_password (Shopify native).
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet">

<section
  id="PwPassword-{{ section.id }}"
  class="pw-password"
  style="
    --pw-bg: {{ section.settings.background_color }};
    --pw-card: {{ section.settings.card_color }};
    --pw-gold: {{ section.settings.gold_color }};
    --pw-ink: {{ section.settings.text_color }};
    --pw-muted: {{ section.settings.muted_color }};
    --pw-stone: #f7f5f1;
  "
>
  <div class="pw-password__glow" aria-hidden="true"></div>

  <div class="pw-password__inner">
    <header class="pw-password__brand">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 480
          | image_tag:
            class: 'pw-password__logo',
            widths: '160, 240, 320, 480',
            sizes: '(max-width: 749px) 160px, 220px',
            alt: shop.name
        }}
      {% else %}
        <p class="pw-password__shop-name">{{ shop.name }}</p>
      {% endif %}
    </header>

    <div class="pw-password__card">
      {% if section.settings.eyebrow != blank %}
        <p class="pw-password__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="pw-password__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="pw-password__sub">{{ section.settings.subheading | escape }}</p>
      {% endif %}

      {% form 'storefront_password', class: 'pw-password__form' %}
        <label class="pw-password__sr" for="PwPasswordInput-{{ section.id }}">Password</label>

        <div class="pw-password__field-row">
          <input
            id="PwPasswordInput-{{ section.id }}"
            class="pw-password__input"
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="{{ section.settings.password_placeholder | escape }}"
            required
          >

          <button class="pw-password__submit" type="submit">
            <span>{{ section.settings.button_label | escape }}</span>
            <span class="pw-password__arrow" aria-hidden="true">→</span>
          </button>
        </div>

        {% if form.errors %}
          <div class="pw-password__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
      {% endform %}

      {% if section.settings.helper_text != blank %}
        <p class="pw-password__helper">{{ section.settings.helper_text | escape }}</p>
      {% endif %}
    </div>

    {% if section.settings.show_newsletter %}
      <div class="pw-password__notify">
        {% if section.settings.newsletter_heading != blank %}
          <p class="pw-password__notify-title">{{ section.settings.newsletter_heading | escape }}</p>
        {% endif %}

        {% form 'customer', class: 'pw-password__notify-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,password-page,primal-win">
          <label class="pw-password__sr" for="PwPasswordEmail-{{ section.id }}">Email</label>
          <div class="pw-password__notify-row">
            <input
              id="PwPasswordEmail-{{ section.id }}"
              class="pw-password__notify-input"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.newsletter_placeholder | escape }}"
              autocomplete="email"
              required
            >
            <button class="pw-password__notify-btn" type="submit">
              {{ section.settings.newsletter_button | escape }}
            </button>
          </div>

          {% if form.posted_successfully? %}
            <p class="pw-password__notify-success">{{ section.settings.newsletter_success | escape }}</p>
          {% endif %}

          {% if form.errors %}
            <div class="pw-password__error">{{ form.errors | default_errors }}</div>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}

    <footer class="pw-password__footer">
      <p class="pw-password__legal">
        <span class="pw-password__legal-left">{{ section.settings.footer_left | escape }}</span>
        {% if section.settings.footer_left != blank and section.settings.footer_right != blank %}
          <span class="pw-password__legal-sep">|</span>
        {% endif %}
        <span class="pw-password__legal-right">{{ section.settings.footer_right | escape }}</span>
      </p>
    </footer>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: 100vh;
    background: var(--pw-bg, #efe5dd);
  }

  body.pw-password-body,
  html {
    margin: 0;
    padding: 0;
    background: {{ section.settings.background_color }};
  }

  #PwPassword-{{ section.id }},
  #PwPassword-{{ section.id }} * {
    box-sizing: border-box;
  }

  #PwPassword-{{ section.id }} {
    position: relative;
    display: flex;
    min-height: 100vh;
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 48px 20px 40px;
    overflow: hidden;
    background: var(--pw-bg, #efe5dd);
    color: var(--pw-ink, #1f2326);
    font-family: Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  #PwPassword-{{ section.id }} .pw-password__glow {
    position: absolute;
    inset: auto auto -20% 50%;
    width: min(900px, 120vw);
    height: min(900px, 120vw);
    transform: translateX(-50%);
    pointer-events: none;
    background: radial-gradient(
      circle,
      rgba(200, 154, 61, 0.18) 0%,
      rgba(200, 154, 61, 0) 62%
    );
  }

  #PwPassword-{{ section.id }} .pw-password__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 560px);
    margin: 0 auto;
    text-align: center;
  }

  #PwPassword-{{ section.id }} .pw-password__brand {
    margin-bottom: 28px;
  }

  #PwPassword-{{ section.id }} .pw-password__logo {
    display: block;
    width: auto;
    height: 54px;
    max-width: 220px;
    margin: 0 auto;
    object-fit: contain;
  }

  #PwPassword-{{ section.id }} .pw-password__shop-name {
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #PwPassword-{{ section.id }} .pw-password__card {
    padding: 36px 28px 32px;
    border: 1px solid rgba(200, 154, 61, 0.35);
    border-radius: 24px;
    background:
      radial-gradient(120% 140% at 20% 0%, rgba(45, 70, 58, 0.35) 0%, transparent 55%),
      linear-gradient(160deg, #1b2726 0%, var(--pw-card, #1f2326) 100%);
    box-shadow: 0 28px 60px -28px rgba(0, 0, 0, 0.45);
    text-align: center;
  }

  #PwPassword-{{ section.id }} .pw-password__eyebrow {
    margin: 0 0 12px;
    color: var(--pw-gold, #c89a3d);
    font-family: Montserrat, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  #PwPassword-{{ section.id }} .pw-password__heading {
    margin: 0 0 12px;
    color: #ffffff;
    font-family: Montserrat, sans-serif;
    font-size: clamp(28px, 6vw, 40px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.4px;
    text-transform: uppercase;
  }

  #PwPassword-{{ section.id }} .pw-password__sub {
    margin: 0 0 26px;
    color: rgba(247, 245, 241, 0.78);
    font-size: 15px;
    line-height: 1.55;
  }

  #PwPassword-{{ section.id }} .pw-password__form {
    margin: 0;
  }

  #PwPassword-{{ section.id }} .pw-password__sr {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  #PwPassword-{{ section.id }} .pw-password__field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  #PwPassword-{{ section.id }} .pw-password__input {
    width: 100%;
    height: 52px;
    margin: 0;
    padding: 0 18px;
    border: 0;
    border-radius: 10px;
    background: var(--pw-stone);
    color: var(--pw-ink, #1f2326);
    font-family: Inter, sans-serif;
    font-size: 15px;
  }

  #PwPassword-{{ section.id }} .pw-password__input::placeholder {
    color: #858c92;
  }

  #PwPassword-{{ section.id }} .pw-password__input:focus {
    outline: 2px solid var(--pw-gold, #c89a3d);
    outline-offset: 2px;
  }

  #PwPassword-{{ section.id }} .pw-password__submit {
    display: grid;
    grid-template-columns: 1fr 50px;
    width: 100%;
    height: 54px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 10px;
    background: var(--pw-gold, #c89a3d);
    color: #111416;
    cursor: pointer;
    font-family: Montserrat, sans-serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  #PwPassword-{{ section.id }} .pw-password__submit > span:first-child {
    display: grid;
    place-items: center;
    padding: 0 12px;
  }

  #PwPassword-{{ section.id }} .pw-password__arrow {
    display: grid;
    height: 34px;
    margin: auto 0;
    place-items: center;
    border-left: 1px solid rgba(17, 20, 22, 0.28);
    font-family: Inter, sans-serif;
    font-size: 22px;
    font-weight: 400;
  }

  #PwPassword-{{ section.id }} .pw-password__submit:hover {
    filter: brightness(1.06);
  }

  #PwPassword-{{ section.id }} .pw-password__error {
    margin-top: 12px;
    color: #ffb4b4;
    font-size: 13px;
    line-height: 1.4;
    text-align: left;
  }

  #PwPassword-{{ section.id }} .pw-password__error ul {
    margin: 0;
    padding-left: 18px;
  }

  #PwPassword-{{ section.id }} .pw-password__helper {
    margin: 16px 0 0;
    color: rgba(247, 245, 241, 0.55);
    font-size: 12px;
    line-height: 1.45;
  }

  #PwPassword-{{ section.id }} .pw-password__notify {
    margin-top: 22px;
    padding: 20px 18px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(31, 35, 38, 0.08);
  }

  #PwPassword-{{ section.id }} .pw-password__notify-title {
    margin: 0 0 12px;
    color: var(--pw-ink, #1f2326);
    font-family: Montserrat, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  #PwPassword-{{ section.id }} .pw-password__notify-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
  }

  #PwPassword-{{ section.id }} .pw-password__notify-input {
    width: 100%;
    height: 46px;
    margin: 0;
    padding: 0 14px;
    border: 0;
    border-radius: 10px;
    background: #ffffff;
    color: var(--pw-ink, #1f2326);
    font-size: 14px;
  }

  #PwPassword-{{ section.id }} .pw-password__notify-btn {
    height: 46px;
    padding: 0 16px;
    border: 0;
    border-radius: 10px;
    background: var(--pw-ink, #1f2326);
    color: #ffffff;
    cursor: pointer;
    font-family: Montserrat, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #PwPassword-{{ section.id }} .pw-password__notify-success {
    margin: 10px 0 0;
    color: #0b2a1a;
    font-size: 13px;
  }

  #PwPassword-{{ section.id }} .pw-password__footer {
    margin-top: 28px;
  }

  #PwPassword-{{ section.id }} .pw-password__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  #PwPassword-{{ section.id }} .pw-password__legal-left {
    color: var(--pw-ink, #1f2326);
    font-weight: 700;
  }

  #PwPassword-{{ section.id }} .pw-password__legal-sep {
    color: var(--pw-gold, #c89a3d);
    font-weight: 700;
  }

  #PwPassword-{{ section.id }} .pw-password__legal-right {
    color: var(--pw-muted, #737a80);
    font-weight: 600;
  }

  @media screen and (min-width: 750px) {
    #PwPassword-{{ section.id }} .pw-password__card {
      padding: 42px 40px 36px;
    }

    #PwPassword-{{ section.id }} .pw-password__field-row {
      grid-template-columns: 1fr minmax(180px, 220px);
      gap: 10px;
    }

    #PwPassword-{{ section.id }} .pw-password__submit {
      font-size: 13px;
    }
  }

  @media screen and (max-width: 480px) {
    #PwPassword-{{ section.id }} {
      padding: 32px 16px 28px;
    }

    #PwPassword-{{ section.id }} .pw-password__logo {
      height: 44px;
    }

    #PwPassword-{{ section.id }} .pw-password__notify-row {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Primal password",
  "tag": "section",
  "class": "section-pw-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PRIVATE ACCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LAUNCHING SOON"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Enter the store password to unlock Primal Win."
    },
    {
      "type": "text",
      "id": "password_placeholder",
      "label": "Password placeholder",
      "default": "Enter password"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "ENTER STORE"
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Helper text under form",
      "default": "Password is set in Shopify Admin → Online Store → Preferences."
    },
    {
      "type": "header",
      "content": "Newsletter (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "GET LAUNCH UPDATES"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Newsletter button",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "Thanks — you’re on the list."
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "text",
      "id": "footer_left",
      "label": "Footer left",
      "default": "PRIMAL WIN LTD."
    },
    {
      "type": "text",
      "id": "footer_right",
      "label": "Footer right",
      "default": "FOR THOSE WHO WANT TO WIN."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Page background",
      "default": "#EFE5DD"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#1F2326"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold",
      "default": "#C89A3D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1F2326"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#737A80"
    }
  ],
  "presets": [
    {
      "name": "Primal password"
    }
  ]
}
{% endschema %}
