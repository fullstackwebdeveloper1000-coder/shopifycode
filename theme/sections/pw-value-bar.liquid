{% comment %}
  Primal Value Bar — ONE SCOOP / EVERY DAY / BUILT TO WIN
  1440 section / 1280 content (header-aligned). No JS scale.
{% endcomment %}

{% liquid
  assign icon_1_svg_value = section.settings.icon_1_svg | strip
  assign icon_2_svg_value = section.settings.icon_2_svg | strip
  assign icon_3_svg_value = section.settings.icon_3_svg | strip

  assign icon_1_svg_src = ''
  assign icon_2_svg_src = ''
  assign icon_3_svg_src = ''

  if icon_1_svg_value != blank
    if icon_1_svg_value contains '://'
      assign icon_1_svg_src = icon_1_svg_value
    else
      assign icon_1_svg_src = icon_1_svg_value | asset_url
    endif
  endif

  if icon_2_svg_value != blank
    if icon_2_svg_value contains '://'
      assign icon_2_svg_src = icon_2_svg_value
    else
      assign icon_2_svg_src = icon_2_svg_value | asset_url
    endif
  endif

  if icon_3_svg_value != blank
    if icon_3_svg_value contains '://'
      assign icon_3_svg_src = icon_3_svg_value
    else
      assign icon_3_svg_src = icon_3_svg_value | asset_url
    endif
  endif
%}

<section
  id="PwValueBar-{{ section.id }}"
  class="pw-value-bar"
  style="
    --pw-value-bg: {{ section.settings.background_color }};
    --pw-value-text: {{ section.settings.text_color }};
    --pw-value-icon: {{ section.settings.icon_color }};
    --pw-value-divider: {{ section.settings.divider_color }};
  "
>
  <div class="pw-container pw-value-bar__container">
    <div class="pw-value-bar__items" role="list">

      <div class="pw-value-bar__item" role="listitem">
        <span class="pw-value-bar__icon" aria-hidden="true">
          {% if section.settings.icon_1_image != blank %}
            {{
              section.settings.icon_1_image
              | image_url: width: 96
              | image_tag:
                loading: 'lazy',
                widths: '32, 48, 64, 96',
                sizes: '25px',
                width: 25,
                height: 29,
                alt: ''
            }}
          {% elsif icon_1_svg_src != blank %}
            <img
              src="{{ icon_1_svg_src | escape }}"
              alt=""
              width="25"
              height="29"
              loading="lazy"
            >
          {% else %}
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 15.5h12.5c2.8 0 5-2.2 5-5V8.8"/>
              <path d="M6.5 12.5c2.2 0 3.5-1.3 3.5-3.5 0 2.2 1.3 3.5 3.5 3.5"/>
              <path d="M22.5 8.8h4.2"/>
              <path d="M20 18.5h6"/>
            </svg>
          {% endif %}
        </span>
        {% if section.settings.text_1 != blank %}
          <span class="pw-value-bar__text">{{ section.settings.text_1 | escape }}</span>
        {% endif %}
      </div>

      <div class="pw-value-bar__item" role="listitem">
        <span class="pw-value-bar__icon" aria-hidden="true">
          {% if section.settings.icon_2_image != blank %}
            {{
              section.settings.icon_2_image
              | image_url: width: 96
              | image_tag:
                loading: 'lazy',
                widths: '32, 48, 64, 96',
                sizes: '25px',
                width: 25,
                height: 29,
                alt: ''
            }}
          {% elsif icon_2_svg_src != blank %}
            <img
              src="{{ icon_2_svg_src | escape }}"
              alt=""
              width="25"
              height="29"
              loading="lazy"
            >
          {% else %}
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="7" y="6.5" width="18" height="19" rx="2"/>
              <path d="M11 4.5v4M21 4.5v4M7 11h18"/>
              <path d="m11.5 17 2.5 2.5 5.5-6"/>
            </svg>
          {% endif %}
        </span>
        {% if section.settings.text_2 != blank %}
          <span class="pw-value-bar__text">{{ section.settings.text_2 | escape }}</span>
        {% endif %}
      </div>

      <div class="pw-value-bar__item" role="listitem">
        <span class="pw-value-bar__icon" aria-hidden="true">
          {% if section.settings.icon_3_image != blank %}
            {{
              section.settings.icon_3_image
              | image_url: width: 96
              | image_tag:
                loading: 'lazy',
                widths: '32, 48, 64, 96',
                sizes: '25px',
                width: 25,
                height: 29,
                alt: ''
            }}
          {% elsif icon_3_svg_src != blank %}
            <img
              src="{{ icon_3_svg_src | escape }}"
              alt=""
              width="25"
              height="29"
              loading="lazy"
            >
          {% else %}
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5.5h12v5.2c0 4-2.5 7.3-6 8.3-3.5-1-6-4.3-6-8.3V5.5Z"/>
              <path d="M10 8H6.5v2.2c0 2.8 1.8 4.8 4.3 5.3M22 8h3.5v2.2c0 2.8-1.8 4.8-4.3 5.3"/>
              <path d="M16 19v4M11.5 26h9"/>
            </svg>
          {% endif %}
        </span>
        {% if section.settings.text_3 != blank %}
          <span class="pw-value-bar__text">{{ section.settings.text_3 | escape }}</span>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&display=swap');

  #PwValueBar-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwValueBar-{{ section.id }},
  #PwValueBar-{{ section.id }} *,
  #PwValueBar-{{ section.id }} *::before,
  #PwValueBar-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PwValueBar-{{ section.id }} {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--pw-value-bg, #efe5dd);
    color: var(--pw-value-text, #1f2326);
    font-family: Montserrat, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* 1280 content + gutters — same as header / trust bar */
  #PwValueBar-{{ section.id }} .pw-container.pw-value-bar__container {
    width: 100%;
    max-width: var(--pw-inner);
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
  }

  #PwValueBar-{{ section.id }} .pw-value-bar__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    width: 100%;
    max-width: 984px;
    min-height: 72px;
    margin-inline: auto;
    padding: 0;
  }

  #PwValueBar-{{ section.id }} .pw-value-bar__item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 0;
    min-height: 29px;
    margin: 0;
    padding: 0 12px;
  }

  #PwValueBar-{{ section.id }} .pw-value-bar__item + .pw-value-bar__item::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 1px;
    height: 27px;
    transform: translateY(-50%);
    background: var(--pw-value-divider, #d8d3cd);
  }

  #PwValueBar-{{ section.id }} .pw-value-bar__icon {
    display: grid;
    flex: 0 0 25px;
    place-items: center;
    width: 25px;
    height: 29px;
    margin: 0;
    color: var(--pw-value-icon, #c89a3d);
  }

  #PwValueBar-{{ section.id }} .pw-value-bar__icon img,
  #PwValueBar-{{ section.id }} .pw-value-bar__icon svg {
    display: block;
    width: 25px;
    height: 29px;
    max-width: 25px;
    max-height: 29px;
    object-fit: contain;
  }

  #PwValueBar-{{ section.id }} .pw-value-bar__icon svg {
    fill: none;
    stroke: currentColor;
  }

  #PwValueBar-{{ section.id }} .pw-value-bar__text {
    display: block;
    margin: 0;
    color: var(--pw-value-text, #1f2326);
    font-family: Montserrat, system-ui, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 800;
    line-height: 18px;
    letter-spacing: 0;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Tablet */
  @media screen and (max-width: 989px) {
    #PwValueBar-{{ section.id }} .pw-value-bar__items {
      max-width: none;
      min-height: 68px;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__item {
      gap: 10px;
      padding: 0 10px;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__text {
      font-size: 13px;
      line-height: 16px;
    }
  }

  /* Small tablet / large phone landscape */
  @media screen and (max-width: 749px) {
    #PwValueBar-{{ section.id }} .pw-value-bar__items {
      min-height: 64px;
      gap: 0;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__item {
      gap: 6px;
      padding: 0 6px;
      justify-content: center;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__item + .pw-value-bar__item::before {
      height: 24px;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__icon {
      flex-basis: 18px;
      width: 18px;
      height: 20px;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__icon img,
    #PwValueBar-{{ section.id }} .pw-value-bar__icon svg {
      width: 18px;
      height: 20px;
      max-width: 18px;
      max-height: 20px;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__text {
      font-size: clamp(9px, 2.6vw, 12px);
      line-height: 1.15;
      white-space: normal;
      text-align: left;
    }
  }

  /* Narrow phones: stack vertically */
  @media screen and (max-width: 480px) {
    #PwValueBar-{{ section.id }} .pw-value-bar__items {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 10px 0;
      gap: 0;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__item {
      min-height: 44px;
      padding: 10px 4px;
      justify-content: flex-start;
      gap: 12px;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__item + .pw-value-bar__item::before {
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      height: 1px;
      transform: none;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__icon {
      flex-basis: 22px;
      width: 22px;
      height: 24px;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__icon img,
    #PwValueBar-{{ section.id }} .pw-value-bar__icon svg {
      width: 22px;
      height: 24px;
      max-width: 22px;
      max-height: 24px;
    }

    #PwValueBar-{{ section.id }} .pw-value-bar__text {
      font-size: 13px;
      line-height: 16px;
      white-space: nowrap;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Primal Value Bar",
  "tag": "section",
  "class": "pw-value-bar-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#EFE5DD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#1F2326"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#C89A3D"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider colour",
      "default": "#D8D3CD"
    },
    {
      "type": "header",
      "content": "Item 1 — One Scoop"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Text",
      "default": "ONE SCOOP."
    },
    {
      "type": "image_picker",
      "id": "icon_1_image",
      "label": "Icon 1 image"
    },
    {
      "type": "text",
      "id": "icon_1_svg",
      "label": "Icon 1 SVG URL",
      "info": "Files URL or Assets filename."
    },
    {
      "type": "header",
      "content": "Item 2 — Every Day"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text",
      "default": "EVERY DAY."
    },
    {
      "type": "image_picker",
      "id": "icon_2_image",
      "label": "Icon 2 image"
    },
    {
      "type": "text",
      "id": "icon_2_svg",
      "label": "Icon 2 SVG URL",
      "info": "Files URL or Assets filename."
    },
    {
      "type": "header",
      "content": "Item 3 — Built To Win"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text",
      "default": "BUILT TO WIN."
    },
    {
      "type": "image_picker",
      "id": "icon_3_image",
      "label": "Icon 3 image"
    },
    {
      "type": "text",
      "id": "icon_3_svg",
      "label": "Icon 3 SVG URL",
      "info": "Files URL or Assets filename."
    }
  ],
  "presets": [
    {
      "name": "Primal Value Bar"
    }
  ]
}
{% endschema %}
