<section id="PwStoryHero-{{ section.id }}" class="band band-dark story-hero">
  <div class="container band-in">
    <div class="band-copy">
      <h1 class="story-title">Our <span class="gold">Story</span></h1>

      <hr class="band-rule">

      <p class="band-lead">We work in healthcare.</p>

      <p class="body story-body">
        We&apos;ve seen what most supplements actually deliver.<br>
        Not much. Impressive labels. Underwhelming doses.<br>
        Products built to look comprehensive, not to work.
      </p>

      <p class="story-close">So we built our own.</p>
    </div>
  </div>

  <div class="band-media" aria-hidden="false">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          class: 'band-img',
          loading: 'eager',
          alt: 'Two clinical researchers reviewing formulation notes',
          width: section.settings.image.width,
          height: section.settings.image.height,
          widths: '900, 1200, 1800',
          sizes: '(max-width: 860px) 100vw, 50vw'
      }}
    {%- elsif section.settings.fallback_image_url != blank -%}
      <img
        class="band-img"
        src="{{ section.settings.fallback_image_url }}"
        alt="Two clinical researchers reviewing formulation notes"
        loading="eager"
        width="900"
        height="520"
      >
    {%- endif -%}
    <span class="band-media__fade band-media__fade--top" aria-hidden="true"></span>
    <span class="band-media__fade band-media__fade--bottom" aria-hidden="true"></span>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap');

  #PwStoryHero-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    max-width: none !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwStoryHero-{{ section.id }},
  #PwStoryHero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #PwStoryHero-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: none;
    height: auto;
    min-height: 0;
    aspect-ratio: 1440.668212890625 / 675.4379272460938;
    margin: 0;
    overflow: hidden;
    background: #071811;
    color: #ffffff;
    font-family: Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PwStoryHero-{{ section.id }} .container {
    width: 100%;
    max-width: var(--pw-max);
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
  }

  #PwStoryHero-{{ section.id }} .band-in {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 54px;
  }

  #PwStoryHero-{{ section.id }} .band-copy {
    width: 100%;
    max-width: 540px;
  }

  /* Desktop: image sits on the right inside the hero frame */
  #PwStoryHero-{{ section.id }} .band-media {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    bottom: 0;
    width: 54%;
    overflow: hidden;
    pointer-events: none;
  }

  #PwStoryHero-{{ section.id }} .band-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center center;
    display: block;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    /* Figma: dark left → photo soft feather (not a hard cut) */
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.08) 10%,
      rgba(0, 0, 0, 0.35) 20%,
      rgba(0, 0, 0, 0.72) 32%,
      #000000 44%,
      #000000 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.08) 10%,
      rgba(0, 0, 0, 0.35) 20%,
      rgba(0, 0, 0, 0.72) 32%,
      #000000 44%,
      #000000 100%
    );
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* Desktop uses side mask; top/bottom fades reserved for stacked layout */
  #PwStoryHero-{{ section.id }} .band-media__fade {
    display: none;
  }

  #PwStoryHero-{{ section.id }} .band-rule {
    width: 56px;
    height: 3px;
    background: #c89a3d;
    border: 0;
    margin: 0;
  }

  #PwStoryHero-{{ section.id }} .band-lead,
  #PwStoryHero-{{ section.id }} .story-close {
    display: block;
    width: 100%;
    max-width: 540px;
    min-height: 0;
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 800;
    color: #c89a3d;
  }

  #PwStoryHero-{{ section.id }} .band-lead {
    margin: 36px 0 22px;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: 0.2px;
  }

  #PwStoryHero-{{ section.id }} p.body {
    width: 100%;
    max-width: 520px;
    margin: 0;
    color: #ffffff;
    font-family: Inter, system-ui, sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 17px;
    line-height: 1.72;
    letter-spacing: 0;
  }

  #PwStoryHero-{{ section.id }} .story-body br {
    display: block;
  }

  #PwStoryHero-{{ section.id }} .gold {
    color: #c89a3d;
  }

  #PwStoryHero-{{ section.id }} .story-title {
    display: block;
    width: auto;
    max-width: 100%;
    min-height: 0;
    margin: 0 0 24px;
    color: #ffffff;
    font-family: Montserrat, system-ui, sans-serif;
    font-style: normal;
    font-weight: 900;
    font-size: 78px;
    line-height: 0.96;
    letter-spacing: -0.8px;
    white-space: nowrap;
    text-transform: uppercase;
  }

  #PwStoryHero-{{ section.id }} .story-close {
    margin: 24px 0 0;
    font-size: 20px;
    line-height: 1.2;
    text-transform: none;
  }

  @media screen and (max-width: 1200px) {
    #PwStoryHero-{{ section.id }} .story-title {
      font-size: clamp(62px, 6.5vw, 78px);
    }
  }

  @media screen and (max-width: 1080px) {
    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 62px;
      line-height: 1;
    }

    #PwStoryHero-{{ section.id }} p.body {
      font-size: 16px;
      line-height: 1.7;
    }

    #PwStoryHero-{{ section.id }} .band-media {
      width: 50%;
    }
  }

  /*
    Tablet + phones: content on TOP, image BELOW.
    Top + bottom background gradients blend photo into #071811.
  */
  @media screen and (max-width: 860px) {
    #PwStoryHero-{{ section.id }} {
      display: flex;
      flex-direction: column;
      height: auto;
      min-height: 0;
      aspect-ratio: auto;
    }

    #PwStoryHero-{{ section.id }} .band-in {
      position: relative;
      z-index: 2;
      flex: 0 0 auto;
      height: auto;
      min-height: 0;
      justify-content: flex-start;
      padding-top: 56px;
      padding-bottom: 28px;
    }

    #PwStoryHero-{{ section.id }} .band-copy {
      max-width: none;
      padding-bottom: 0;
    }

    #PwStoryHero-{{ section.id }} .band-media {
      position: relative;
      z-index: 1;
      top: auto;
      right: auto;
      bottom: auto;
      flex: 0 0 auto;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      min-height: 240px;
      max-height: none;
      pointer-events: auto;
    }

    #PwStoryHero-{{ section.id }} .band-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      object-fit: cover;
      object-position: center 40%;
      -webkit-mask-image: none;
      mask-image: none;
    }

    #PwStoryHero-{{ section.id }} .band-media__fade {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      z-index: 2;
      pointer-events: none;
    }

    #PwStoryHero-{{ section.id }} .band-media__fade--top {
      top: 0;
      height: 42%;
      background: linear-gradient(
        180deg,
        #071811 0%,
        rgba(7, 24, 17, 0.82) 28%,
        rgba(7, 24, 17, 0.35) 62%,
        rgba(7, 24, 17, 0) 100%
      );
    }

    #PwStoryHero-{{ section.id }} .band-media__fade--bottom {
      bottom: 0;
      height: 38%;
      background: linear-gradient(
        0deg,
        #071811 0%,
        rgba(7, 24, 17, 0.78) 30%,
        rgba(7, 24, 17, 0.3) 64%,
        rgba(7, 24, 17, 0) 100%
      );
    }

    #PwStoryHero-{{ section.id }} p.body {
      width: 100%;
      max-width: none;
      font-size: 19px;
      line-height: 1.6;
    }

    #PwStoryHero-{{ section.id }} .story-body br {
      display: none;
    }

    #PwStoryHero-{{ section.id }} .band-lead,
    #PwStoryHero-{{ section.id }} .story-close {
      width: 100%;
      min-height: 0;
    }

    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 56px;
      white-space: normal;
    }
  }

  @media screen and (max-width: 560px) {
    #PwStoryHero-{{ section.id }} .container {
      padding-inline: var(--pw-gutter);
    }

    #PwStoryHero-{{ section.id }} .band-in {
      padding-top: 44px;
      padding-bottom: 20px;
    }

    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 44px;
      line-height: 1;
      margin-bottom: 18px;
    }

    #PwStoryHero-{{ section.id }} .band-lead {
      margin-top: 28px;
      margin-bottom: 18px;
      font-size: 18px;
    }

    #PwStoryHero-{{ section.id }} p.body {
      font-size: 17px;
      line-height: 1.6;
    }

    #PwStoryHero-{{ section.id }} .story-close {
      margin-top: 22px;
      font-size: 19px;
    }

    #PwStoryHero-{{ section.id }} .band-media {
      aspect-ratio: 4 / 3;
      min-height: 200px;
    }

    #PwStoryHero-{{ section.id }} .band-media__fade--top {
      height: 36%;
    }

    #PwStoryHero-{{ section.id }} .band-media__fade--bottom {
      height: 32%;
    }
  }

  @media screen and (max-width: 380px) {
    #PwStoryHero-{{ section.id }} .band-in {
      padding-top: 36px;
      padding-bottom: 16px;
    }

    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 38px;
    }

    #PwStoryHero-{{ section.id }} .band-lead {
      margin-top: 22px;
      font-size: 17px;
    }

    #PwStoryHero-{{ section.id }} p.body {
      font-size: 15px;
      line-height: 1.55;
    }

    #PwStoryHero-{{ section.id }} .story-close {
      font-size: 17px;
    }

    #PwStoryHero-{{ section.id }} .band-media {
      aspect-ratio: 5 / 4;
      min-height: 180px;
    }
  }

  @media screen and (max-width: 320px) {
    #PwStoryHero-{{ section.id }} .story-title {
      font-size: 34px;
    }

    #PwStoryHero-{{ section.id }} p.body {
      font-size: 14px;
    }

    #PwStoryHero-{{ section.id }} .band-media {
      min-height: 160px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Story Hero",
  "tag": "section",
  "class": "pw-story-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (upload doctors.png)"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Or paste image URL"
    }
  ],
  "presets": [
    {
      "name": "Story Hero"
    }
  ]
}
{% endschema %}
