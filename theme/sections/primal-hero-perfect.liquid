{% style %}
  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background: {{ section.settings.background_color }} !important;
    overflow: hidden !important;
  }

  #PrimalHeroPerfect-{{ section.id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    background: {{ section.settings.background_color }};
    overflow: hidden;
  }

  #PrimalHeroPerfect-{{ section.id }} *,
  #PrimalHeroPerfect-{{ section.id }} *::before,
  #PrimalHeroPerfect-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: {{ section.settings.background_color }};
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 1440px;
    height: {{ section.settings.section_height }}px;
    margin: 0 auto;
    padding: 0;
    overflow: hidden;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-bg-image {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    width: 68%;
    height: 100%;
    overflow: hidden;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-bg-image .primal-hero-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: right 45%;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-bg-image::before {
    content: "";
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: 0;
    width: 28%;
    pointer-events: none;
    background: linear-gradient(90deg, {{ section.settings.background_color }} 0%, rgba(250, 248, 245, 0) 100%);
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-text-col {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 48%;
    margin: 0;
    padding: 0 10px 0 75px;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-kicker {
    margin: 0 0 15px;
    color: #C89A3D;
    font-family: Montserrat, sans-serif;
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-heading {
    margin: 0 0 20px;
    color: #1F2326;
    font-family: Montserrat, sans-serif;
    font-weight: 900;
    font-size: 82px;
    line-height: 86px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-heading .gold {
    color: #C89A3D;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-divider {
    display: block;
    width: 64px;
    height: 3px;
    margin: 0 0 25px;
    border: 0;
    background: #C89A3D;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-sub1 {
    margin: 0 0 15px;
    color: #1F2326;
    font-family: Montserrat, sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 29.7px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-sub2 {
    margin: 0 0 35px;
    color: #C89A3D;
    font-family: Montserrat, sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 1;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-btn-row {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-btn-main {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 52px;
    padding: 0 26px;
    border: 0;
    border-radius: 10px;
    background: #C89A3D;
    color: #1F2326;
    font-family: Montserrat, sans-serif;
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 1.5px;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.3s ease;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-btn-main:hover {
    background: #B4842E;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-play-wrap {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: #1F2326;
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-play-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    border: 1px solid #1F2326;
    border-radius: 50%;
    background: transparent;
    color: #1F2326;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-play-btn svg {
    display: block;
    width: 15.82px;
    height: 20.14px;
    margin-left: 3px;
  }

  #PrimalHeroPerfect-{{ section.id }} .primal-play-text {
    color: #1F2326;
    font-family: Montserrat, sans-serif;
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media screen and (max-width: 989px) {
    #PrimalHeroPerfect-{{ section.id }} {
      padding-top: 0;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-container {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      height: auto !important;
      min-height: 0;
      /* Clear sticky site header so content isn't cropped */
      padding: max(72px, calc(env(safe-area-inset-top, 0px) + 56px)) 0 24px;
      overflow: visible;
    }

    /* CONTENT first */
    #PrimalHeroPerfect-{{ section.id }} .primal-text-col {
      order: 1;
      position: relative;
      z-index: 3;
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0 clamp(16px, 4.5vw, 34px) 20px;
    }

    /* MOCKUP below — full product, no crop */
    #PrimalHeroPerfect-{{ section.id }} .primal-bg-image {
      order: 2;
      position: relative !important;
      top: auto !important;
      right: auto !important;
      bottom: auto !important;
      left: auto !important;
      z-index: 1;
      width: 100% !important;
      height: auto !important;
      min-height: 0;
      margin: 0;
      padding: 0 clamp(8px, 2vw, 16px);
      overflow: visible;
      aspect-ratio: auto;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-bg-image::before {
      display: none !important;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-bg-image .primal-hero-image {
      display: block;
      width: 100%;
      max-width: 560px;
      height: auto !important;
      margin: 0 auto;
      object-fit: contain !important;
      object-position: center bottom !important;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-heading {
      font-size: clamp(42px, 7vw, 54px);
      line-height: 1.05;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-btn-row {
      flex-wrap: wrap;
      gap: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    #PrimalHeroPerfect-{{ section.id }} .primal-container {
      padding: 22px 0 18px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-text-col {
      padding: 0 16px 18px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-kicker {
      font-size: 11px;
      letter-spacing: 2px;
      margin-bottom: 12px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-heading {
      font-size: clamp(34px, 9.5vw, 40px);
      line-height: 1.05;
      margin-bottom: 16px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-divider {
      margin-bottom: 18px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-sub1,
    #PrimalHeroPerfect-{{ section.id }} .primal-sub2 {
      font-size: 16px;
      line-height: 1.35;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-sub2 {
      margin-bottom: 24px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-btn-main {
      height: 48px;
      padding: 0 20px;
      font-size: 12px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-bg-image {
      padding: 0 10px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-bg-image .primal-hero-image {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 480px) {
    #PrimalHeroPerfect-{{ section.id }} .primal-heading {
      font-size: clamp(30px, 9vw, 36px);
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-sub1,
    #PrimalHeroPerfect-{{ section.id }} .primal-sub2 {
      font-size: 15px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-play-text {
      letter-spacing: 1.2px;
      font-size: 12px;
    }
  }

  @media screen and (max-width: 360px) {
    #PrimalHeroPerfect-{{ section.id }} .primal-text-col {
      padding: 0 12px 14px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-heading {
      font-size: 28px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-btn-main {
      width: 100%;
      height: 46px;
      font-size: 11px;
    }

    #PrimalHeroPerfect-{{ section.id }} .primal-btn-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
{% endstyle %}

<div id="PrimalHeroPerfect-{{ section.id }}">
  <div class="primal-wrapper">
    <div class="primal-container">
      <div class="primal-text-col">
        {%- if section.settings.kicker != blank -%}
          <p class="primal-kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}

        <h1 class="primal-heading">
          {{- section.settings.heading | escape | newline_to_br -}}
          {%- if section.settings.heading_accent != blank -%}
            <br><span class="gold">{{ section.settings.heading_accent | escape }}</span>
          {%- endif -%}
        </h1>

        <hr class="primal-divider">

        {%- if section.settings.subheading_1 != blank -%}
          <p class="primal-sub1">{{ section.settings.subheading_1 | escape | newline_to_br }}</p>
        {%- endif -%}

        {%- if section.settings.subheading_2 != blank -%}
          <p class="primal-sub2">{{ section.settings.subheading_2 | escape }}</p>
        {%- endif -%}

        <div class="primal-btn-row">
          {%- if section.settings.cta_label != blank -%}
            <a class="primal-btn-main" href="{{ section.settings.cta_link | default: '/pages/get-primal-win' }}">
              {{ section.settings.cta_label | escape }}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.video_url != blank and section.settings.video_label != blank -%}
            <button type="button" class="primal-play-wrap" data-pw-video-open>
              <span class="primal-play-btn">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </span>
              <span class="primal-play-text">{{ section.settings.video_label | escape }}</span>
            </button>
          {%- endif -%}
        </div>
      </div>

      <div class="primal-bg-image">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              class: 'primal-hero-image',
              widths: '600,800,1000,1200,1500,1800',
              sizes: '(min-width: 990px) 68vw, 100vw',
              alt: section.settings.image.alt,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if section.settings.video_url != blank -%}
  <div class="pw-hero__modal" id="PwHeroVideo-{{ section.id }}" hidden>
    <div class="pw-hero__modal-overlay" data-pw-video-close></div>
    <div class="pw-hero__modal-inner" role="dialog" aria-modal="true" aria-label="{{ section.settings.video_label | escape }}">
      <button type="button" class="pw-hero__modal-close" data-pw-video-close aria-label="Close video">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/>
        </svg>
      </button>
      <div data-pw-video-target></div>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var modal = document.getElementById('PwHeroVideo-{{ section.id }}');
      var opener = root.querySelector('[data-pw-video-open]');
      if (!modal || !opener) return;
      var target = modal.querySelector('[data-pw-video-target]');
      var embed = {{ section.settings.video_url.type | json }};
      var videoId = {{ section.settings.video_url.id | json }};
      function src() {
        return embed === 'youtube'
          ? 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0'
          : 'https://player.vimeo.com/video/' + videoId + '?autoplay=1';
      }
      function open() {
        target.innerHTML = '<iframe src="' + src() + '" title="{{ section.settings.video_label | escape }}" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>';
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function close() {
        modal.hidden = true;
        target.innerHTML = '';
        document.body.style.overflow = '';
      }
      opener.addEventListener('click', open);
      modal.querySelectorAll('[data-pw-video-close]').forEach(function (el) { el.addEventListener('click', close); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Primal hero perfect",
  "tag": "section",
  "class": "section-primal-hero-perfect",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FAF8F5" },
    { "type": "range", "id": "section_height", "label": "Section height (desktop)", "min": 560, "max": 720, "step": 10, "unit": "px", "default": 620 },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Clean Ingredients. Real Results." },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "For Those\nWho Want" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "To Win." },
    { "type": "textarea", "id": "subheading_1", "label": "Subheading 1", "default": "More energy. Sharper focus.\nStronger body. Unstoppable you." },
    { "type": "text", "id": "subheading_2", "label": "Subheading 2", "default": "One scoop. Every day." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get Primal Win" },
    { "type": "url", "id": "cta_link", "label": "Button link", "default": "/pages/get-primal-win" },
    { "type": "text", "id": "video_label", "label": "Video label", "default": "Watch Video" },
    { "type": "video_url", "id": "video_url", "label": "Video", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Primal hero perfect" }]
}
{% endschema %}
