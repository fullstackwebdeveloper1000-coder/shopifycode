{% liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign image_alt = section.settings.image.alt | default: section.settings.heading
%}

<section
  id="PrimalCollectiveExact-{{ section.id }}"
  class="primal-collective-exact"
  style="
    --pce-bg: {{ section.settings.background_color }};
    --pce-text: {{ section.settings.text_color }};
    --pce-gold: {{ section.settings.gold_color }};
  "
>
  <div class="pce__wrap">
    <div class="pce-copy">
      {% if section.settings.eyebrow != blank %}
        <p class="pce-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pce-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="pce-description">{{ section.settings.description | escape }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="pce-button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <div class="pce-media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'pce-image',
            widths: '640, 900, 1200, 1600, 2000, 2400',
            sizes: '(max-width: 1024px) 100vw, 70vw',
            loading: 'lazy',
            alt: image_alt
        }}
      {% else %}
        <div class="pce-placeholder">
          <span>Upload the Primal Collective athlete strip</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #PrimalCollectiveExact-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: var(--pce-bg, #050606) !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PrimalCollectiveExact-{{ section.id }},
  #PrimalCollectiveExact-{{ section.id }} *,
  #PrimalCollectiveExact-{{ section.id }} *::before,
  #PrimalCollectiveExact-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PrimalCollectiveExact-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    background: var(--pce-bg, #050606);
    color: var(--pce-text, #ffffff);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /*
    DESKTOP / FIGMA (1440)
    - Copy sits on the 1440 content line (left gutter)
    - Athlete strip bleeds to the right viewport edge
    - Full image always visible (no crop / no fixed min-height)
  */
  #PrimalCollectiveExact-{{ section.id }} .pce__wrap {
    display: grid;
    grid-template-columns: minmax(240px, 296px) minmax(0, 1fr);
    gap: clamp(20px, 2vw, 30px);
    align-items: center;
    width: 100%;
    max-width: none;
    min-height: 0;
    margin: 0;
    padding-left: max(
      20px,
      calc((100% - var(--pw-frame, 1440px)) / 2 + var(--pw-gutter, 48px))
    );
    padding-right: 0;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-copy {
    display: flex;
    min-width: 0;
    padding: 48px 0;
    flex-direction: column;
    justify-content: center;
    align-self: center;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
    margin: 0;
    max-width: 18ch;
    color: var(--pce-gold, #c89a3d);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 15px;
    line-height: 24px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-heading {
    width: 100%;
    max-width: 11ch;
    margin: 28px 0 0;
    color: var(--pce-text, #ffffff);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 44px;
    line-height: 0.95;
    letter-spacing: 0;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-description {
    width: 100%;
    max-width: 32ch;
    margin: 22px 0 0;
    color: var(--pce-text, #ffffff);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-style: {{ body_font.style }};
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    overflow-wrap: anywhere;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button {
    display: inline-flex;
    width: max-content;
    max-width: 100%;
    min-height: 49px;
    margin-top: 24px;
    padding: 14px 16px 14px 12px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--pce-gold, #c89a3d);
    border-radius: 8px;
    background: transparent;
    color: var(--pce-gold, #c89a3d);
    text-decoration: none;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button:hover,
  #PrimalCollectiveExact-{{ section.id }} .pce-button:focus-visible {
    background: var(--pce-gold, #c89a3d);
    color: #050606;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button[aria-disabled='true'] {
    cursor: default;
    pointer-events: none;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-media {
    position: relative;
    min-width: 0;
    width: 100%;
    height: auto;
    overflow: visible;
    background: var(--pce-bg, #050606);
    align-self: center;
  }

  /* NEVER crop — full strip (heads + captions) always visible */
  #PrimalCollectiveExact-{{ section.id }} .pce-image,
  #PrimalCollectiveExact-{{ section.id }} img.pce-image {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    max-height: none !important;
    object-fit: contain !important;
    object-position: center right !important;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-placeholder {
    display: grid;
    width: 100%;
    aspect-ratio: 978 / 434;
    min-height: 0;
    place-items: center;
    padding: 24px;
    border: 1px dashed rgba(200, 154, 61, 0.45);
    color: var(--pce-gold, #c89a3d);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-size: 14px;
    text-align: center;
  }

  /* iPad Pro landscape / laptop — still side-by-side, slightly tighter copy */
  @media screen and (max-width: 1366px) and (min-width: 1025px) {
    #PrimalCollectiveExact-{{ section.id }} .pce__wrap {
      grid-template-columns: minmax(220px, 260px) minmax(0, 1fr);
      gap: 24px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      padding: 40px 0;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      font-size: clamp(34px, 3.2vw, 40px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      font-size: 15px;
      line-height: 22px;
    }
  }

  /*
    iPad / iPad Pro portrait / phone
    Stack copy above image. Image is full-width, natural height —
    all six athletes stay visible, nothing cropped.
  */
  @media screen and (max-width: 1024px) {
    #PrimalCollectiveExact-{{ section.id }} .pce__wrap {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      min-height: 0;
      padding-left: 0;
      padding-right: 0;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: clamp(36px, 5vw, 52px) var(--pw-gutter, 34px) clamp(24px, 4vw, 36px);
      justify-content: flex-start;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
      font-size: clamp(12px, 1.5vw, 14px);
      line-height: 1.45;
      letter-spacing: clamp(1.6px, 0.25vw, 2.2px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      max-width: 12ch;
      margin-top: 16px;
      font-size: clamp(34px, 5.5vw, 44px);
      line-height: 0.96;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      max-width: 42ch;
      margin-top: 16px;
      font-size: clamp(14px, 2vw, 16px);
      line-height: 1.5;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-button {
      margin-top: 20px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media {
      width: 100%;
      overflow: visible;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-image,
    #PrimalCollectiveExact-{{ section.id }} img.pce-image {
      width: 100% !important;
      height: auto !important;
      max-width: 100% !important;
      object-fit: contain !important;
      object-position: center center !important;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-placeholder {
      width: 100%;
      aspect-ratio: 978 / 434;
    }
  }

  /* Phone */
  @media screen and (max-width: 749px) {
    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      padding: 32px var(--pw-gutter, 20px) 22px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      max-width: 100%;
      font-size: clamp(28px, 8.5vw, 40px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      max-width: 100%;
      font-size: 14px;
      line-height: 1.5;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-button {
      min-height: 46px;
      margin-top: 18px;
      font-size: 11px;
      letter-spacing: 0.06em;
    }
  }

  @media screen and (max-width: 429px) {
    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      padding: 28px var(--pw-gutter, 16px) 18px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
      font-size: 11px;
      letter-spacing: 1.6px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      font-size: 28px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      font-size: 13px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Primal Collective",
  "tag": "section",
  "class": "section-primal-collective-exact",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Athlete strip image",
      "info": "Upload athlete strip (~978×434 or wider). Desktop: full strip bleeds to the right edge. Tablet/phone: full strip scales — no crop."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Gold top line",
      "default": "Trusted By Those Who Demand More"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Primal Collective"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Elite athletes. Everyday winners. Different journeys. Same mindset."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Meet The Primal Collective"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "montserrat_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#050606"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Brand gold",
      "default": "#C89A3D"
    }
  ],
  "presets": [
    {
      "name": "Primal Collective"
    }
  ]
}
{% endschema %}
