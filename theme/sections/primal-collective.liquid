{% liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign image_alt = section.settings.image.alt | default: section.settings.heading
%}

<section
  id="PrimalCollectiveExact-{{ section.id }}"
  class="primal-collective-exact"
  style="
    --pce-bg: {{ section.settings.background_color }};
    --pce-text: {{ section.settings.text_color }};
    --pce-gold: {{ section.settings.gold_color }};
  "
>
  <div class="pce__shell">
    <div class="pw-container pce__grid">
      <div class="pce-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="pce-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="pce-heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="pce-description">{{ section.settings.description | escape }}</p>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="pce-button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            <span>{{ section.settings.button_label | escape }}</span>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4"/>
            </svg>
          </a>
        {% endif %}
      </div>

      <div class="pce-media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              class: 'pce-image',
              widths: '640, 900, 1200, 1600, 2000, 2400',
              sizes: '(max-width: 899px) 100vw, calc(100vw - 326px)',
              loading: 'lazy',
              alt: image_alt
          }}
        {% else %}
          <div class="pce-placeholder">
            <span>Upload the Primal Collective athlete strip</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #PrimalCollectiveExact-{{ section.id }} {
    {% render 'pw-align-vars' %}
    --pce-copy-width: 296px;
    --pce-copy-gap: 30px;
    --pce-bleed-right: max(0px, (100vw - var(--pw-max)) / 2);
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: var(--pce-bg, #050606) !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PrimalCollectiveExact-{{ section.id }},
  #PrimalCollectiveExact-{{ section.id }} *,
  #PrimalCollectiveExact-{{ section.id }} *::before,
  #PrimalCollectiveExact-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PrimalCollectiveExact-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    background: var(--pce-bg, #050606);
    color: var(--pce-text, #fff);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce__shell {
    width: 100%;
    overflow: visible;
  }

  /*
    Figma web (1440):
    - copy on the same content line as the header logo
    - 296px copy + 30px gap
    - athlete strip fills remaining width and bleeds to the viewport right edge
    - section height follows the image — never crop heads
  */
  #PrimalCollectiveExact-{{ section.id }} .pw-container.pce__grid {
    display: grid;
    grid-template-columns: var(--pce-copy-width) minmax(0, 1fr);
    gap: var(--pce-copy-gap);
    align-items: center;
    width: 100%;
    max-width: var(--pw-max);
    margin-inline: auto;
    padding-left: var(--pw-gutter);
    padding-right: 0;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-copy {
    display: flex;
    width: 100%;
    min-width: 0;
    padding: 71px 0 40px;
    flex-direction: column;
    justify-content: flex-start;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
    margin: 0;
    color: var(--pce-gold, #c89a3d);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 15px;
    line-height: 24px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-heading {
    width: 100%;
    max-width: 296px;
    margin: 38px 0 0;
    color: var(--pce-text, #fff);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 44px;
    line-height: 41.8px;
    letter-spacing: 0;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-description {
    width: 100%;
    max-width: 280px;
    margin: 28px 0 0;
    color: var(--pce-text, #fff);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-style: {{ body_font.style }};
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    overflow-wrap: anywhere;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button {
    display: inline-flex;
    width: min(100%, 292px);
    height: 49px;
    margin-top: 24px;
    padding: 0 14px 0 10px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--pce-gold, #c89a3d);
    border-radius: 8px;
    background: transparent;
    color: var(--pce-gold, #c89a3d);
    text-decoration: none;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button:hover,
  #PrimalCollectiveExact-{{ section.id }} .pce-button:focus-visible {
    background: var(--pce-gold, #c89a3d);
    color: #050606;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button[aria-disabled='true'] {
    cursor: default;
    pointer-events: none;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-media {
    position: relative;
    min-width: 0;
    width: calc(100% + var(--pce-bleed-right));
    margin-right: calc(-1 * var(--pce-bleed-right));
    overflow: visible;
    background: var(--pce-bg, #050606);
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-image,
  #PrimalCollectiveExact-{{ section.id }} img.pce-image {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: contain !important;
    object-position: left center !important;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-placeholder {
    display: grid;
    width: 100%;
    aspect-ratio: 978 / 434;
    place-items: center;
    padding: 24px;
    border: 1px dashed rgba(200, 154, 61, 0.45);
    color: var(--pce-gold, #c89a3d);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-size: 14px;
    text-align: center;
  }

  /* Laptop / iPad Pro landscape — keep Figma two-column, scale type only */
  @media screen and (max-width: 1199px) and (min-width: 900px) {
    #PrimalCollectiveExact-{{ section.id }} {
      --pce-copy-width: min(260px, 28vw);
      --pce-copy-gap: 20px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      padding: 48px 0 36px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      font-size: clamp(32px, 3.4vw, 40px);
      line-height: 0.95;
      margin-top: 28px;
    }
  }

  /* iPad portrait / phones — stack, full strip, header gutter */
  @media screen and (max-width: 899px) {
    #PrimalCollectiveExact-{{ section.id }} .pw-container.pce__grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-left: var(--pw-gutter);
      padding-right: var(--pw-gutter);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      max-width: none;
      padding: clamp(36px, 6vw, 56px) 0 clamp(24px, 4vw, 36px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
      font-size: clamp(11px, 1.7vw, 14px);
      line-height: 1.45;
      letter-spacing: clamp(1.5px, 0.3vw, 2.2px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      max-width: 12ch;
      margin-top: 16px;
      font-size: clamp(34px, 6vw, 48px);
      line-height: 0.96;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      max-width: 42ch;
      margin-top: 16px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-button {
      width: max-content;
      max-width: 100%;
      height: auto;
      min-height: 49px;
      margin-top: 20px;
      padding: 14px 16px 14px 12px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media {
      width: calc(100% + (var(--pw-gutter) * 2));
      margin-left: calc(-1 * var(--pw-gutter));
      margin-right: calc(-1 * var(--pw-gutter));
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-image,
    #PrimalCollectiveExact-{{ section.id }} img.pce-image {
      object-position: center center !important;
    }
  }

  @media screen and (max-width: 599px) {
    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      padding: 32px 0 22px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      max-width: 100%;
      font-size: clamp(29px, 9vw, 40px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      max-width: 100%;
      font-size: 14px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-button {
      min-height: 46px;
      font-size: 12px;
    }
  }

  @media screen and (max-width: 429px) {
    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      padding: 28px 0 18px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      font-size: 28px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      font-size: 13px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Primal Collective V3",
  "tag": "section",
  "class": "section-primal-collective-exact",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Athlete strip image",
      "info": "Upload the Figma athlete strip (six portraits in one image). Desktop matches the 1440 web frame and never crops heads."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Gold top line",
      "default": "Trusted By Those Who Demand More"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Primal Collective"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Elite athletes. Everyday winners. Different journeys. Same mindset."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Meet The Primal Collective"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "montserrat_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#050606"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Brand gold",
      "default": "#C89A3D"
    }
  ],
  "presets": [
    {
      "name": "Primal Collective V3"
    }
  ]
}
{% endschema %}
