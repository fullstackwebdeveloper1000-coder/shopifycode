{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading_before = section.settings.heading_before
  assign heading_highlight = section.settings.heading_highlight
  assign heading_after = section.settings.heading_after
  assign subheading = section.settings.subheading
  assign author_name = section.settings.author_name
  assign author_meta = section.settings.author_meta
  assign image_alt = section.settings.image_alt | default: heading_highlight | escape
-%}

<section
  id="PwNutriEdu-{{ section.id }}"
  class="pw-nutri-edu"
  style="
    --pne-bg: {{ section.settings.bg_color }};
    --pne-text: {{ section.settings.text_color }};
    --pne-muted: {{ section.settings.muted_color }};
    --pne-gold: {{ section.settings.gold_color }};
    --pne-rule: {{ section.settings.rule_color }};
  "
>
  <div class="pw-nutri-edu__media" aria-hidden="false">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'pw-nutri-edu__image',
          loading: 'eager',
          alt: image_alt,
          width: section.settings.image.width,
          height: section.settings.image.height,
          widths: '900, 1200, 1600, 2000, 2400',
          sizes: '(max-width: 860px) 100vw, 58vw'
      }}
    {%- elsif section.settings.fallback_image_url != blank -%}
      <img
        class="pw-nutri-edu__image"
        src="{{ section.settings.fallback_image_url | escape }}"
        alt="{{ image_alt }}"
        loading="eager"
        width="826"
        height="760"
      >
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'pw-nutri-edu__image pw-nutri-edu__placeholder' }}
    {%- endif -%}
  </div>

  <div class="pw-nutri-edu__frame">
    <div class="pw-nutri-edu__copy">
      {%- if eyebrow != blank -%}
        <p class="pw-nutri-edu__eyebrow">{{ eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="pw-nutri-edu__heading">
        {%- if heading_before != blank -%}{{ heading_before | escape }} {%- endif -%}
        {%- if heading_highlight != blank -%}
          <span class="pw-nutri-edu__highlight">{{ heading_highlight | escape }}</span>
        {%- endif -%}
        {%- if heading_after != blank -%} {{ heading_after | escape }}{%- endif -%}
      </h1>

      {%- if subheading != blank -%}
        <p class="pw-nutri-edu__sub">
          {{ subheading | escape | newline_to_br }}
        </p>
      {%- endif -%}

      <div class="pw-nutri-edu__author">
        <hr class="pw-nutri-edu__rule" aria-hidden="true">

        <div class="pw-nutri-edu__author-row">
          {%- if section.settings.author_image != blank -%}
            {{
              section.settings.author_image
              | image_url: width: 120
              | image_tag:
                class: 'pw-nutri-edu__avatar',
                loading: 'lazy',
                widths: '48, 72, 96, 120',
                sizes: '48px',
                alt: author_name
            }}
          {%- endif -%}

          <div class="pw-nutri-edu__author-text">
            {%- if author_name != blank -%}
              <p class="pw-nutri-edu__author-name">{{ author_name | escape }}</p>
            {%- endif -%}
            {%- if author_meta != blank -%}
              <p class="pw-nutri-edu__author-meta">{{ author_meta | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap');

  #PwNutriEdu-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: var(--pne-bg, #f9f7f2) !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PwNutriEdu-{{ section.id }},
  #PwNutriEdu-{{ section.id }} *,
  #PwNutriEdu-{{ section.id }} *::before,
  #PwNutriEdu-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /*
   * Desktop locked to Figma 1440 × 698 frame.
   * Copy: 564 × 513 @ left 80 / top 92.5 / gap 16
   * Image: 826.18 × 760 @ left 613.82 / top -7
   */
  #PwNutriEdu-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: none;
    height: auto;
    min-height: 0;
    aspect-ratio: 1440 / 698;
    margin: 0;
    overflow: hidden;
    background: var(--pne-bg, #f9f7f2);
    color: var(--pne-text, #14181c);
    font-family: Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    isolation: isolate;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__frame {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    height: 100%;
    margin-inline: auto;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__copy {
    position: absolute;
    z-index: 3;
    top: calc(92.5 / 698 * 100%);
    left: 80px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 564px;
    max-width: calc(100% - 100px);
    min-height: 0;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__media {
    position: absolute;
    z-index: 1;
    top: calc(-7 / 698 * 100%);
    left: calc(613.82 / 1440 * 100%);
    width: calc(826.1797485351562 / 1440 * 100%);
    height: calc(760 / 698 * 100%);
    overflow: hidden;
    background: transparent;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__image,
  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none !important;
    object-fit: cover;
    object-position: center center;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;

    /* Figma soft feather into cream */
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.1) 8%,
      rgba(0, 0, 0, 0.4) 16%,
      rgba(0, 0, 0, 0.78) 26%,
      #000000 36%,
      #000000 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.1) 8%,
      rgba(0, 0, 0, 0.4) 16%,
      rgba(0, 0, 0, 0.78) 26%,
      #000000 36%,
      #000000 100%
    );
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__eyebrow {
    margin: 0;
    color: var(--pne-gold, #b8893a);
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 700;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__heading {
    margin: 0;
    color: var(--pne-text, #14181c);
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(34px, 3.2vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.5px;
    text-transform: uppercase;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__highlight {
    color: var(--pne-gold, #b8893a);
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__sub {
    margin: 0;
    max-width: 420px;
    color: var(--pne-muted, #5c6560);
    font-family: Inter, system-ui, sans-serif;
    font-weight: 400;
    font-size: 17px;
    line-height: 1.55;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__author {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 8px;
    width: 100%;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__rule {
    width: 100%;
    max-width: 420px;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--pne-rule, #d7d2c8);
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__author-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__avatar {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__author-name {
    margin: 0 0 4px;
    color: var(--pne-text, #14181c);
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 800;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #PwNutriEdu-{{ section.id }} .pw-nutri-edu__author-meta {
    margin: 0;
    color: var(--pne-muted, #6a726c);
    font-family: Inter, system-ui, sans-serif;
    font-weight: 400;
    font-size: 13px;
    line-height: 1.4;
  }

  @media screen and (max-width: 1200px) {
    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__copy {
      left: var(--pw-gutter, 34px);
      width: min(520px, 44%);
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__media {
      left: 48%;
      width: 52%;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__heading {
      font-size: clamp(30px, 3.4vw, 40px);
    }
  }

  /*
   * Tablet + phone: image on TOP, content BELOW.
   */
  @media screen and (max-width: 860px) {
    #PwNutriEdu-{{ section.id }} {
      display: flex;
      flex-direction: column;
      aspect-ratio: auto;
      height: auto;
      min-height: 0;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__media {
      position: relative;
      z-index: 1;
      order: 1;
      top: auto;
      left: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      min-height: 240px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__image,
    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__placeholder {
      object-fit: cover;
      object-position: center center;
      -webkit-mask-image: linear-gradient(
        180deg,
        #000000 0%,
        #000000 72%,
        rgba(0, 0, 0, 0.55) 88%,
        transparent 100%
      );
      mask-image: linear-gradient(
        180deg,
        #000000 0%,
        #000000 72%,
        rgba(0, 0, 0, 0.55) 88%,
        transparent 100%
      );
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__frame {
      order: 2;
      width: 100%;
      max-width: none;
      height: auto;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__copy {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      max-width: none;
      padding: 28px var(--pw-gutter, 22px) 40px;
      gap: 14px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__heading {
      font-size: clamp(28px, 7vw, 36px);
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__sub {
      max-width: none;
      font-size: 16px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__rule {
      max-width: none;
    }
  }

  @media screen and (max-width: 560px) {
    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__media {
      aspect-ratio: 5 / 4;
      min-height: 220px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__copy {
      padding: 22px var(--pw-gutter, 16px) 32px;
      gap: 12px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__eyebrow {
      font-size: 11px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__heading {
      font-size: clamp(24px, 7.2vw, 30px);
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__sub {
      font-size: 15px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__avatar {
      width: 42px;
      height: 42px;
      flex-basis: 42px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__author-name {
      font-size: 11px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__author-meta {
      font-size: 12px;
    }
  }

  @media screen and (max-width: 360px) {
    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__heading {
      font-size: 22px;
    }

    #PwNutriEdu-{{ section.id }} .pw-nutri-edu__sub {
      font-size: 14px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Nutrition Edu Hero",
  "tag": "section",
  "class": "pw-nutrition-edu-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Or paste image URL"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Green powder spoon dissolving in water"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NUTRITION EDUCATION"
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading before gold",
      "default": "WHY MOST"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading gold word",
      "default": "SUPPLEMENTS"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading after gold",
      "default": "END UP IN YOUR TOILET"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "It's not just what you take.\nIt's what your body can actually absorb."
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author photo"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "WRITTEN BY DR. JONATHAN ALLINSON"
    },
    {
      "type": "text",
      "id": "author_meta",
      "label": "Author meta",
      "default": "MBChB, MRCGP • July 2024 • 6 min read"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F9F7F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#14181C"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5C6560"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold accent",
      "default": "#B8893A"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Divider colour",
      "default": "#D7D2C8"
    }
  ],
  "presets": [
    {
      "name": "Nutrition Edu Hero"
    }
  ]
}
{% endschema %}
