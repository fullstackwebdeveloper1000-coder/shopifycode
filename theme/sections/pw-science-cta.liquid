<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap">

<section id="PwScienceCta-{{ section.id }}" class="pw-sci-cta pw-section">
  <div class="pw-sci-cta__container pw-sci-cta__main">
    <div class="pw-sci-cta__left">
      {%- if section.settings.heading != blank -%}
        <h3>{{ section.settings.heading }}</h3>
      {%- endif -%}
    </div>
    <div class="pw-sci-cta__mid">
      {%- if section.settings.line_1 != blank -%}
        <p><span class="pw-sci-cta__tick" aria-hidden="true">✓</span>{{ section.settings.line_1 }}</p>
      {%- endif -%}
      {%- if section.settings.line_2 != blank -%}
        <p><span class="pw-sci-cta__tick" aria-hidden="true">✓</span>{{ section.settings.line_2 }}</p>
      {%- endif -%}
    </div>
    <div class="pw-sci-cta__right">
      {%- if section.settings.button_label != blank -%}
        <a
          class="pw-sci-cta__btn"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            href="#"
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_label }}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
      <div class="pw-sci-cta__ship">
        <svg width="30" height="30" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12h18v14H3zM21 17h9l4 5v4h-13z"/><circle cx="11" cy="30" r="2.4"/><circle cx="28" cy="30" r="2.4"/></svg>
        <span>
          <b>{{ section.settings.shipping_title }}</b>
          {{ section.settings.shipping_text }}
        </span>
      </div>
    </div>
  </div>

  <div class="pw-sci-cta__bar">
    <div class="pw-sci-cta__container pw-sci-cta__bar-in">
      {%- for block in section.blocks -%}
        <span class="pw-sci-cta__tb" {{ block.shopify_attributes }}>
          <span class="pw-sci-cta__tb-icon" aria-hidden="true">
            {%- case forloop.index -%}
              {%- when 1 -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l7 3v6c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3Z"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 2 -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8" stroke-linecap="round"/></svg>
              {%- when 3 -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l2.5 5 5.5.8-4 3.9 1 5.5L12 21l-5-2.3 1-5.5-4-3.9 5.5-.8L12 3Z" stroke-linejoin="round"/></svg>
              {%- when 4 -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18M6 6l12 12M18 6L6 18" stroke-width="1"/></svg>
              {%- else -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endcase -%}
          </span>
          {{ block.settings.label }}
        </span>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap');

  #PwScienceCta-{{ section.id }} {
    background: linear-gradient(100deg, #0f1316 0%, #20262a 100%);
    color: #fff;
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 48px;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__main {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 30px;
    align-items: center;
    padding: 44px 0;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__left h3 {
    margin: 0;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 900;
    font-size: 34px;
    line-height: 0.95;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #fff;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__left h3 em,
  #PwScienceCta-{{ section.id }} .pw-sci-cta__left h3 strong,
  #PwScienceCta-{{ section.id }} .pw-sci-cta__left h3 .gold {
    color: #c89a3d;
    font-style: normal;
    font-weight: 900;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__mid p {
    margin: 0 0 8px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    letter-spacing: 0;
    color: #fff;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__mid p:last-child { margin-bottom: 0; }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__tick {
    margin-right: 8px;
    color: #c89a3d;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 26px;
    border: 0;
    border-radius: 10px;
    background: #c89a3d;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #14171a;
    text-decoration: none;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__btn svg {
    stroke: #14171a;
    flex: 0 0 auto;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__ship {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #c7cbce;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.4;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__ship b {
    display: block;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #fff;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__bar {
    border-top: 1px solid rgba(255, 255, 255, 0.10);
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__bar-in {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 20px 0;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__tb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #fff;
  }

  #PwScienceCta-{{ section.id }} .pw-sci-cta__tb-icon {
    color: #c89a3d;
    line-height: 0;
  }

  @media (max-width: 960px) {
    #PwScienceCta-{{ section.id }} .pw-sci-cta__container { padding: 0 34px; }
    #PwScienceCta-{{ section.id }} .pw-sci-cta__main {
      grid-template-columns: 1fr;
      gap: 22px;
      text-align: left;
    }
    #PwScienceCta-{{ section.id }} .pw-sci-cta__bar-in {
      justify-content: flex-start;
      gap: 14px 28px;
    }
  }

  @media (max-width: 560px) {
    #PwScienceCta-{{ section.id }} .pw-sci-cta__container { padding: 0 20px; }
    #PwScienceCta-{{ section.id }} .pw-sci-cta__left h3 { font-size: 28px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "PW Science CTA",
  "tag": "section",
  "class": "pw-section",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>One Scoop.<br><strong>Every Day.</strong></p>"
    },
    {
      "type": "text",
      "id": "line_1",
      "label": "Bullet 1",
      "default": "A simple daily habit"
    },
    {
      "type": "textarea",
      "id": "line_2",
      "label": "Bullet 2",
      "default": "Designed to help you fuel your day, think sharper and perform at your best."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Primal Win"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Product or checkout page. Leave empty for now — add later in Customize."
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping text",
      "default": "On all orders over £50"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Third-Party Tested"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PW Science CTA",
      "category": "Primal Win",
      "blocks": [
        { "type": "trust", "settings": { "label": "Third-Party Tested" } },
        { "type": "trust", "settings": { "label": "GMP Certified Facility" } },
        { "type": "trust", "settings": { "label": "Premium Ingredients" } },
        { "type": "trust", "settings": { "label": "Made In The UK" } },
        { "type": "trust", "settings": { "label": "30-Day Money Back Guarantee" } }
      ]
    }
  ]
}
{% endschema %}
