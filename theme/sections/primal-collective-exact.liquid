{% liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign image_alt = section.settings.image.alt | default: section.settings.heading
%}

<section
  id="PrimalCollectiveExact-{{ section.id }}"
  class="primal-collective-exact"
  style="
    --pce-bg: {{ section.settings.background_color }};
    --pce-text: {{ section.settings.text_color }};
    --pce-gold: {{ section.settings.gold_color }};
  "
>
  <div class="pce__wrap">
    <div class="pce-copy">
      {% if section.settings.eyebrow != blank %}
        <p class="pce-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pce-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="pce-description">{{ section.settings.description | escape }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="pce-button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <div class="pce-media">
      <div class="pce-media-scroll" tabindex="0" role="region" aria-label="Athlete portraits. Swipe to see more.">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              class: 'pce-image',
              widths: '640, 900, 1200, 1600, 2000, 2400',
              sizes: '(max-width: 1024px) 978px, 70vw',
              loading: 'lazy',
              alt: image_alt
          }}
        {% else %}
          <div class="pce-placeholder">
            <span>Upload the Primal Collective athlete strip</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #PrimalCollectiveExact-{{ section.id }} {
    {% render 'pw-align-vars' %}
    --pce-frame: 1440px;
    --pce-gutter: 80px;
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: var(--pce-bg, #050606) !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PrimalCollectiveExact-{{ section.id }},
  #PrimalCollectiveExact-{{ section.id }} *,
  #PrimalCollectiveExact-{{ section.id }} *::before,
  #PrimalCollectiveExact-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PrimalCollectiveExact-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--pce-bg, #050606);
    color: var(--pce-text, #ffffff);
    -webkit-font-smoothing: antialiased;
  }

  /*
    Figma desktop:
    - left copy on content line
    - athlete strip bleeds to RIGHT edge
  */
  #PrimalCollectiveExact-{{ section.id }} .pce__wrap {
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
    align-items: stretch;
    width: 100%;
    max-width: none;
    min-height: 420px;
    margin: 0;
    padding-left: max(
      20px,
      min(var(--pce-gutter), 5.5vw),
      calc((100% - var(--pce-frame)) / 2 + var(--pce-gutter))
    );
    padding-right: 0;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-copy {
    display: flex;
    min-width: 0;
    padding: 56px 0 48px;
    flex-direction: column;
    justify-content: center;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
    margin: 0;
    color: var(--pce-gold, #c89a3d);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: clamp(11px, 1.05vw, 14px);
    line-height: 1.45;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-heading {
    width: 100%;
    max-width: 11ch;
    margin: 24px 0 0;
    color: var(--pce-text, #ffffff);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: clamp(32px, 2.9vw, 44px);
    line-height: 0.95;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-description {
    width: 100%;
    max-width: 32ch;
    margin: 20px 0 0;
    color: var(--pce-text, #ffffff);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-style: {{ body_font.style }};
    font-weight: 400;
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.5;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    min-height: 49px;
    margin-top: 22px;
    padding: 14px 16px 14px 14px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--pce-gold, #c89a3d);
    border-radius: 8px;
    background: transparent;
    color: var(--pce-gold, #c89a3d);
    text-decoration: none;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 700;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button:hover,
  #PrimalCollectiveExact-{{ section.id }} .pce-button:focus-visible {
    background: var(--pce-gold, #c89a3d);
    color: #050606;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button:hover svg,
  #PrimalCollectiveExact-{{ section.id }} .pce-button:focus-visible svg {
    transform: translateX(3px);
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button[aria-disabled='true'] {
    cursor: default;
    pointer-events: none;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-media {
    position: relative;
    min-width: 0;
    min-height: 420px;
    overflow: hidden;
    background: var(--pce-bg, #050606);
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-media-scroll {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 320px;
    place-items: center;
    padding: 24px;
    border: 1px dashed rgba(200, 154, 61, 0.45);
    color: var(--pce-gold, #c89a3d);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-size: 14px;
    text-align: center;
  }

  /* iPad Pro landscape / smaller desktops */
  @media screen and (max-width: 1366px) and (min-width: 1025px) {
    #PrimalCollectiveExact-{{ section.id }} {
      --pce-gutter: 48px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce__wrap {
      grid-template-columns: minmax(220px, 260px) minmax(0, 1fr);
      min-height: 380px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media {
      min-height: 380px;
    }
  }

  /*
    ≤1024 (iPad Pro portrait, Air, tablets, phones):
    ALWAYS stack. Scroll strip so athletes stay readable.
  */
  @media screen and (max-width: 1024px) {
    #PrimalCollectiveExact-{{ section.id }} {
      overflow: visible;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce__wrap {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      min-height: 0;
      padding-left: 0;
      padding-right: 0;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      width: 100%;
      max-width: 720px;
      margin: 0;
      padding: 44px clamp(20px, 4.5vw, 48px) 28px;
      justify-content: flex-start;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
      font-size: clamp(11px, 1.8vw, 13px);
      letter-spacing: 0.14em;
      line-height: 1.4;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      max-width: 12ch;
      margin-top: 16px;
      font-size: clamp(34px, 6.5vw, 48px);
      line-height: 0.96;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      max-width: 38ch;
      margin-top: 16px;
      font-size: clamp(14px, 2.2vw, 16px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-button {
      margin-top: 20px;
      font-size: 12px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media {
      position: relative;
      width: 100%;
      min-height: 0;
      height: auto;
      overflow: visible;
      background: var(--pce-bg, #050606);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media-scroll {
      position: relative;
      inset: auto;
      display: block;
      width: 100%;
      height: clamp(280px, 48vw, 380px);
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      touch-action: pan-x;
      scrollbar-width: thin;
      scrollbar-color: rgba(200, 154, 61, 0.55) transparent;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media-scroll::-webkit-scrollbar {
      height: 4px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media-scroll::-webkit-scrollbar-thumb {
      background: rgba(200, 154, 61, 0.55);
      border-radius: 999px;
    }

    /* Keep native strip ratio; swipe to see all 6 athletes */
    #PrimalCollectiveExact-{{ section.id }} .pce-image {
      width: auto !important;
      height: 100% !important;
      max-width: none !important;
      min-width: calc(clamp(280px, 48vw, 380px) * 978 / 434);
      aspect-ratio: 978 / 434;
      object-fit: cover;
      object-position: left center;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-placeholder {
      width: 100%;
      min-height: 280px;
      height: 100%;
    }

    /* Right-edge fade = scroll hint */
    #PrimalCollectiveExact-{{ section.id }} .pce-media::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 4px;
      width: 48px;
      pointer-events: none;
      background: linear-gradient(
        90deg,
        rgba(5, 6, 6, 0) 0%,
        rgba(5, 6, 6, 0.75) 100%
      );
    }
  }

  /* Phones */
  @media screen and (max-width: 749px) {
    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      max-width: none;
      padding: 36px 20px 24px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      max-width: 100%;
      font-size: clamp(30px, 9vw, 40px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      max-width: 100%;
      font-size: 14px;
      line-height: 1.5;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-button {
      flex-wrap: wrap;
      font-size: 11px;
      letter-spacing: 0.06em;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media-scroll {
      height: 300px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-image {
      min-width: calc(300px * 978 / 434);
    }
  }

  @media screen and (max-width: 429px) {
    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      padding: 30px 16px 20px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
      font-size: 10px;
      letter-spacing: 0.12em;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      font-size: 28px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      font-size: 13px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media-scroll {
      height: 260px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-image {
      min-width: calc(260px * 978 / 434);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media::after {
      width: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #PrimalCollectiveExact-{{ section.id }} .pce-button svg {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Primal Collective V3",
  "tag": "section",
  "class": "section-primal-collective-exact",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Athlete strip image",
      "info": "Upload the athlete strip (about 978×434 or wider). It bleeds to the right edge on desktop."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Gold top line",
      "default": "Trusted By Those Who Demand More"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Primal Collective"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Elite athletes. Everyday winners. Different journeys. Same mindset."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Meet The Primal Collective"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "montserrat_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#050606"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Brand gold",
      "default": "#C89A3D"
    }
  ],
  "presets": [
    {
      "name": "Primal Collective V3"
    }
  ]
}
{% endschema %}
