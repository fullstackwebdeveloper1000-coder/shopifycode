{% liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign image_alt = section.settings.image.alt | default: section.settings.heading
%}

<section
  id="PrimalCollectiveExact-{{ section.id }}"
  class="primal-collective-exact"
  style="
    --pce-bg: {{ section.settings.background_color }};
    --pce-text: {{ section.settings.text_color }};
    --pce-gold: {{ section.settings.gold_color }};
  "
>
  <div class="pw-container pce__wrap">
    <div class="pce-copy">
      {% if section.settings.eyebrow != blank %}
        <p class="pce-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="pce-description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="pce-button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          <span>{{ section.settings.button_label }}</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <div class="pce-media">
      {% if section.settings.image != blank %}
        <img
          class="pce-image"
          src="{{ section.settings.image | image_url: width: 2400 }}"
          alt="{{ image_alt | escape }}"
          width="978"
          height="434"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {% else %}
        <div class="pce-placeholder">
          <span>Upload the 978 × 434 Primal Collective athlete strip</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #PrimalCollectiveExact-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PrimalCollectiveExact-{{ section.id }},
  #PrimalCollectiveExact-{{ section.id }} *,
  #PrimalCollectiveExact-{{ section.id }} *::before,
  #PrimalCollectiveExact-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PrimalCollectiveExact-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--pce-bg);
    color: var(--pce-text);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PrimalCollectiveExact-{{ section.id }} .pw-container.pce__wrap {
    display: grid;
    grid-template-columns: minmax(0, 296px) minmax(0, 1fr);
    gap: 30px;
    align-items: stretch;
    width: 100%;
    max-width: var(--pw-max);
    min-height: 434px;
    margin-inline: auto;
    padding-inline: var(--pw-gutter);
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-width: 0;
    padding-top: 71px;
    padding-bottom: 40px;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
    margin: 0;
    color: var(--pce-gold);
    font-family: {{ heading_font.family }}, sans-serif;
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 15px;
    line-height: 24px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-copy h2 {
    width: 100%;
    max-width: 296px;
    margin: 38px 0 0;
    color: var(--pce-text);
    font-family: {{ heading_font.family }}, sans-serif;
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 44px;
    line-height: 41.8px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-description {
    width: 100%;
    max-width: 280px;
    margin: 28px 0 0;
    color: var(--pce-text);
    font-family: {{ body_font.family }}, sans-serif;
    font-style: {{ body_font.style }};
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button {
    width: min(100%, 292px);
    height: 49px;
    margin-top: 24px;
    padding: 0 14px 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--pce-gold);
    border-radius: 8px;
    background: transparent;
    color: var(--pce-gold);
    text-decoration: none;
    font-family: {{ heading_font.family }}, sans-serif;
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button:hover {
    background: var(--pce-gold);
    color: #050606;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-media {
    position: relative;
    min-width: 0;
    min-height: 434px;
    overflow: hidden;
    background: #050606;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 434px;
    max-width: none;
    object-fit: cover;
    object-position: center center;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-placeholder {
    width: 100%;
    min-height: 434px;
    display: grid;
    place-items: center;
    border: 1px dashed rgba(200, 154, 61, 0.45);
    color: var(--pce-gold);
    font-family: {{ body_font.family }}, sans-serif;
    font-size: 14px;
    text-align: center;
    padding: 24px;
  }

  @media screen and (max-width: 1100px) {
    #PrimalCollectiveExact-{{ section.id }} .pw-container.pce__wrap {
      gap: 24px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-copy h2 {
      font-size: 38px;
      line-height: 37px;
    }
  }

  @media screen and (max-width: 749px) {
    #PrimalCollectiveExact-{{ section.id }} .pw-container.pce__wrap {
      display: flex;
      flex-direction: column;
      gap: 0;
      min-height: 0;
      padding-inline: var(--pw-gutter);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      min-height: 390px;
      padding: 52px 0 38px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-copy h2 {
      max-width: none;
      margin-top: 14px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      max-width: none;
      margin-top: 22px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-button {
      margin-top: 24px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-media {
      min-height: 0;
      aspect-ratio: 978 / 434;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-image,
    #PrimalCollectiveExact-{{ section.id }} .pce-placeholder {
      min-height: 0;
      height: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Primal Collective Final",
  "tag": "section",
  "class": "section-primal-collective-exact",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Athlete strip image",
      "info": "Upload only the exact 978 × 434 athlete strip, not the complete section screenshot."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Gold top line",
      "default": "Trusted By Those Who Demand More"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Primal Collective"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Elite athletes. Everyday winners. Different journeys. Same mindset."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Meet The Primal Collective"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "montserrat_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#050606"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Brand gold",
      "default": "#C89A3D"
    }
  ],
  "presets": [
    {
      "name": "Primal Collective Final"
    }
  ]
}
{% endschema %}
