{% liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
%}

<section
  id="PrimalCollectiveExact-{{ section.id }}"
  class="primal-collective-exact"
  style="
    --pce-bg: {{ section.settings.background_color }};
    --pce-text: {{ section.settings.text_color }};
    --pce-gold: {{ section.settings.gold_color }};
  "
>
  <div class="pce__wrap">
    <div class="pce-copy">
      {% if section.settings.eyebrow != blank %}
        <p class="pce-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pce-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="pce-description">{{ section.settings.description | escape }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="pce-button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <div class="pce-athletes" role="list">
      {% for block in section.blocks %}
        <article class="pce-card" role="listitem" {{ block.shopify_attributes }}>
          <div class="pce-card-media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'pce-card-image',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 1025px) 16vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.name | default: 'Athlete'
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'pce-card-placeholder' }}
            {% endif %}
          </div>

          {% if block.settings.quote != blank %}
            <p class="pce-card-quote">{{ block.settings.quote | escape }}</p>
          {% endif %}

          {% if block.settings.name != blank %}
            <p class="pce-card-name">{{ block.settings.name | escape }}</p>
          {% endif %}

          {% if block.settings.title != blank %}
            <p class="pce-card-title">{{ block.settings.title | escape }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #PrimalCollectiveExact-{{ section.id }} {
    {% render 'pw-align-vars' %}
  }

  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip !important;
    background: var(--pce-bg, #050606) !important;
  }

  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} > .page-width {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #PrimalCollectiveExact-{{ section.id }},
  #PrimalCollectiveExact-{{ section.id }} *,
  #PrimalCollectiveExact-{{ section.id }} *::before,
  #PrimalCollectiveExact-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PrimalCollectiveExact-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--pce-bg, #050606);
    color: var(--pce-text, #ffffff);
    -webkit-font-smoothing: antialiased;
  }

  /*
    Figma desktop:
    left copy on shared content line | 6 athlete portraits bleed to right edge
  */
  #PrimalCollectiveExact-{{ section.id }} .pce__wrap {
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    gap: clamp(16px, 1.8vw, 28px);
    align-items: stretch;
    width: 100%;
    max-width: none;
    margin: 0;
    padding-left: max(
      20px,
      calc((100% - var(--pw-frame)) / 2 + var(--pw-gutter))
    );
    padding-right: 0;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-copy {
    display: flex;
    min-width: 0;
    padding: 56px 0 48px;
    flex-direction: column;
    justify-content: center;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-eyebrow {
    margin: 0;
    color: var(--pce-gold, #c89a3d);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 15px;
    line-height: 24px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-heading {
    width: 100%;
    max-width: 11ch;
    margin: 28px 0 0;
    color: var(--pce-text, #ffffff);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: 700;
    font-size: 44px;
    line-height: 0.95;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-description {
    width: 100%;
    max-width: 32ch;
    margin: 22px 0 0;
    color: var(--pce-text, #ffffff);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-style: {{ body_font.style }};
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    min-height: 49px;
    margin-top: 24px;
    padding: 14px 16px 14px 12px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--pce-gold, #c89a3d);
    border-radius: 8px;
    background: transparent;
    color: var(--pce-gold, #c89a3d);
    text-decoration: none;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 700;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button:hover,
  #PrimalCollectiveExact-{{ section.id }} .pce-button:focus-visible {
    background: var(--pce-gold, #c89a3d);
    color: #050606;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-button[aria-disabled='true'] {
    cursor: default;
    pointer-events: none;
  }

  /* 6 athletes edge-to-edge, no gaps between portraits */
  #PrimalCollectiveExact-{{ section.id }} .pce-athletes {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0;
    min-width: 0;
    align-self: stretch;
    background: var(--pce-bg, #050606);
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #111;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-card-image,
  #PrimalCollectiveExact-{{ section.id }} .pce-card-placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center top;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-card-quote,
  #PrimalCollectiveExact-{{ section.id }} .pce-card-name,
  #PrimalCollectiveExact-{{ section.id }} .pce-card-title {
    margin: 0;
    padding-inline: 10px;
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-style: {{ body_font.style }};
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-card-quote {
    margin-top: 14px;
    color: var(--pce-text, #ffffff);
    font-weight: 400;
    font-size: 12px;
    line-height: 1.35;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-card-name {
    margin-top: 8px;
    color: var(--pce-gold, #c89a3d);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 700;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #PrimalCollectiveExact-{{ section.id }} .pce-card-title {
    margin-top: 4px;
    margin-bottom: 18px;
    color: rgba(255, 255, 255, 0.78);
    font-weight: 400;
    font-size: 11px;
    line-height: 1.3;
  }

  /* iPad Pro landscape / smaller desktop — still Figma 2-col */
  @media screen and (max-width: 1366px) and (min-width: 1025px) {
    #PrimalCollectiveExact-{{ section.id }} .pce__wrap {
      grid-template-columns: minmax(210px, 260px) minmax(0, 1fr);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      font-size: 38px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-card-quote {
      font-size: 11px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-card-name {
      font-size: 11px;
    }
  }

  /*
    Figma mobile/tablet:
    copy on top, then each athlete FULL WIDTH stacked
  */
  @media screen and (max-width: 1024px) {
    #PrimalCollectiveExact-{{ section.id }} .pce__wrap {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-left: 0;
      padding-right: 0;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      width: 100%;
      padding: 44px var(--pw-gutter) 28px;
      justify-content: flex-start;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      max-width: 12ch;
      margin-top: 16px;
      font-size: clamp(34px, 6vw, 44px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      max-width: 40ch;
      margin-top: 16px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-athletes {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 0;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-card {
      width: 100%;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-card-media {
      width: 100%;
      aspect-ratio: 4 / 5;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-card-quote,
    #PrimalCollectiveExact-{{ section.id }} .pce-card-name,
    #PrimalCollectiveExact-{{ section.id }} .pce-card-title {
      padding-inline: var(--pw-gutter);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-card-quote {
      margin-top: 16px;
      font-size: 14px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-card-name {
      margin-top: 10px;
      font-size: 14px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-card-title {
      margin-top: 4px;
      margin-bottom: 28px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 749px) {
    #PrimalCollectiveExact-{{ section.id }} .pce-copy {
      padding: 36px var(--pw-gutter) 24px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-heading {
      max-width: 100%;
      font-size: clamp(30px, 9vw, 40px);
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-description {
      max-width: 100%;
      font-size: 14px;
    }

    #PrimalCollectiveExact-{{ section.id }} .pce-card-media {
      aspect-ratio: 3 / 4;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Primal Collective V3",
  "tag": "section",
  "class": "section-primal-collective-exact",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Gold top line",
      "default": "Trusted By Those Who Demand More"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Primal Collective"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Elite athletes. Everyday winners. Different journeys. Same mindset."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Meet The Primal Collective"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "montserrat_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "color",
