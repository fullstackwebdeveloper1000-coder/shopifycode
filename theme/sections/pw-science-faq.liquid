<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap">

<section id="PwScienceFaq-{{ section.id }}" class="pw-sci-faq pw-section">
  <div class="pw-sci-faq__container">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="pw-sci-faq__grid">
      {%- for block in section.blocks -%}
        <details
          class="pw-sci-faq__item"
          {% if block.settings.open_by_default %}open{% endif %}
          {{ block.shopify_attributes }}
        >
          <summary>
            {{ block.settings.question }}
            <span class="pw-sci-faq__chev" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <div class="pw-sci-faq__ans">
            {%- if block.settings.answer != blank -%}
              {{ block.settings.answer }}
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="pw-sci-faq__cta">
        <a
          class="pw-sci-faq__btn"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            href="#"
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_label }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap');

  #PwScienceFaq-{{ section.id }} {
    background: #efe5dd;
    padding: 56px 0 60px;
    color: #1f2326;
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 48px;
  }

  #PwScienceFaq-{{ section.id }} h2 {
    margin: 0 0 30px;
    text-align: center;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 800;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #1f2326;
  }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
    max-width: 960px;
    margin: 0 auto;
  }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__item {
    border: 1px solid rgba(31, 35, 38, 0.10);
    border-radius: 8px;
    background: #fff;
  }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    color: #1f2326;
    cursor: pointer;
    list-style: none;
  }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__item summary::-webkit-details-marker { display: none; }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__chev {
    color: #737a80;
    transition: transform 0.2s;
    flex-shrink: 0;
    line-height: 0;
  }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__item[open] .pw-sci-faq__chev { transform: rotate(180deg); }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__ans {
    padding: 0 18px 16px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.6;
    letter-spacing: 0;
    color: #737a80;
  }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__ans p { margin: 0; }
  #PwScienceFaq-{{ section.id }} .pw-sci-faq__ans p + p { margin-top: 10px; }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__cta { margin-top: 30px; text-align: center; }

  #PwScienceFaq-{{ section.id }} .pw-sci-faq__btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 24px;
    border: 1.5px solid #c89a3d;
    border-radius: 8px;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #c89a3d;
    text-decoration: none;
    background: transparent;
  }

  @media (max-width: 960px) {
    #PwScienceFaq-{{ section.id }} .pw-sci-faq__container { padding: 0 34px; }
    #PwScienceFaq-{{ section.id }} .pw-sci-faq__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    #PwScienceFaq-{{ section.id }} .pw-sci-faq__container { padding: 0 20px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "PW Science FAQ",
  "tag": "section",
  "class": "pw-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All FAQs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Link to your full FAQ page. Leave empty for now — add later in Customize."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Can I take Primal Win every day?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Full answer",
          "info": "Full FAQ copy from the FAQs document.",
          "default": "<p>Yes — Primal Win is designed as a daily habit. Take one scoop every day to support your energy, focus, immunity and overall performance. It is formulated for consistent, long-term use as part of a healthy routine that includes balanced nutrition, movement and rest.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PW Science FAQ",
      "category": "Primal Win",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Can I take Primal Win every day?",
            "answer": "<p>Yes — Primal Win is designed as a daily habit. Take one scoop every day to support your energy, focus, immunity and overall performance. It is formulated for consistent, long-term use as part of a healthy routine that includes balanced nutrition, movement and rest.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can pregnant or breastfeeding women take it?",
            "answer": "<p>If you are pregnant, breastfeeding, or planning to become pregnant, please speak to your doctor or midwife before taking Primal Win or any new supplement. They can advise you based on your individual health needs.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Does Primal Win replace fruit and vegetables?",
            "answer": "<p>No — Primal Win does not replace whole foods. It complements a balanced diet by delivering targeted plant-based nutrition in a single daily scoop, especially on days when eating perfectly is not realistic. You should still aim to eat a wide variety of fruits, vegetables and whole foods every day.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How and when should I take it?",
            "answer": "<p>Take one scoop daily, mixed with cold water or your preferred drink. Shake or blend well and drink straight away. Many people take it in the morning, but the most important thing is consistency — choose a time that works for you and stick to it.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is Primal Win suitable for vegans and vegetarians?",
            "answer": "<p>Yes — Primal Win is plant-based and suitable for both vegans and vegetarians. It is also free from dairy, gluten, GMOs, artificial sweeteners, flavours, colours and preservatives.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I mix it with other supplements?",
            "answer": "<p>In most cases, yes — Primal Win can be taken alongside other supplements. Because it already contains a comprehensive blend of 40 active ingredients, you may find you need fewer additional products. If you take prescription medication or have a health condition, check with your healthcare provider first.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
