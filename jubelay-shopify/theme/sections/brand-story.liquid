<section class="section section--cream">
  <div class="page-width">
    <div class="brand-story">
      <div class="brand-story__media reveal">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200' }}
        {%- endif -%}
      </div>
      <div class="brand-story__content reveal">
        <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link | default: '/pages/about-us' }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Style Made Simple"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>JUBELAY was born for every woman who wants to feel confident in her hijab — without complicated styling. Our Instant Jersey Hijab Sets slip on in seconds, stay put all day, and arrive with magnetic pins and a branded pouch.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "About us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}
