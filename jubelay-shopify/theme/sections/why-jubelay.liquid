<section class="section">
  <div class="page-width">
    <div class="section__header reveal">
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="trust-grid">
      {%- for block in section.blocks -%}
        <div class="trust-item reveal" {{ block.shopify_attributes }}>
          <div class="trust-item__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14h24v18H4z"/><path d="M28 20h10l6 8v4H28z"/><circle cx="12" cy="34" r="3"/><circle cx="36" cy="34" r="3"/></svg>
              {%- when 'quality' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="M24 6l4 10h10l-8 6 3 10-9-6-9 6 3-10-8-6h10z"/></svg>
              {%- when 'returns' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 18H8v-6"/><path d="M8 18a16 16 0 112.5 10"/><path d="M34 30h6v6"/><path d="M40 30a16 16 0 11-2.5-10"/></svg>
              {%- else -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="M24 42c8-6 14-12 14-20a14 14 0 10-28 0c0 8 6 14 14 20z"/><circle cx="24" cy="22" r="5"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="trust-item__title">{{ block.settings.title }}</h3>
          <p class="trust-item__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why JUBELAY",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The JUBELAY promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why JUBELAY"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "quality", "label": "Quality" },
            { "value": "returns", "label": "Returns" },
            { "value": "support", "label": "Support" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free COD Delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Across Pakistan" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why JUBELAY",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Free COD Delivery", "text": "Across Pakistan" } },
        { "type": "item", "settings": { "icon": "quality", "title": "Premium Quality", "text": "Luxury you can feel" } },
        { "type": "item", "settings": { "icon": "returns", "title": "Easy Returns", "text": "Hassle-free 3-day returns" } },
        { "type": "item", "settings": { "icon": "support", "title": "Customer Support", "text": "WhatsApp help, fast replies" } }
      ]
    }
  ]
}
{% endschema %}
