{%- if section.settings.text != blank -%}
  <div class="announcement-bar" role="region" aria-label="Announcement">
    <div class="page-width">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">
          <span class="announcement-bar__gold">✓</span>
          {{ section.settings.text }}
        </a>
      {%- else -%}
        <span>
          <span class="announcement-bar__gold">✓</span>
          {{ section.settings.text }}
        </span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Cash on Delivery Available Nationwide  |  Free Shipping on Orders Above Rs. 2,000"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
