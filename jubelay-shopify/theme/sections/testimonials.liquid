<section class="section">
  <div class="page-width">
    <div class="section__header reveal">
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="testimonial-grid">
      {%- for block in section.blocks -%}
        <blockquote class="testimonial reveal" {{ block.shopify_attributes }}>
          <div class="testimonial__stars" aria-label="5 stars">★★★★★</div>
          <p class="testimonial__quote">“{{ block.settings.quote }}”</p>
          <p class="testimonial__author">— {{ block.settings.author }}</p>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Loved across Pakistan"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers say"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Best hijab ever — ready in seconds and the fabric is so soft."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Ayesha, Lahore"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "Best hijab ever — ready in seconds and the fabric is so soft.",
            "author": "Ayesha, Lahore"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "COD was easy and delivery was fast. Ordering my second colour!",
            "author": "Fatima, Karachi"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Magnetic pins are a game changer. No more holes in my scarves.",
            "author": "Sara, Islamabad"
          }
        }
      ]
    }
  ]
}
{% endschema %}
