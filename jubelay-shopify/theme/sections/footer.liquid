<footer class="site-footer">
  <div class="page-width">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-brand__name">{{ shop.name | default: 'JUBELAY' }}</div>
        <div class="footer-brand__tag">{{ settings.tagline | default: 'Style Made Simple' }}</div>
        <p style="margin-top:1rem;color:rgba(255,255,255,.7);font-size:.9rem;max-width:280px;">
          Premium Instant Hijabs for Pakistan — ready in seconds, delivered with COD.
        </p>
        <div style="display:flex;gap:1rem;margin-top:1rem;">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>
          {%- endif -%}
        </div>
      </div>

      <div class="footer-col">
        <h3>Shop</h3>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li>
          <li><a href="/collections/instant-hijabs">Instant Hijabs</a></li>
          <li><a href="/collections/new-arrivals">New Arrivals</a></li>
          <li><a href="/collections/best-sellers">Best Sellers</a></li>
          <li><a href="/collections/bundles-sets">Bundles & Sets</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Help</h3>
        <ul>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/shipping">Shipping Info</a></li>
          <li><a href="/pages/returns">Returns & Exchange</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/track-order">Track Order</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Policies</h3>
        <ul>
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/terms">Terms & Conditions</a></li>
          <li><a href="/pages/returns">Refund Policy</a></li>
        </ul>
        {%- if section.settings.newsletter_heading != blank -%}
          <h3 style="margin-top:1.5rem;">{{ section.settings.newsletter_heading }}</h3>
          <p style="color:rgba(255,255,255,.7);font-size:.85rem;">{{ section.settings.newsletter_text }}</p>
          {% form 'customer', class: 'newsletter__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" placeholder="Your email" required>
            <button class="btn" type="submit">Join</button>
          {% endform %}
        {%- endif -%}
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'JUBELAY' }}. All rights reserved.</span>
      {%- if section.settings.show_payment_icons -%}
        <span>COD · JazzCash · EasyPaisa · Bank Transfer</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment methods line",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Join the JUBELAY list — styling tips + early access."
    }
  ]
}
{% endschema %}
