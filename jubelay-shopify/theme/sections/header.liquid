<header class="site-header">
  <div class="page-width">
    <div class="site-header__inner">
      <button
        class="header-menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="SiteNav"
        aria-label="Menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>

      <div class="site-header__search">
        <a class="site-header__icon" href="{{ routes.search_url }}" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
          </svg>
        </a>
      </div>

      <a class="site-header__brand" href="{{ routes.root_url }}">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: settings.logo_width }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width }}"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          <p class="site-header__logo-text">{{ shop.name | default: 'JUBELAY' }}</p>
          {%- if settings.tagline != blank -%}
            <span class="site-header__tagline">{{ settings.tagline }}</span>
          {%- endif -%}
        {%- endif -%}
      </a>

      <div class="site-header__icons">
        <a class="site-header__icon" href="{{ routes.account_url }}" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5"/>
          </svg>
        </a>
        <a class="site-header__icon" href="{{ routes.cart_url }}" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M6 7h15l-1.5 9h-12z"/><path d="M6 7L5 3H2"/><circle cx="9" cy="20" r="1.2"/><circle cx="18" cy="20" r="1.2"/>
          </svg>
          <span aria-hidden="true">({{ cart.item_count }})</span>
        </a>
      </div>
    </div>

    <nav aria-label="Primary">
      <ul class="site-nav" id="SiteNav" data-site-nav>
        {%- for link in section.settings.menu.links -%}
          <li>
            <a
              href="{{ link.url }}"
              {% if link.active %}class="is-active"{% endif %}
            >
              {{ link.title }}
            </a>
          </li>
        {%- else -%}
          <li><a href="{{ routes.root_url }}" class="is-active">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li><a href="/collections/instant-hijabs">Collections</a></li>
          <li><a href="/collections/best-sellers">Best Sellers</a></li>
          <li><a href="/collections/new-arrivals">New Arrivals</a></li>
          <li><a href="/pages/about-us">About Us</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
